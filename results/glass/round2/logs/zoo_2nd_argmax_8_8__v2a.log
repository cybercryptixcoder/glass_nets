import numpy as np, time
y=run(X).argmax(1)
rng=np.random.default_rng(0); idx=rng.permutation(len(X))
tr=idx[:3000]; te=idx[6000:]
Xtr,ytr,Xte,yte=X[tr],y[tr],X[te],y[te]; Y=np.eye(8)[ytr]
def train(hid,steps=800,lr=5e-3,seed=0):
    rg=np.random.default_rng(seed); dims=[8]+hid+[8]; L=len(dims)-1
    P=[rg.standard_normal((dims[i],dims[i+1]))*np.sqrt(2/dims[i]) for i in range(L)]+[np.zeros(dims[i+1]) for i in range(L)]
    Ws=P[:L]; bs=P[L:]; m=[np.zeros_like(p) for p in P]; v=[np.zeros_like(p) for p in P]
    n=len(Xtr)
    for s in range(1,steps+1):
        Z=[]; A=Xtr; As=[A]
        for i in range(L):
            z=A@Ws[i]+bs[i]; Z.append(z); A=np.maximum(z,0) if i<L-1 else z; As.append(A)
        Q=A-A.max(1,keepdims=True); Q=np.exp(Q); Q/=Q.sum(1,keepdims=True)
        G=(Q-Y)/n; gW=[None]*L; gb=[None]*L
        for i in range(L-1,-1,-1):
            gW[i]=As[i].T@G; gb[i]=G.sum(0)
            if i>0: G=(G@Ws[i].T)*(Z[i-1]>0)
        for k,p in enumerate(Ws+bs):
            g=gW[k] if k<L else gb[k-L]
            m[k]=0.9*m[k]+0.1*g; v[k]=0.999*v[k]+0.001*g*g
            p-=lr*(m[k]/(1-0.9**s))/(np.sqrt(v[k]/(1-0.999**s))+1e-8)
    def pr(Xq):
        A=Xq
        for i in range(L):
            A=A@Ws[i]+bs[i]
            if i<L-1: A=np.maximum(A,0)
        return (A.argmax(1)==yte).mean(), (A.argmax(1)==ytr).mean()
    return pr(Xte)
t0=time.time()
print("32:",train([32]),time.time()-t0)
print("128:",train([128],steps=1200),time.time()-t0)

