import numpy as np

DESCRIPTION = ("Diagnostic exact re-implementation of the recurrent network: h_t = relu(x_t*W_x + h_{t-1}@W_h), out = h_8@W_o. "
               "Stage 1 is explained (a single input weight per hidden unit); later stages are reproduced from measured weights.")

WX = [-0.2073, 0.0302, -1.2027, -0.1506, -0.4672, 0.0032, 0.6188, 0.0040]
WH = [[0.0817, 0.3865, 0.7401, -1.3310, -0.6463, 0.1432, -0.3229, 0.6877],
      [-0.1382, 0.4797, -0.8372, 0.0943, 0.7727, -1.1995, -0.4489, 1.9091],
