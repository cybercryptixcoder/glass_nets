        # distance to p/q
        for q in range(1,9):
            p=round(r*q)
            if p>0:
                err=abs(r-p/q)/(p/q)
                if err<1e-6: best.append((err,i,j,p,q))
print("rational ratio hits:",len(best), best[:5])

