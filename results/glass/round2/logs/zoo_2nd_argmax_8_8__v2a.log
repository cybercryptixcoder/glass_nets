# check rank1 sign structure: outer product possibility
u=sign[:,0]; prod=np.outer(u,sign[0,:])
print("matches sign outer product", (prod==sign).mean())
# Hadamard
def hadamard(n):
    H=np.array([[1.]])
    while H.shape[0]<n: H=np.block([[H,H],[H,-H]])
    return H
H=hadamard(8)
T=H@Wh@H/8
print("Hadamard Wh Hadamard /8\n", T.round(2))
# DFT
F=np.fft.fft(np.eye(8))/np.sqrt(8)
print("|DFT Wh DFT*| magnitudes\n", np.abs(F@Wh@F.conj().T).round(2))
print("Wx\n", Wx.round(3), "|Wx| sing?", np.abs(Wx).round(3))
print("Wo sing vals", np.linalg.svd(Wo,compute_uv=False).round(2))

