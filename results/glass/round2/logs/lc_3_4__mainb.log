import itertools
from collections import defaultdict
y=run(X).argmax(1)
def purity(S):
    d=defaultdict(list)
    for i in range(256): d[tuple(X[i,S])].append(y[i])
    correct=sum(np.bincount(v).max() for v in d.values())
    return correct/256.0
for r in [1,2,3]:
    best=[]
    for S in itertools.combinations(range(4),r):
        best.append((purity(list(S)),S))
    best.sort(reverse=True)
    print(r, [(round(p,3),S) for p,S in best[:4]])

