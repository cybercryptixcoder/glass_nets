import numpy as np
from scipy.optimize import fsolve
np.set_printoptions(suppress=True,precision=8,linewidth=200)
n = np.linalg.svd(M1)[2][2]; nL = np.linalg.svd(M1.T)[2][2]; nL/=np.linalg.norm(nL); n/=np.linalg.norm(n)
print('n@M1',n@M1,' M1@nL',M1@nL,' n.nL',n@nL, ' M1@n', M1@n)
c0=M0@n; print('nM0n',n@M0@n,'c0',c0,'M0Tn',M0.T@n)
u=np.linalg.qr(np.stack([c0,np.eye(3)[0],np.eye(3)[1]]).T)[0][:,1]
v=np.linalg.qr(np.stack([c0,np.eye(3)[0],np.eye(3)[1]]).T)[0][:,2]
print('u',u,u@c0,'v',v,v@c0,'det uv c0', np.linalg.det(np.stack([u,v,c0])))
def eqs(p):
    a,b=p; b0=u+a*v; b1=u+b*v
    return [b0@M0@b1, b1@M0@b0]
sols=[]
for s in [(-1.,-1.),(1.,1.),(-3.,2.),(2.,-3.),(.5,3.),(5.,.3),(-.5,-2.)]:
    r,_,ier,_=fsolve(eqs,s,full_output=True)
    if ier==1 and np.linalg.norm(eqs(r))<1e-10: sols.append(r)
print('sols',sols)
def free(x):
    a=abs(x); return a<1e-9 or abs(a-1)<1e-9 or abs(a-.5)<1e-9 or abs(a-round(a))<1e-9
def count(nm,A): 
    A=np.array(A,float); A[np.abs(A)<1e-9]=0
    for idx in np.ndindex(A.shape):
        if abs(abs(A[idx])-1)<1e-9: A[idx]=np.sign(A[idx])*1
        if abs(abs(A[idx])-.5)<1e-9: A[idx]=np.sign(A[idx])*.5
    return A, sum(0 if free(z) else 1 for z in A.ravel())
def build(B):
    C=np.linalg.inv(B)
    return dict(E=E_s@C,P=P_s@C,M0=B@M0@B.T,VO0=B@VO0@C,M1=B@M1@B.T,VO1=B@VO1@C,WU=B@WU_d)
best=None
cand=[]
if sols: cand.append(sols[0])
cand.append((0.,0.))
for a,b in cand:
    b0=u+a*v; b1=u+b*v; b2=n
    b0=b0/(b0@WU_d[:,0]); b1=b1/(b1@WU_d[:,0]); b2=b2/(b2@WU_d[:,0])
    B=np.stack([b0,b1,b2]); D=build(B)
    al=1.0/abs(D['WU'][0,1]); D['WU']=D['WU']*al
    tot=0; Out={}
    for k in ['E','P','M0','VO0','M1','VO1','WU']:
        A,c=count(k,D[k]); Out[k]=A; tot+=c
    print('cand a,b=',a,b,'cond',np.linalg.cond(B),'consts',tot)
    if best is None or tot<best[0]: best=(tot,Out,B)
print('BEST count',best[0])
D=best[1]
for k in ['E','P','M0','VO0','M1','VO1','WU']: print(k,'='); print(repr(D[k]))
# verify decisions
def fwd(x,Em,Pm,M0m,VO0m,M1m,VO1m,WUm):
    h=np.stack([Em[x[:,p],:]+Pm[p] for p in range(4)],1)
    def sm(z): z=z-z.max(-1,keepdims=True); e=np.exp(z); return e/e.sum(-1,keepdims=True)
    p0=sm(h@M0m@np.transpose(h,(0,2,1))); h=h+p0@h@VO0m
    p1=sm(h@M1m@np.transpose(h,(0,2,1))); h=h+p1@h@VO1m
    WU4=np.zeros((3,4)); WU4[:,[0,2,3]]=WUm
    return h[:,3,:]@WU4
o=fwd(X,D['E'],D['P'],D['M0'],D['VO0'],D['M1'],D['VO1'],D['WU'])
print('agree',(o.argmax(1)==run(X).argmax(1)).mean(), 'B',repr(best[2]))

