def fwd(hd0=False,hd1=False,M0a=None,M1a=None):
    h=E[X]+P[None]
    for hd,M,VO in ((hd0,M0 if M0a is None else M0a,VO0),(hd1,M1 if M1a is None else M1a,VO1)):
        s=h@M@h.transpose(0,2,1)
        p_=hard(s) if hd else sm(s)
        h=h+p_@h@VO
    return h[:,3,:]@WU
