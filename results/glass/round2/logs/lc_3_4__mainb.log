M0 = W['L0.W_Q'][0] @ W['L0.W_K'][0].T / np.sqrt(3)
M1 = W['L1.W_Q'][0] @ W['L1.W_K'][0].T / np.sqrt(3)
print("M0\n",M0)
print("M1\n",M1)
E = W['W_E']; P = W['W_pos']
# score(i query pos, j key pos, t token i, u token j) = (E[t]+P[i]) M (E[u]+P[j])^T
# decompose: token-token, token-pos, pos-token, pos-pos
def decomp(M):
    TT = E @ M @ E.T
    TP = E @ M @ P.T
    PT = P @ M @ E.T
    PP = P @ M @ P.T
    return TT,TP,PT,PP
for name,M in [("L0",M0),("L1",M1)]:
    TT,TP,PT,PP = decomp(M)
    print(name,"TT\n",np.round(TT,3))
    print(name,"TP\n",np.round(TP,3))
    print(name,"PT\n",np.round(PT,3))
    print(name,"PP\n",np.round(PP,3))

