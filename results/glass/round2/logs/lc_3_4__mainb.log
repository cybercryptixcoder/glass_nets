def r2(vals, keys):
    # group by keys, see variance explained
    from collections import defaultdict
    d=defaultdict(list)
    for i in range(256): d[tuple(keys[i])].append(vals[i])
    tot=0.0; var=vals.var()*len(vals)
    ss=0.0
    for k,v in d.items():
        v=np.array(v); ss+=((v-v.mean())**2).sum()
    return 1-ss/var
