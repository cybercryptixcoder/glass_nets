E=W['W_E']; P=W['W_pos']; U=W['W_U']
M0=W['L0.W_Q'][0]@W['L0.W_K'][0].T; OV0=W['L0.W_V'][0]@W['L0.W_O'][0]
M1=W['L1.W_Q'][0]@W['L1.W_K'][0].T; OV1=W['L1.W_V'][0]@W['L1.W_O'][0]
B1 = E.T @ np.linalg.inv(E@E.T)
u,s,vt=np.linalg.svd(E); B=np.hstack([B1, vt[5][:,None]]); Binv=np.linalg.inv(B)
r=lambda A: np.round(A,5)
Pt=r(P@B); M0t=r(Binv@M0@Binv.T); OV0t=r(Binv@OV0@B); M1t=r(Binv@M1@Binv.T)
OV1t=Binv@OV1@B; Ut=r(Binv@U); Gt=r(OV1t@Ut); OV1t=r(OV1t)
def fw(tokens,P_,M0_,OV0_,M1_,G_,U_):
    oh=np.eye(5)[tokens]
    x=np.concatenate([oh,np.zeros(oh.shape[:2]+(1,))],axis=2)+P_[None]
    sc=x@M0_@x.transpose(0,2,1)/np.sqrt(6); sc-=sc.max(2,keepdims=True)
    pat=np.exp(sc); pat/=pat.sum(2,keepdims=True)
    x=x+pat@x@OV0_
    sc=x@M1_@x.transpose(0,2,1)/np.sqrt(6); sc-=sc.max(2,keepdims=True)
    p1=np.exp(sc); p1/=p1.sum(2,keepdims=True)
    return x[:,4,:]@U_ + (p1[:,4:,:]@x)[:,0,:]@G_
base=run(X).argmax(1)
lg=fw(toks,Pt,M0t,OV0t,M1t,Gt,Ut)
print("dec", (lg.argmax(1)==base).mean(), "R2", 1-((lg-run(X))**2).sum()/((run(X)-run(X).mean(0))**2).sum())
def pr(nm,A): print(nm, np.array2string(A,precision=4,separator=',',max_line_width=250,floatmode='fixed').replace(' ',''))
pr('Pt',Pt);pr('M0t',M0t);pr('OV0t',OV0t);pr('M1t',M1t)
pr('Gt',Gt);pr('Ut',Ut);pr('OV1t',OV1t)

