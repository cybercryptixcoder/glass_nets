def model(x, iv):
    t = x.astype(int)
    toks = [iv("tok%d" % p, np.eye(5)[t[:, p]]) for p in range(5)]
    PTg = np.take(PT, t, axis=1).swapaxes(0, 1)
    sc = (TT[t[:, :, None], t[:, None, :]] + TP[t] + PTg + PP[None, :, :])
    sc = sc - sc.max(2, keepdims=True)
    ex = np.exp(sc)
    pat0 = iv("pat0", (ex / ex.sum(2, keepdims=True)).reshape(-1, 25))
    return toks[4] @ W_E @ W_U

