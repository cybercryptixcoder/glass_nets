import numpy as np
np.set_printoptions(precision=6, suppress=True, linewidth=250, threshold=10000)

def fwd(tokens):
    E=W['W_E']; P=W['W_pos']; U=W['W_U']
    x = E[tokens] + P[None,:,:]           # B,5,6
    out={}
    out['embed']=x.copy()
    for l in [0,1]:
        WQ=W[f'L{l}.W_Q'][0]; WK=W[f'L{l}.W_K'][0]; WV=W[f'L{l}.W_V'][0]; WO=W[f'L{l}.W_O'][0]
        q=x@WQ; k=x@WK; v=x@WV
        sc=q@k.transpose(0,2,1)/np.sqrt(6)
        sc=sc-sc.max(2,keepdims=True)
        ex=np.exp(sc); pat=ex/ex.sum(2,keepdims=True)
        o=pat@v@WO
        out[f'attn{l}.pattern']=pat
        out[f'attn{l}.out']=o
        x=x+o
        out[f'resid{l}.mid']=x.copy()
    out['out']=x[:,4,:]@U
    return out

