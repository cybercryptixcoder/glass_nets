E=W['W_E']; P=W['W_pos']; U=W['W_U']
M0=W['L0.W_Q'][0]@W['L0.W_K'][0].T; OV0=W['L0.W_V'][0]@W['L0.W_O'][0]
M1=W['L1.W_Q'][0]@W['L1.W_K'][0].T; OV1=W['L1.W_V'][0]@W['L1.W_O'][0]
B1=E.T@np.linalg.inv(E@E.T); u,s,vt=np.linalg.svd(E); B=np.hstack([B1,vt[5][:,None]]); Bi=np.linalg.inv(B)
Pt=P@B; M0t=Bi@M0@Bi.T; OV0t=Bi@OV0@B; M1t=Bi@M1@Bi.T; OV1t=Bi@OV1@B; Ut=Bi@U
def trunc(A,r):
    uu,ss,vv=np.linalg.svd(A,full_matrices=False)
    return (uu[:,:r]*ss[:r])@vv[:r]
def fw(tokens,Ms,Ts):
    oh=np.eye(5)[tokens]
    x=np.concatenate([oh,np.zeros(oh.shape[:2]+(1,))],2)+Pt[None]
    def sm(s):
        s=s-s.max(2,keepdims=True); e=np.exp(s); return e/e.sum(2,keepdims=True)
    x=x+sm(x@Ms[0]@x.transpose(0,2,1)/np.sqrt(6))@x@Ts[0]
    r1=x+sm(x@Ms[1]@x.transpose(0,2,1)/np.sqrt(6))@x@Ts[1]
    return r1[:,4,:]@Ut
base=run(X).argmax(1)
combos={
 'exact':([M0t,M1t],[OV0t,OV1t]),
