import numpy as np
E=W['W_E']; P=W['W_pos']; U=W['W_U']
Q0=W['L0.W_Q'][0]; K0=W['L0.W_K'][0]; V0=W['L0.W_V'][0]; O0=W['L0.W_O'][0]
Q1=W['L1.W_Q'][0]; K1=W['L1.W_K'][0]; V1=W['L1.W_V'][0]; O1=W['L1.W_O'][0]
B1 = E.T @ np.linalg.inv(E@E.T)          # 6x5 right inverse
u,s,vt=np.linalg.svd(E); b6=vt[5]         # null vector
B = np.hstack([B1, b6[:,None]])           # 6x6
print("EB\n", np.round(E@B,8))
Binv=np.linalg.inv(B)
Pt = P@B
M0t = Binv@(Q0@K0.T)@Binv.T
OV0t= Binv@(V0@O0)@B
M1t = Binv@(Q1@K1.T)@Binv.T
OV1t= Binv@(V1@O1)@B
Ut  = Binv@U
Gt  = OV1t@Ut
def fw(tokens, P_,M0_,OV0_,M1_,OV1_,U_,G_,dims=6):
    oh=np.eye(5)[tokens]
    x=np.concatenate([oh,np.zeros(oh.shape[:2]+(1,))],axis=2)+P_[None]
    if dims<6:
        keep=np.arange(dims)
        x=x[...,keep]
    def red(M): return M if dims==6 else M[np.ix_(keep,keep)]
    sc=x@red(M0_)@x.transpose(0,2,1)/np.sqrt(6); sc-=sc.max(2,keepdims=True)
    pat=np.exp(sc); pat/=pat.sum(2,keepdims=True)
    o=pat@x@red(OV0_); x=x+o
    sc=x@red(M1_)@x.transpose(0,2,1)/np.sqrt(6); sc-=sc.max(2,keepdims=True)
    p1=np.exp(sc); p1/=p1.sum(2,keepdims=True)
    o4=(p1[:,4:,:]@x)[:,0,:]
    G=G_ if dims==6 else G_[:dims]
    Uu=U_ if dims==6 else U_[:dims]
    return x[:,4,:]@Uu + o4@G
base=run(X).argmax(1)
for d in [6,5,4]:
    print(d, (fw(toks,Pt,M0t,OV0t,M1t,OV1t,Ut,Gt,d).argmax(1)==base).mean())

