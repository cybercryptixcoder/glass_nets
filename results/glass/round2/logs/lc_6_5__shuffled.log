Pt=P@B; M0t=Bi@M0@Bi.T; OV0t=Bi@OV0@B; M1t=Bi@M1@Bi.T; OV1t=Bi@OV1@B; Ut=Bi@U; Gt=OV1t@Ut
def parts(tokens):
