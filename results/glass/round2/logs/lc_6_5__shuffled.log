WQ=W['L0.W_Q'][0]; WK=W['L0.W_K'][0]; WV=W['L0.W_V'][0]; WO=W['L0.W_O'][0]
E=W['W_E']; P=W['W_pos']
# score(i,j) = (E[t_i]+P[i]) WQ . (E[t_j]+P[j]) WK
A=acts(X)
pat0exp = A['attn0.pattern'].reshape(-1,5,5)
# build predicted pattern from tokens
qall = (np.einsum('td,dk->tk', E, WQ))  # token part of q
kall = (np.einsum('td,dk->tk', E, WK))
qp = np.einsum('pd,dk->pk', P, WQ)  # pos part
kp = np.einsum('pd,dk->pk', P, WK)
def pat_from(tokens):
    q = qall[tokens] + qp[None,:,:]   # B,5,6
    k = kall[tokens] + kp[None,:,:]
    sc = np.einsum('bik,bjk->bij', q, k)/np.sqrt(6)
    sc = sc - sc.max(2,keepdims=True)
    ex = np.exp(sc); return ex/ex.sum(2,keepdims=True)
p0 = pat_from(toks)
print("pattern0 reconstruct err", np.abs(p0-pat0exp).max())

