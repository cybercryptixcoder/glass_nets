def obj(xflat, k):
    x = xflat[None,:]
    o = run(x)[0]
    return o[k] - np.max(np.delete(o,k))
def grad(f, x, eps=1e-4):
    g = np.zeros_like(x)
    for i in range(len(x)):
        xp=x.copy(); xp[i]+=eps; xm=x.copy(); xm[i]-=eps
        g[i]=(f(xp)-f(xm))/(2*eps)
    return g
