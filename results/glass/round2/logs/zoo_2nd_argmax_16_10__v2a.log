def states(x,Wx,Wh):
    hs=[];h=np.zeros((x.shape[0],16))
    for t in range(10):
        h=np.maximum(x[:,t:t+1]*Wx + h@Wh,0.0); hs.append(h.copy())
    return hs
def tail_from(x,h0,t,Wx,Wh,Wo):
    h=h0.copy()
    for s in range(t+1,10): h=np.maximum(x[:,s:s+1]*Wx + h@Wh,0.0)
    return h@Wo
