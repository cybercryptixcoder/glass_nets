def fit(V, H):
    V1 = np.hstack([V, np.ones((len(V),1))])
    c,_,_,_ = np.linalg.lstsq(V1,H,rcond=None)
    P = V1@c
    return 1-((H-P)**2).sum()/((H-H.mean(0))**2).sum()
