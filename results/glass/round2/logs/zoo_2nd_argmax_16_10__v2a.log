def model(x, iv):
    p1 = iv("p1", np.maximum(x[:, 0], 0.0))
    n1 = iv("n1", np.maximum(-x[:, 0], 0.0))
    p2 = iv("p2", np.maximum(x[:, 1], 0.0))
    n2 = iv("n2", np.maximum(-x[:, 1], 0.0))
    h = p1[:, None]*A_ + n1[:, None]*B_                 # exact h1
    h = np.maximum(p2[:, None]*A_ + n2[:, None]*(-B_) + h@Wh - n2[:, None]*(-B_)*0, -1e9)
    h = np.maximum((p2 - n2)[:, None]*Wx + (p1[:, None]*A_ + n1[:, None]*B_)@Wh, 0.0)
    for t in range(2, 10):
        h = iv("h%d" % (t+1), np.maximum(x[:, t:t+1]*Wx + h@Wh, 0.0))
    return h@Wo
ALIGN = {"p1": ["h1"], "n1": ["h1"], "p2": ["h2"], "n2": ["h2"]}
ALIGN.update({"h%d" % (t+1): ["h%d" % (t+1)] for t in range(2, 10)})

