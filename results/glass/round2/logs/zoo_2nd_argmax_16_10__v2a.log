import numpy as np
np.set_printoptions(precision=3, suppress=True, linewidth=200)
Xa = X[:4000]
out = run(Xa)
lab = out.argmax(1)
# candidate rules: return class index (0..9 position index)
def r_argmax(x): return x.argmax(1)
def r_second(x):
    o=np.argsort(x,1); return o[:,-2]
def r_third(x):
    o=np.argsort(x,1); return o[:,-3]
def r_argmax_cumsum(x): return x.cumsum(1).argmax(1)
def r_argmin(x): return x.argmin(1)
def r_lastnewmax(x):
    return np.array([np.max(np.nonzero(x[i]==x[i].max())[0]) for i in range(len(x))])
def r_firstnewmax(x):
    return np.array([np.min(np.nonzero(x[i]==x[i].max())[0]) for i in range(len(x))])
def r_absmax(x): return np.abs(x).argmax(1)
def r_maxdiff(x):
    d = np.diff(x,axis=1); return d.argmax(1)+1
def r_mindiff(x):
    d = np.diff(x,axis=1); return d.argmin(1)+1
cands = dict(argmax=r_argmax, second=r_second, third=r_third, cumsum=r_argmax_cumsum, argmin=r_argmin,
             lastnewmax=r_lastnewmax, firstnewmax=r_firstnewmax, absmax=r_absmax, maxdiff=r_maxdiff, mindiff=r_mindiff)
for k,f in cands.items():
    print(k, (f(Xa)==lab).mean().round(3))
print("label dist", np.bincount(lab, minlength=10))
# rank of winning input
rankw = (-Xa).argsort(1).argsort(1)[np.arange(len(Xa)), lab]
print("rank dist", np.bincount(rankw, minlength=10))

