def basis(v):  # hinge basis
    return np.column_stack([v] + [np.maximum(v-k,0) for k in knots] + [np.maximum(k-v,0) for k in knots])
F = np.hstack([basis(Xa[:,t]) for t in range(10)])
print("GAM feature dim", F.shape)
# fit per class with ridge
F1 = np.hstack([np.ones((len(F),1)), F])
Wg = np.linalg.lstsq(F1, out, rcond=None)[0]
pred = F1@Wg
print("GAM R2 per class", (1-((out-pred)**2).sum(0)/((out-out.mean(0))**2).sum(0)).round(3))
print("GAM argmax agree", (pred.argmax(1)==out.argmax(1)).mean().round(3))

