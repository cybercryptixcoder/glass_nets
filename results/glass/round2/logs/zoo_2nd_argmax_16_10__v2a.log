def obj(xflat, k):
    x = xflat[None,:]
    o = run(x)[0]
    return o[k] - np.max(np.delete(o,k))
def grad(f, x, eps=1e-4):
    g = np.zeros_like(x)
    for i in range(len(x)):
        xp=x.copy(); xp[i]+=eps; xm=x.copy(); xm[i]-=eps
        g[i]=(f(xp)-f(xm))/(2*eps)
    return g
np.set_printoptions(precision=2, suppress=True, linewidth=220)
rng=np.random.default_rng(1)
for k in range(10):
    best=None
    for trial in range(6):
        x = rng.standard_normal(10); x/=np.linalg.norm(x)
        for it in range(300):
            g = grad(lambda z: obj(z,k), x)
            g = g - (g@x)*x
            x = x + 0.05*g/np.linalg.norm(g)
            x = x/np.linalg.norm(x)
        v = obj(x,k)
        if best is None or v>best[0]: best=(v,x.copy())
    print(k, "val %.2f"%best[0], "x*10:", (best[1]*3).round(2), "armax", run((best[1]*3)[None,:])[0].argmax())

