    h2u = h2 + (v2 - b2)@P2
    h3 = np.maximum(x[:, 2:3]*Wx + h2u@Wh, 0.0)
    b3 = h3[:, C3]
    v3 = iv("h3v", b3)
    P3 = np.linalg.lstsq(b3, h3, rcond=None)[0]
    h = h3 + (v3 - b3)@P3
    for t in range(3, 10):
        h = iv("h%d" % (t+1), np.maximum(x[:, t:t+1]*Wx + h@Wh, 0.0))
    return h@Wo
ALIGN = {"p1": ["h1"], "n1": ["h1"], "h2v": ["h2"], "h3v": ["h3"]}
ALIGN.update({"h%d" % (t+1): ["h%d" % (t+1)] for t in range(3, 10)})

