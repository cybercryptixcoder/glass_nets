    n1 = iv("n1", np.maximum(-x[:, 0], 0.0))
    h = p1[:, None]*A_ + n1[:, None]*B_
    h2 = np.maximum(x[:, 1:2]*Wx + h@Wh, 0.0)
    b2 = h2[:, C2]
    v2 = iv("h2v", b2)
    P2 = np.linalg.lstsq(b2, h2, rcond=None)[0]
    h2u = h2 + (v2 - b2)@P2
    h3 = np.maximum(x[:, 2:3]*Wx + h2u@Wh, 0.0)
    b3 = h3[:, C3]
    v3 = iv("h3v", b3)
    P3 = np.linalg.lstsq(b3, h3, rcond=None)[0]
    h3u = h3 + (v3 - b3)@P3
    h = h3u
    for t in range(3, 10):
        h = iv("h%d" % (t+1), np.maximum(x[:, t:t+1]*Wx + h@Wh, 0.0))
    return h@Wo
ALIGN = {"p1": ["h1"], "n1": ["h1"], "h2v": ["h2"], "h3v": ["h3"]}
ALIGN.update({"h%d" % (t+1): ["h%d" % (t+1)] for t in range(4, 10)})

