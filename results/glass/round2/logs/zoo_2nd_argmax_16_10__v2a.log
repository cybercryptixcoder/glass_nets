def jac(x1):
    x = x1[None,:].copy()
    base = run(x)[0]
    J = np.zeros((10,10))
    eps=1e-4
    for t in range(10):
        xp = x.copy(); xp[0,t]+=eps
        xm = x.copy(); xm[0,t]-=eps
        J[:,t] = (run(xp)[0]-run(xm)[0])/(2*eps)
    return base, J
np.set_printoptions(precision=2, suppress=True, linewidth=200)
for i in [0,1,2]:
    b,J = jac(X[i])
    print("x", X[i].round(2))
    print("argmax", b.argmax())
    print(J.round(2))

