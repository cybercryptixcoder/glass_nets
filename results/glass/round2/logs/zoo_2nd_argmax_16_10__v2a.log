def model(x, iv):
    p1 = iv("p1", np.maximum(x[:, 0], 0.0))
    n1 = iv("n1", np.maximum(-x[:, 0], 0.0))
    h = p1[:, None]*A_ + n1[:, None]*B_
    for t in range(1, 10):
        h = iv("h%d" % (t+1), np.maximum(x[:, t:t+1]*Wx + h@Wh, 0.0))
    return h@Wo
