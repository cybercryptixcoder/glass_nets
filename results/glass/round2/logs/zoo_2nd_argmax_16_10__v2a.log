dR=np.argmax(hsR[-1]@W_o,1); dQ=np.argmax(hsQ[-1]@Woq,1)
rng=np.random.default_rng(1); B=np.arange(4000); A=rng.permutation(4000)
print("behaviour %.4f"%((dQ==dR).mean()))
for t in range(10):
    # judge: activation at site t of B replaced by B + (vA-vB); v probed ~= my model states
    hswap = hsR[t][B] + (hsQ[t][A]-hsQ[t][B])
    dnet = np.argmax(tail_from(Xa[B],hswap,t,Wx,Wh,W_o),1)
    # my model: site t variable replaced by A's value -> continue my model from state hsQ[t][A] but inputs of B
    dmod = np.argmax(tail_from(Xa[B],hsQ[t][A],t,Wxq,Whq,Woq),1)
    ch = dnet!=dR[B]
    print("t=%d interch all %.3f (changed %d) " %(t+1,(dmod[ch]==dnet[ch]).mean(),ch.sum()), end="")
    # also substitute test
    sub=np.argmax(tail_from(Xa,hsQ[t],t,Wx,Wh,W_o),1)
    print("subst %.3f"%((sub==dR).mean()))

