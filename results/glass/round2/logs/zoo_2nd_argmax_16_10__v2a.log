def dictfeat(x):
    n = len(x); srt = np.sort(x,1); 
    am = x.argmax(1); se = np.argsort(x,1)[:,-2]
    oh = np.eye(10)[am]; oh2 = np.eye(10)[se]
    m = srt[:,-1:]; s = srt[:,-2:-1]
    return np.hstack([srt, m*oh, s*oh2, oh, oh2, x.sum(1,keepdims=True), np.maximum(x,0).sum(1,keepdims=True), x[:,9:10], x[:,0:1]])
F = dictfeat(Xa); print("feat dim", F.shape)
F1 = np.hstack([np.ones((len(F),1)), F])
for nm, H in [("h5",H5),("h10",H10)]:
    Wg = np.linalg.lstsq(F1, H, rcond=None)[0]; P = F1@Wg
    r2 = 1-((H-P)**2).sum(0)/((H-H.mean(0))**2).sum(0)
    print(nm, "unit R2", r2.round(3))

