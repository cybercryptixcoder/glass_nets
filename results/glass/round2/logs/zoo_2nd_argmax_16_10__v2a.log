def model(x, iv):
    p = []; n = []
    for t in range(3):
        p.append(iv("p%d" % (t+1), np.maximum(x[:, t], 0.0)))
        n.append(iv("n%d" % (t+1), np.maximum(-x[:, t], 0.0)))
    c1 = p[0]+n[0]; c2 = c1+p[1]+n[1]
    iv("c21", np.maximum(p[1]+n[1]-c1, 0.0)); iv("c12", np.maximum(c1-(p[1]+n[1]), 0.0))
    iv("c32", np.maximum(p[2]+n[2]-c2, 0.0)); iv("c23", np.maximum(c2-(p[2]+n[2]), 0.0))
    h = p[0][:, None]*A_ + n[0][:, None]*B_
    h = np.maximum((p[1]-n[1])[:, None]*Wx + h@Wh, 0.0)
    h = np.maximum((p[2]-n[2])[:, None]*Wx + h@Wh, 0.0)
    for t in range(3, 10):
        h = iv("h%d" % (t+1), np.maximum(x[:, t:t+1]*Wx + h@Wh, 0.0))
    return h@Wo
