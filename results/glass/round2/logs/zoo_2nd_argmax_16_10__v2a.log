cm = cs - (k/10.0)*cs[:,-1:]
cands['cs-detrend']=cm
cands['cs-mean'] = cs - cs.mean(1,keepdims=True)
prevm = np.cumsum(np.concatenate([np.zeros((len(X),1)), cs[:,:-1]],1),1)/k  # sum of prefix means
cands['x-prefmean'] = X - np.c_[np.zeros(len(X)), cs[:,:-1]]/np.arange(1,11)
cands['-|cs|'] = -np.abs(cs)
cands['abs-cs'] = np.abs(cs)
# z-score of x with prefix stats
pmean = np.c_[np.zeros(len(X)), cs[:,:-1]]/np.arange(1,11)
psq = np.c_[np.zeros(len(X)), (X**2).cumsum(1)[:,:-1]]/np.arange(1,11)
for kk,v in cands.items():
    print("%-14s %.3f"%(kk,(v.argmax(1)==am).mean()))
m=1
print()
print("Cs/k test detail: ", (cands['cs/k^1.0'].argmax(1)==am).mean())

