import numpy as np, itertools

CODE = np.array([[1,0,0],[0,1,0],[0,0,1],[0,0,0]], dtype=float)

def _lens(tt):
    B = tt.shape[0]
    L = np.zeros(B, dtype=int)
    for b in range(B):
        f = tt[b]
        best = 1
        for i in range(4):
            seen = []
            cur = int(i)
            while cur not in seen:
                seen.append(cur)
                cur = int(f[cur])
            cyc = len(seen) - seen.index(cur)
            if cyc > best: best = cyc
        L[b] = best - 1
    return L

def model(x, iv):
    x = np.asarray(x, dtype=int)
    B = x.shape[0]
    oh = []
    for p in range(4):
        v = np.zeros((B,4))
        v[np.arange(B), x[:,p]] = 1.0
        oh.append(v)
    v0 = iv("tok0", oh[0]); v1 = iv("tok1", oh[1]); v2 = iv("tok2", oh[2]); v3 = iv("tok3", oh[3])
    tt = np.stack([np.argmax(v, axis=1) for v in (v0,v1,v2,v3)], axis=1)
    L = _lens(tt)
    code = CODE[L]
    c = iv("cls", code)
    logits = np.stack([c[:,0], c[:,1], c[:,2], 1.0 - c[:,0] - c[:,1] - c[:,2]], axis=1)
    return logits

def ident(name, val):
    return val

# test all inputs
X = np.array(list(itertools.product(range(4), repeat=4)))
out = model(X, ident)
pred = np.argmax(out, axis=1)
true = np.array([_lens(X)[i] for i in range(len(X))])
print('accuracy', np.mean(pred==true))
print('first few', out[:5], pred[:5], true[:5])
# test override cls from another input
B=3; A=10
x = X[[B]]
c_orig = CODE[_lens(X[[B]])[0]]
c_A = CODE[_lens(X[[A]])[0]]
def iv_override(name, val):
    if name=='cls':
        return c_A[None,:]
    return val
out2 = model(x, iv_override)
print('override pred', np.argmax(out2), 'A true', _lens(X[[A]])[0])
