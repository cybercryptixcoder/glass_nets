import numpy as np, itertools

def longest_cycle(f):
    best=1
    for i in range(4):
        seen=[]
        cur=i
        while cur not in seen:
            seen.append(cur)
            cur=f[cur]
        cyc=len(seen)-seen.index(cur)
        if cyc>best: best=cyc
    return best-1

# test all functions
from collections import Counter
cnt=Counter()
for f in itertools.product(range(4), repeat=4):
    cnt[longest_cycle(f)] += 1
print(cnt, sum(cnt.values()))
# check a few
for f in [(0,1,2,0),(1,2,3,0),(3,3,3,3),(1,0,3,2)]:
    print(f, longest_cycle(f))
