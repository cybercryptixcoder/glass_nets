A=acts(X); S=np.cumsum(X,axis=1)
from scipy.spatial import cKDTree
def knn_test(feat,site,nn=8):
    a=A[site]
    t=cKDTree(feat)
    d,idx=t.query(feat,k=nn)
    # neighbor spread of a relative to overall
    pred=a[idx[:,1:]].mean(1)
    r2=1-((a-pred)**2).sum(0)/((a-a.mean(0))**2).sum(0)
    return np.round(r2,3)
for t,s in enumerate(['h1','h2','h3','h4']):
    print(s, "f(S_t,x_t)",knn_test(np.stack([S[:,t],X[:,t]],1),s),
          " f(x1..xt)",knn_test(X[:,:t+1],s),
          " f(S_t, xt-1)", knn_test(np.stack([S[:,t], X[:,max(t-1,0)]],1),s))

