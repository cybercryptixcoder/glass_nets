A=acts(X)
S=np.cumsum(X,axis=1)
def test(Sv,site,idx):
    a=A[site]
    # sort by Sv, compare consecutive
    o=np.argsort(Sv)
    d=np.abs(np.diff(Sv[o]))
    da=np.abs(np.diff(a[o],axis=0)).max(1)
    sel=d<1e-3
    print(site, idx, "pairs",sel.sum(),"mean |dh|",da[sel].mean(), "typpair |dh|", np.abs(np.diff(a[o],axis=0)).mean())
for t,s in enumerate(['h1','h2','h3','h4']):
    test(S[:,t], s, t)
# also weighted sums
for w in [[1,1,1,1],[1,.5,.25,.125],[.125,.25,.5,1],[1,2,3,4],[4,3,2,1]]:
    v=X@np.array(w)
    test(v,'h4','w=%s'%w)

