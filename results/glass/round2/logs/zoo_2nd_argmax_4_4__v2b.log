def nearest_free(v):
    cand=[f for f in FREE]
    return min(cand, key=lambda f: abs(f-v)/max(abs(v),1e-9)), min(abs(f-v)/max(abs(v),1e-9) for f in cand)
def score(M, wstate=0.1):
    h=u1; S=[]
    for t in range(1,4):
        h=np.maximum(Xf[:,t:t+1]*SGN+h@M,0); S.append(h)
    D,_,_,_=np.linalg.lstsq(S[2],m_net,rcond=None)
    L=np.sum((S[2]@D-m_net)**2)/n1+wstate*sum(np.sum((S[k]-U[k+2])**2)/vs[k] for k in range(3))
    pred=np.column_stack([np.zeros(len(S[2])),S[2]@D]).argmax(1)
    return L,(pred==dref).mean(),[np.linalg.norm(S[k]-U[k+2])/np.linalg.norm(U[k+2]) for k in range(3)],D
def refit(fixed, iters=50, wstate=0.1):
    keys=[p for p in allpos if p not in fixed]
    def asm(th):
        M=M0.copy()
        for k,v in fixed.items(): M[k]=v
        for k,v in zip(keys,th): M[k]=v
        return M
    th0=np.array([M0[k] for k in keys])
    r=minimize(lambda t: score(asm(t),wstate)[0], th0, method='L-BFGS-B', options={'maxiter':iters})
    return score(asm(r.x),wstate)
