SGN=np.array([1.,-1.,-1.,1.]); u1=np.maximum(Xf[:,0:1]*SGN,0)
n1=np.var(m_net); vs=[np.var(U[t]) for t in [2,3,4]]; dref=run(Xf).argmax(1)
M0=np.array([[-0.212043,1.271137,-0.071773,2.302952],
