A=acts(X)
def pca(a,k):
    m=a.mean(0); aa=a-m; U,S,Vt=np.linalg.svd(aa,full_matrices=False); return m, Vt[:k].T, (S**2/ (S**2).sum())
for t,s in enumerate(['h1','h2','h3']):
    a=A[s]; m,P,ev=pca(a,2)
    g=(a-m)@P
    nxt=A['h%d'%(t+2)]
    F=np.hstack([g, X[:,t+1:t+2], np.ones((len(X),1))])
    M,_,_,_=np.linalg.lstsq(F,nxt,rcond=None)
    pred=F@M
    print(s,"->",'h%d'%(t+2),"ev",np.round(ev[:3],3),"R2",np.round(1-((nxt-pred)**2).sum(0)/((nxt-nxt.mean(0))**2).sum(0),3))
    # also with 3 dims
    m,P3,_=pca(a,3); g3=(a-m)@P3
    F=np.hstack([g3, X[:,t+1:t+2], np.ones((len(X),1))])
    M,_,_,_=np.linalg.lstsq(F,nxt,rcond=None); pred=F@M
    print("   3dim R2",np.round(1-((nxt-pred)**2).sum(0)/((nxt-nxt.mean(0))**2).sum(0),3))

