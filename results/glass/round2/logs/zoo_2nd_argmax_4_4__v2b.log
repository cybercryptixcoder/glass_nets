def run_model(M):
    h=u1; S=[]
    for t in range(1,4):
        h=np.maximum(Xf[:,t:t+1]*SGN+h@M,0); S.append(h)
    return S
def score(M):
    S=run_model(M); D,_,_,_=np.linalg.lstsq(S[2],m_net,rcond=None)
    L=np.sum((S[2]@D-m_net)**2)/n1+0.1*sum(np.sum((S[k]-U[k+2])**2)/vs[k] for k in range(3))
    pred=np.column_stack([np.zeros(len(S[2])),S[2]@D]).argmax(1)
    return L,(pred==dref).mean(),[np.linalg.norm(S[k]-U[k+2])/np.linalg.norm(U[k+2]) for k in range(3)],M,D
def build(params, cons):
    # cons: list of callables M -> residuals (0 when satisfied); params fill free slots
    M=M0.copy()
    for (i,j),v in params.items(): M[i,j]=v
    for c in cons: c(M)
    return M
def refit(cons_list, free_pos, iters=60):
    keys=free_pos
    def assemble(th):
        M=M0.copy()
        for k,v in zip(keys,th): M[k]=v
        for c in cons_list: c(M)
        return M
    f=lambda th: score(assemble(th))[0]
    th0=np.array([M0[k] for k in keys])
    r=minimize(f,th0,method='L-BFGS-B',options={'maxiter':iters})
    L,a,se,M,D=score(assemble(r.x))
    return a,se,M,D,L
