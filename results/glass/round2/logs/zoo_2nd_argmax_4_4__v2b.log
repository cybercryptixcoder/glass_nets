# check diag + rank1 fit
def fit_diag_rank1(A):
    d = np.diag(A).copy()
    best=None
    for _ in range(200):
        R = A - np.diag(d)
        u,s,vt = np.linalg.svd(R)
        u1,v1 = u[:,0]*s[0], vt[0]
        R2 = np.outer(u1,v1)
        d = np.diag(A - R2)
        if best is None or np.linalg.norm(A-R2-np.diag(d))<best: best=np.linalg.norm(A-R2-np.diag(d))
    return best/np.linalg.norm(A)
print("diag+rank1 rel resid", fit_diag_rank1(Wh), fit_diag_rank1(Wh2))

