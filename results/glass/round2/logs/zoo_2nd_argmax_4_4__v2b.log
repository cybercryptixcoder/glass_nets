def make_spec(groups):
    # groups: list of lists of ((i,j), sign) sharing one literal
    spec = {}
    for g,grp in enumerate(groups):
        for p,sg in grp: spec[p]=(g,sg)
    return spec, len(groups)
def assemble(spec, th):
    M=np.zeros((4,4))
    for (i,j),(g,sg) in spec.items(): M[i,j]=sg*th[g]
    return M
def lossf(spec, npar, th, wstate=0.1):
    M = assemble(spec,th); h=u1; S=[]
    for t in range(1,4):
        h=np.maximum(X1[:,t:t+1]*SGN + h@M,0); S.append(h)
    D,_,_,_=np.linalg.lstsq(S[2],m_net,rcond=None)
    return (np.sum((S[2]@D-m_net)**2)/n1 + wstate*sum(np.sum((S[k]-U[k+2])**2)/vs[k] for k in range(3)))
def evaluate(spec,npar,th,wstate=0.1):
    M=assemble(spec,th); h=u1; S=[]
    for t in range(1,4):
        h=np.maximum(X1[:,t:t+1]*SGN + h@M,0); S.append(h)
    D,_,_,_=np.linalg.lstsq(S[2],m_net,rcond=None)
    pred=np.column_stack([np.zeros(len(S[2])),S[2]@D]).argmax(1)
    return (pred==dref).mean(), [np.linalg.norm(S[k]-U[k+2])/np.linalg.norm(U[k+2]) for k in range(3)], M, D
def refit(groups, wstate=0.1, iters=80):
    spec,npar = make_spec(groups)
    th0=np.array([M0[groups[g][0][0]]*groups[g][0][1] for g in range(npar)])
    r=minimize(lambda t: lossf(spec,npar,t,wstate), th0, method='L-BFGS-B', options={'maxiter':iters})
    a,se,M,D = evaluate(spec,npar,r.x,wstate)
    return a, se, M, D, r.fun
