def knnR2(feat,target,nn=10):
    t=cKDTree(feat); d,idx=t.query(feat,k=nn)
    pred=target[idx[:,1:]].mean(1)
    return np.round(1-((target-pred)**2).sum(0)/((target-target.mean(0))**2).sum(0),3)
