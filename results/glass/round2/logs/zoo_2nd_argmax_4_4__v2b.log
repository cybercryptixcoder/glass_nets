def agree(Dm, extra=np.zeros(4)):
    o = h4@Dm
    d1 = np.argmax(np.column_stack([np.zeros(len(h4)), o]) + extra,1)
    o2 = h4@D
    d2 = np.argmax(np.column_stack([np.zeros(len(h4)), o2]),1)
    return (d1==d2).mean()
u,s,vt = np.linalg.svd(D)
for r in [1,2,3]:
