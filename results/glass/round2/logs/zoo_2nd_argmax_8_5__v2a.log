o=run(X)
def linfit(F,y):
    A=np.hstack([F,np.ones((len(F),1))])
    coef,_,_,_=np.linalg.lstsq(A,y,rcond=None)
    pred=A@coef
    r2=1-((y-pred)**2).sum(0)/((y-y.mean(0))**2).sum(0)
    return coef,pred,r2
