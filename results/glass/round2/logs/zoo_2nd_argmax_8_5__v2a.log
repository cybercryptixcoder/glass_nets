o=run(X); d=o.argmax(1)
Wx0=W['W_x'].ravel().copy(); Wh0=W['W_h'].copy(); Wo0=W['W_o'].copy()
def fwd(x,Wx,Wh,Wo):
    B=len(x); h=np.zeros((B,8))
    for t in range(5): h=np.maximum(x[:,t:t+1]*Wx[None,:]+h@Wh,0.0)
    return h@Wo
def agree(Wx,Wh,Wo):
    dd=fwd(X,Wx,Wh,Wo).argmax(1)
    return (dd==d).mean(), (dd[d!=np.array([np.argsort(np.argsort(-X[i]))[1] for i in range(len(X))]) ] )
# precompute task
p2=np.argsort(-X,axis=1)[:,1]
err=d!=p2
Wx,Wh,Wo=Wx0.copy(),Wh0.copy(),Wo0.copy()
slots=[('Wx',(i,)) for i in range(8)]+[('Wh',(i,j)) for i in range(8) for j in range(8)]+[('Wo',(i,j)) for i in range(8) for j in range(5)]
zeroed=[]
cur=agree(Wx,Wh,Wo)
print("start agree",round(cur[0],4),"mistakes reproduced", round((fwd(X,Wx,Wh,Wo).argmax(1)[err]==d[err]).mean(),3))
for step in range(40):
    best=None
    for kind,idx in slots:
        if (kind,idx) in zeroed: continue
        Wx2,Wh2,Wo2=Wx.copy(),Wh.copy(),Wo.copy()
        if kind=='Wx': Wx2[idx[0]]=0
        elif kind=='Wh': Wh2[idx]=0
        else: Wo2[idx]=0
        a=agree(Wx2,Wh2,Wo2)[0]
        if best is None or a>best[0]: best=(a,kind,idx,Wx2,Wh2,Wo2)
    a,kind,idx,Wx2,Wh2,Wo2=best
    Wx,Wh,Wo=Wx2,Wh2,Wo2; zeroed.append((kind,idx))
    dd=fwd(X,Wx,Wh,Wo).argmax(1)
    mr=(dd[err]==d[err]).mean()
    print(len(zeroed),"zeros: agree",round(a,4),"mistakes repro",round(mr,3),"last zeroed",kind,idx,"consts",112-len(zeroed))
    if a<0.93: break

