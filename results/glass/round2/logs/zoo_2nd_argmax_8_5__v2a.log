def r2(F,y):
    A=np.hstack([F,np.ones((len(F),1))])
    coef,_,_,_=np.linalg.lstsq(A,y,rcond=None); pred=A@coef
    return 1-((y-pred)**2).sum()/((y-y.mean(0))**2).sum()
