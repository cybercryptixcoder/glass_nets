def jac(x):
    # returns [B,5(out),5(step)]
    B=len(x); h=np.zeros((B,8)); J=np.zeros((B,8,5))
    for t in range(5):
        pre = x[:,t:t+1]*Wx[None,:] + h@Wh
        D=(pre>0).astype(float)
        J = D[:,:,None]*np.einsum('ij,bik->bjk', Wh, J); J[:,:,t]+= D*Wx[None,:]
        h=pre*D
    return np.einsum('bi,bik->bk', Wo[:, :].T[:,:,None][:,0][:,:], np.zeros((B,8,5)))+np.einsum('ic,bik->bck', Wo, J) if False else np.einsum('ic,bik->bck', Wo, J)
G = jac(X[:8])
for i in range(4):
    print(G[i].round(2))
    print("  sv", np.linalg.svd(G[i],compute_uv=False).round(2))

