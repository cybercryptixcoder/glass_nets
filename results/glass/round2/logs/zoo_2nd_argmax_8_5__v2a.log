def dec(site, targets, names):
    A=acts_h=np.hstack([a[site],np.ones((len(a[site]),1))])
    T=np.stack(targets,1)
    coef,_,_,_=np.linalg.lstsq(A,T,rcond=None); pred=A@coef
    r=1-((T-pred)**2).sum(0)/((T-T.mean(0))**2).sum(0)
    print(site, {n:round(v,3) for n,v in zip(names,r)})
