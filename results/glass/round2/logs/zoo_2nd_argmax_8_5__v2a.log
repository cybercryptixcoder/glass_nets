import numpy as np
DESCRIPTION = ("Stage 1 explained compactly: h1 = relu(x1*W_x) is exactly linear in the two numbers "
 "p=relu(x1), n=relu(-x1) (h1 = p*relu(W_x) + n*relu(-W_x)), and indeed the h1 activations span only a "
 "2-dimensional cone (two rays, one per sign of the first input). Later steps are a plain ReLU recurrence, "
 "currently reproduced with rounded weight literals as a diagnostic.")

Wx = np.array([0.6426,-6.4213,0.4235,-6.5737,0.0451,-4.9132,-0.0541,7.0017])
Wh = np.array([[ 0.1254, 0.1549, 0.4761, 0.0606, 0.7712, 0.0359, 0.9440,-0.1633],
 [-0.4647,-0.2364, 0.2723, 0.4929, 0.1691,-0.7322, 0.4242,-0.0270],
 [ 0.0200,-0.1290,-0.1069,-0.1902,-0.6185,-0.4238, 0.2399, 0.0816],
 [ 0.5281,-0.3000,-0.3628,-0.8475, 0.2793, 0.5697, 0.1986, 0.0612],
 [-0.1774,-0.3243, 0.2159,-0.2517,-0.7468,-0.1915,-1.2074, 0.3804],
 [ 0.8810, 0.6004, 0.1257, 0.3478, 0.1272, 0.0696,-0.7503, 0.0236],
 [ 0.1268, 0.9617,-0.0865, 0.9728, 0.5457, 0.6795, 0.7867,-0.8905],
 [-1.6559,-0.0172, 1.4186, 1.0877, 0.1558, 0.8149, 1.1020,-0.8279]])
Wo = np.array([[ 0.7160,-1.1366, 0.6797,-1.9484, 0.7274],
 [ 0.3365,-0.7161,-3.9047, 3.8852,-0.2393],
 [ 0.8486,-0.0691,-3.3868, 0.5665, 0.6334],
 [ 0.3597,-2.4261, 4.8036,-2.8565,-0.6731],
 [-0.4028, 2.1603,-0.4673,-0.4678,-0.3767],
 [-0.8712, 4.1999,-1.3507,-1.3102,-0.8445],
 [-0.8669,-0.9378, 0.5178, 0.6789, 0.4930],
 [ 0.2398, 0.3173, 0.3778, 0.3559,-2.2530]])

def model(x, iv):
    p = iv("x1_pos", np.maximum(x[:,0], 0.0))
    n = iv("x1_neg", np.maximum(-x[:,0], 0.0))
    h = p[:,None]*np.maximum(Wx,0.0) + n[:,None]*np.maximum(-Wx,0.0)
    h = np.maximum(x[:,1:2]*Wx + h @ Wh, 0.0)
    h = iv("s2", h)
    h = np.maximum(x[:,2:3]*Wx + h @ Wh, 0.0)
    h = iv("s3", h)
    h = np.maximum(x[:,3:4]*Wx + h @ Wh, 0.0)
    h = iv("s4", h)
    h = np.maximum(x[:,4:5]*Wx + h @ Wh, 0.0)
    h = iv("s5", h)
    return h @ Wo

ALIGN = {"x1_pos": ["h1"], "x1_neg": ["h1"], "s2": ["h2"], "s3": ["h3"], "s4": ["h4"], "s5": ["h5"]}

