def model(x, iv):
    x = np.asarray(x)
    xp = iv("x1_pos", np.maximum(x[:, 0], 0.0))[:, None]
    xn = iv("x1_neg", np.maximum(-x[:, 0], 0.0))[:, None]
    h = xp * WXP + xn * WXN
    for t in range(2, 9):
        h = iv("h%d" % t, np.maximum(x[:, t-1:t] * WX + h @ WH, 0.0))
    s = h @ WD
    return np.concatenate([np.zeros((len(x), 1)), s], axis=1)

ALIGN = {"x1_pos": ["h1"], "x1_neg": ["h1"]}
for t in range(2, 9):
    ALIGN["h%d" % t] = ["h%d" % t]

