def model(x, iv):
    x = np.asarray(x)
    xp = iv("x1_pos", np.maximum(x[:, 0], 0.0))[:, None]
    xn = iv("x1_neg", np.maximum(-x[:, 0], 0.0))[:, None]
    h = xp * P + xn * N
    for t in range(2, 9):
        h = iv("h%d" % t, np.maximum(x[:, t - 1:t] * S + h @ WH, 0.0))
    return np.concatenate([np.zeros((h.shape[0], 1)), h @ K], axis=1)

