def run(x):
    x=np.atleast_2d(np.asarray(x,dtype=float))
    h=np.zeros((x.shape[0],8))
    for t in range(8):
        h=np.maximum(x[:,t:t+1]*Wx+h@Wh,0.0)
    return h@Wo
def acts(x):
    x=np.atleast_2d(np.asarray(x,dtype=float))
    h=np.zeros((x.shape[0],8)); out={}
    for t in range(8):
        h=np.maximum(x[:,t:t+1]*Wx+h@Wh,0.0); out["h%d"%(t+1)]=h.copy()
    return out
