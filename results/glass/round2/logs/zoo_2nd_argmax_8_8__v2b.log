nice=[0.0,0.5,1.0,-1.0,2.0,-2.0,3.0,-3.0]
Wop_cols=[Wop[:,j] for j in range(8)]
base=Wop[:,0]
es=[]
K=np.zeros((8,7))
for j in range(1,8):
    w=Wop[:,j]; best=None
    for i in range(8):
        for n in nice:
            e=(n+base[i])/w[i]
            if e<=0: continue
            Kc=e*w-base
            # count how many entries are in nice set
            k=sum(1 for v in Kc if min(abs(v-n2) for n2 in nice)<1e-12)
            if k==0: continue
            sc=(k, -abs(np.log(e)))
            if best is None or sc>best[0]: best=(sc,e,Kc,i,n)
    es.append(best[1]); K[:,j-1]=best[2]
    print("col",j,"e",best[1],"row",best[3],"target",best[4],"nsnapped",best[0][0])
print("snapped count total", sum(1 for v in K.ravel() if min(abs(v-n) for n in nice)<1e-12))
print("counted in K", sum(1 for v in K.ravel() if min(abs(v-n) for n in nice)>1e-12))
# overall scale: make one entry nice
cand=[(0.5/v if v!=0 else None) for v in K.ravel()]
best=None
for i,v in enumerate(K.ravel()):
    if v==0: continue
    for n in [0.5,1.0,-1.0,2.0]:
        lam=n/v
        if lam<=0: continue
        Kc=K*lam
        k=sum(1 for u in Kc.ravel() if min(abs(u-n2) for n2 in nice)<1e-12)
        if best is None or k>best[0]: best=(k,lam)
print("after overall scale lam",best[1],"nsnapped",best[0])
K=K*best[1]
print("counted in scaled K", sum(1 for v in K.ravel() if min(abs(v-n) for n in nice)>1e-12))
np.save('/tmp/K.npy',K); np.save('/tmp/Whp.npy',Whp); np.save('/tmp/es.npy',np.array(es))

