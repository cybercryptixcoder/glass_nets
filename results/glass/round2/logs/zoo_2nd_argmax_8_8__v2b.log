def model(x, iv):
    xp = iv("x1_pos", np.maximum(x[:, 0], 0.0))[:, None]
    xn = iv("x1_neg", np.maximum(-x[:, 0], 0.0))[:, None]
    h = xp * WXP + xn * WXN
    for t in range(2, 9):
        u = x[:, t-1:t] * WX + h @ WH
        h = iv("h%d" % t, np.maximum(u, 0.0))
    return h @ WO

