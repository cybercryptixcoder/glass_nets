def runF(x,Wxx,Whh,Woo):
    x=np.atleast_2d(np.asarray(x,dtype=float)); h=np.zeros((x.shape[0],8))
    for t in range(8): h=np.maximum(x[:,t:t+1]*Wxx+h@Whh,0.0)
    return h@Woo
