A = acts(X)
def jac(site, xs, eps=1e-4):
    B = len(xs); base = acts(xs)[site]; out = np.zeros((B,5,8))
    for c in range(5):
        d = np.zeros_like(xs); d[:,c] = eps
        out[:,c,:] = (acts(xs+d)[site]-base)/eps
    return out
