import numpy as np

DESCRIPTION = ("Exact re-implementation of the RNN. What the network does: it reads five numbers and the largest "
               "output score is (87.9% of the time) the position of the SECOND largest of the five inputs, i.e. it "
               "is an approximate 'where is the runner-up' detector; its errors are concentrated where the 2nd and "
               "3rd largest are close. Step 1 is fully explained: h1 = relu(x1)*a+ + relu(-x1)*a- so the state after "
               "step 1 carries only two numbers (positive and negative part of x1). Steps 2-5 are still the raw "
               "recurrence, which is what remains to be compressed.")

WX = np.array([0.6426, -6.4213, 0.4235, -6.5737, 0.0451, -4.9132, -0.0541, 7.0017])
WH = np.array([
[ 0.125, 0.155, 0.476, 0.061, 0.771, 0.036, 0.944,-0.163],
[-0.465,-0.236, 0.272, 0.493, 0.169,-0.732, 0.424,-0.027],
[ 0.02,-0.129,-0.107,-0.19,-0.618,-0.424, 0.24, 0.082],
[ 0.528,-0.3,-0.363,-0.847, 0.279, 0.57, 0.199, 0.061],
[-0.177,-0.324, 0.216,-0.252,-0.747,-0.192,-1.207, 0.38],
[ 0.881, 0.6, 0.126, 0.348, 0.127, 0.07,-0.75, 0.024],
[ 0.127, 0.962,-0.086, 0.973, 0.546, 0.68, 0.787,-0.89],
[-1.656,-0.017, 1.419, 1.088, 0.156, 0.815, 1.102,-0.828]])
WO = np.array([
[ 0.716,-1.137, 0.68,-1.948, 0.727],
[ 0.336,-0.716,-3.905, 3.885,-0.239],
[ 0.849,-0.069,-3.387, 0.567, 0.633],
[ 0.36,-2.426, 4.804,-2.857,-0.673],
[-0.403, 2.16,-0.467,-0.468,-0.377],
