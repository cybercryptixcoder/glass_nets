[-0.003834,0.074910,0.083627,0.073568],[0.542813,0.965995,0.812952,-17.454250]])
def rung(X,Gm,WOt=WOs):
    h = np.maximum(X[:,0:1]*SGN,0); Hs=[h]
    for t in range(1,5):
        h = np.maximum(X[:,t:t+1]*SGN + h@Gm,0); Hs.append(h)
    return Hs, np.concatenate([np.zeros((X.shape[0],1)),h@WOt],1)
Hs,o = rung(X,G); dh=o.argmax(1)
A_all = np.vstack(Hs[:-1]); Y_all = A_all@G
print("A scale", np.abs(A_all).max(), " Y scale", np.abs(Y_all).max())

def als(rank, iters=60, w=None):
    U,S,Vt=np.linalg.svd(G); P=(U[:,:rank]*S[None,:rank]); Q=Vt[:rank]
    Aw = A_all if w is None else A_all*w[:,None]
    Yw = Y_all if w is None else Y_all*w[:,None]
    for it in range(iters):
        # Q fixed: solve for P  (Aw@P@Q ~ Yw)
        B = Aw@Q.T            # N x r
        Pn,_,_,_ = np.linalg.lstsq(B, Yw, rcond=None)   # r x 8
        P = Pn.T                                        # 8 x r
        C = Aw@P                                        # N x r
        Qn,_,_,_ = np.linalg.lstsq(C, Yw, rcond=None)    # r x 8
        Q = Qn
    return P@Q

for rank in [2,3,4,5]:
    Gr = als(rank)
    _,o2 = rung(X,Gr); print("rank",rank,"dec",(o2.argmax(1)==dh).mean().round(4),
      "reldriveerr", (np.linalg.norm(A_all@Gr-A_all@G)/np.linalg.norm(A_all@G)).round(4))

