Hlist = [A['h%d'%t] for t in range(1,5)]     # h1..h4 as drives for steps 2..5
Sig = sum(H.T@H for H in Hlist)/sum(len(H) for H in Hlist)
L = np.linalg.cholesky(Sig)
B = L.T@WH
Ub,Sb,Vtb = np.linalg.svd(B, full_matrices=False)
def rank_r_WH(r):
    Br = (Ub[:,:r]*Sb[:r])@Vtb[:r]
    M = np.linalg.solve(L.T, Br)      # since Br = L^T M
    return M
def fwdM(M, x):
    h = np.maximum(x[:,0:1]*WX[None,:],0)
    hs=[h]
    for t in range(1,5):
        h = np.maximum(x[:,t:t+1]*WX[None,:] + h@M, 0); hs.append(h)
    return h@WO, hs
