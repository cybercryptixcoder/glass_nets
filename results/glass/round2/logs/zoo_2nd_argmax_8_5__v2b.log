import numpy as np
WX = W['W_x'].ravel(); WH = W['W_h']; WO = W['W_o']
A = acts(X); ref = run(X); dec0 = ref.argmax(1)
Hs = [A['h%d'%t] for t in range(1,5)]
Hpool = np.vstack(Hs); Zpool = Hpool@WH
# greedy OMP per column of WH (drive matching)
def omp(H, z, k):
    n = H.shape[1]; S=[]; resid = z.copy(); Wcol=np.zeros(n)
    for _ in range(k):
        corr = H.T@resid
        cands = [i for i in range(n) if i not in S]
        i = max(cands, key=lambda i: abs(corr[i]))
        S.append(i)
        Wcol = np.zeros(n); Wcol[S] = np.linalg.lstsq(H[:,S], z, rcond=None)[0]
        resid = z - H[:,S]@Wcol[S]
    return Wcol, S
for k in [4,5,6,7,8]:
    Sp = np.zeros((8,8)); tot=0
    for j in range(8):
        Wcol,Sj = omp(Hpool, Zpool[:,j], k); Sp[:,j]=Wcol; tot+=len(Sj)
    err = np.sqrt(((Hpool@Sp - Zpool)**2).sum()/(Zpool**2).sum())
    # free-running
    h = np.maximum(X[:,0:1]*WX[None,:],0); hs=[h]
    for t in range(1,5):
        h = np.maximum(X[:,t:t+1]*WX[None,:] + h@Sp, 0); hs.append(h)
    o = h@WO
    sr2 = [round(1-((hs[t]-Hs[t])**2).sum()/((Hs[t]-Hs[t].mean(0))**2).sum(),4) for t in range(4)]
    print("k",k,"nnz",tot,"drive err",round(err,4),"dec",round((o.argmax(1)==dec0).mean(),4),"stateR2",sr2)

