def fwd(x, WHm, WOm, start=1, h0=None):
    h = np.maximum(x[:,0:1]*WXp,0) if h0 is None else h0
    for t in range(start,5):
        h=np.maximum(x[:,t:t+1]*WXp+h@WHm,0)
    return h@WOm

def evaluate(keep_w, keep_o, nswap=2000, seed=0):
    WHm=WHp*keep_w; WOm=WOp*keep_o
    o=fwd(X,WHm,WOm); dec=run(X).argmax(1)
    beh=(o.argmax(1)==dec).mean()
    rng=np.random.default_rng(seed)
    res={}
    for t in range(5):  # site h_{t+1}
        A=rng.integers(0,len(X),nswap); B=rng.integers(0,len(X),nswap)
        hA=H[t][A]; hB=H[t][B]
        # network: start from hB but with hA's state at site t (t=0 -> h1 uses pos/neg vars: skip)
        if t==0: continue
        netdec=fwd(X[B], WHp, WOp, start=t, h0=hA).argmax(1)
        mydec=fwd(X[B], WHm, WOm, start=t, h0=hA).argmax(1)
        res[t+1]=(netdec==mydec).mean()
    return beh, res

# note: for t=0 the variables are pos1/neg1 (2-dim); handle later
base_beh, base_res = evaluate(np.ones((8,8)), np.ones((8,5)))
print("exact: beh",round(float(base_beh),4), {k:round(float(v),4) for k,v in base_res.items()})

