a=acts(X)
def feats(prefix, n):
    P=X[:,:n]
    s=np.sort(P,1)
    o=np.argsort(-P,1)
    F=[s[:,::-1][:,k] for k in range(n)]+[P[:,k] for k in range(n)]
    for k in range(n): F.append((o[:,0]==k).astype(float))
    for k in range(n): F.append((o[:,1]==k).astype(float) if n>1 else np.zeros(len(P)))
    return np.array(F).T
for n in [2,3,4,5]:
    F=feats(X,n); F=np.hstack([F,np.ones((len(F),1))])
    H=a['h%d'%n]
    # add quadratic
    coef,res,rank,sv=np.linalg.lstsq(F,H,rcond=None)
    pred=F@coef
    r2=1-((H-pred)**2).sum()/((H-H.mean(0))**2).sum()
    print("h%d linear in prefix stats+order features R2"%n, round(float(r2),3))

