def model(x, iv):
    p = iv("pos1", np.maximum(x[:, 0], 0))
    n = iv("neg1", np.maximum(-x[:, 0], 0))
    h = p[:, None] * np.maximum(WX, 0) + n[:, None] * np.maximum(-WX, 0)
    for t in range(2, 6):
        h = iv("h%d" % t, np.maximum(x[:, t-1:t] * WX + h @ WH, 0))
    return h @ WO

