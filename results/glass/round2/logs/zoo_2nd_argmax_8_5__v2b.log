import numpy as np
# numerical jacobian of out wrt x at a few random points
def jac(xi, eps=1e-5):
    base = run(xi[None,:])[0]
    J = np.zeros((5,5))
    for t in range(5):
        xp = xi.copy(); xp[t]+=eps
        J[:,t] = (run(xp[None,:])[0]-base)/eps
    return J
for xi in X[:3]:
    print(xi.round(2)); print(jac(xi).round(2))

