import numpy as np

DESCRIPTION = ("Exact re-implementation, all five steps. What the network does: it reads five numbers and its argmax "
               "output is (87.9% of the time) the position of the SECOND largest input, so it is an approximate "
               "runner-up detector whose errors sit where the 2nd and 3rd largest are close. Step 1 is explained: "
               "h1 = relu(x1)*a+ + relu(-x1)*a-, two rays, so the state after one input carries only the positive and "
               "negative part of x1 (units 0,2,4,6 = +x1 side, units 1,3,5,6 = -x1 side). Steps 2-5 are the raw "
               "recurrence and still need compressing.")

WX = np.array([0.6426, -6.4213, 0.4235, -6.5737, 0.0451, -4.9132, -0.0541, 7.0017])
