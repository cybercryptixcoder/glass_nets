import numpy as np
np.set_printoptions(precision=5, suppress=True)
A = acts(X)
def coords(h):  # h0=p+r, h1=q+s, h2=q-s, h3=p-r
    p=(h[:,0]+h[:,3])/2; r=(h[:,0]-h[:,3])/2
    q=(h[:,1]+h[:,2])/2; s=(h[:,1]-h[:,2])/2
    return p,q,r,s
for st in ['h1','h2','h3']:
    p,q,r,s = coords(A[st])
    print(st, "mean p,q,|r|,|s|", p.mean(), q.mean(), np.abs(r).mean(), np.abs(s).mean())
    m = np.abs(r)>0.5
    print("   s/r quantiles", np.percentile(s[m]/r[m],[1,25,50,75,99]))
    nz = np.linalg.matrix_rank(np.c_[p,q,r,s],tol=0.01)
    print("   rank of [p,q,r,s]", nz, np.linalg.svd(np.c_[p,q,r,s],compute_uv=False))

