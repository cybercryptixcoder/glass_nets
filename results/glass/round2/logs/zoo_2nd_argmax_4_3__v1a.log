def dec_pq(h3):
    p=(h3[:,0]+h3[:,3])/2; q=(h3[:,1]+h3[:,2])/2
    return (p[:,None]*cp+q[:,None]*cq).argmax(1)
def dec_thr(h3, T1=1.1880, T0=0.7572):
    p=(h3[:,0]+h3[:,3])/2; q=(h3[:,1]+h3[:,2])/2
    u=q-T1*p; v=T0*p-q
    s=np.stack([-np.maximum(u,v),u,v],1)
    return s.argmax(1)
def fwd(Wxs,Whs):
    h=np.zeros((X.shape[0],4))
    for t in range(3): h=np.maximum(X[:,t:t+1]*Wxs+h@Whs,0)
    return h
A_,B_=3.965232,4.707904
print("thresholds better:", cq[1]/cp[1]*-1, cp[0]/cq[0])
Wxs={'exact':Wx,'2c':np.array([A_,B_,-B_,-A_])}
Whs={'exact':Wh}
# exact Wh in T basis reconstruct with rank1 couplings
for r1 in [0,1,2]:
    Cc = np.zeros_like(C); Cpc=np.zeros_like(Cp)
    for k in range(r1):
        u,s,vt=np.linalg.svd(C); Cc = s[0]*np.outer(u[:,0],vt[0])
        u,s,vt=np.linalg.svd(Cp); Cpc = s[0]*np.outer(u[:,0],vt[0])
        break
    blk=np.zeros((4,4)); blk[:2,:2]=Ms; blk[2:,2:]=Ma; blk[:2,2:]=Cc; blk[2:,:2]=Cpc
    Whs['blocks_c%d'%r1]=T@blk@T.T/2
for wname,Wxs_ in Wxs.items():
    for hname,Whs_ in Whs.items():
        h3=fwd(Wxs_,Whs_)
        for dname,f in [('pq',dec_pq),('thr',dec_thr)]:
            d=f(h3)
            print(wname,hname,dname,"behav %.4f"%((d==yn).mean()),"mistakes %.2f"%((d[mist]==yn[mist]).mean()))

