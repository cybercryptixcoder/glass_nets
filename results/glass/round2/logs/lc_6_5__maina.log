def fwd2(x, hard=False, A0m=None, A1m=None, B0m=None, B1m=None, drop_e4=False):
    e = emb(x)
    A0l = A0 if A0m is None else A0m; B0l= B0 if B0m is None else B0m
    A1l = A1 if A1m is None else A1m; B1l= B1 if B1m is None else B1m
    s0=(e@A0l)@e.transpose(0,2,1)/np.sqrt(6)
    if hard:
        P0=np.zeros_like(s0); P0[np.arange(len(x))[:,None],np.arange(5)[None,:],s0.argmax(2)]=1
    else:
        P0=np.exp(s0-s0.max(2,keepdims=True)); P0/=P0.sum(2,keepdims=True)
    r0=e+P0@(e@B0l)
    s1=(r0@A1l)@r0.transpose(0,2,1)/np.sqrt(6)
    if hard:
        P1=np.zeros_like(s1); P1[np.arange(len(x))[:,None],np.arange(5)[None,:],s1.argmax(2)]=1
    else:
        P1=np.exp(s1-s1.max(2,keepdims=True)); P1/=P1.sum(2,keepdims=True)
    r1=r0+P1@(r0@B1l)
    return r1[:,-1]@W['W_U']
base=fwd2(X); print("base ok", (base.argmax(1)==run(X).argmax(1)).mean())
