# probe: ablate attn0.out at each position (partially: set that position's block to embed only) via residual edit
# We can't hook, so emulate: recompute with modifications using our own forward pass (we know all weights)
def fwd(x, mod=None):
    e = emb(x)
    q0=e@W['L0.W_Q'][0]; k0=e@W['L0.W_K'][0]; v0=e@W['L0.W_V'][0]@W['L0.W_O'][0]
    S=q0@k0.transpose(0,2,1)/np.sqrt(6)
    P=np.exp(S-S.max(2,keepdims=True)); P/=P.sum(2,keepdims=True)
    r0 = e + P@v0
    if mod: r0 = mod(r0)
    q1=r0@W['L1.W_Q'][0]; k1=r0@W['L1.W_K'][0]; v1=r0@W['L1.W_V'][0]@W['L1.W_O'][0]
    S1=q1@k1.transpose(0,2,1)/np.sqrt(6)
    P1=np.exp(S1-S1.max(2,keepdims=True)); P1/=P1.sum(2,keepdims=True)
    r1 = r0 + P1@v1
    return r1[:,-1]@W['W_U']
print("check fwd==run:", np.abs(fwd(X[:50])-run(X[:50])).max())
