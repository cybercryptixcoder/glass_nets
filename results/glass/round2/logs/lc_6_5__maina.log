def emb(x):
    return W['W_E'][x] + W['W_pos'][None,:,:]
def scores(x,l):
    e = emb(x)
    q = e @ W['L%d.W_Q'%l][0]; k = e @ W['L%d.W_K'%l][0]
    return q @ k.transpose(0,2,1)/np.sqrt(6), q, k
S0,_,_ = scores(X[:400],0)
# check dependence of score[p,q] on only (x[p],x[q])
for p in range(5):
    for q in range(5):
        key={}; ok=True
        for i in range(len(X)):
            kk=(X[i,p],X[i,q])
            v=S0[i,p,q]
            if kk in key:
                if abs(key[kk]-v)>1e-6: ok=False;break
            else: key[kk]=v
        print(p,q,ok, end=" | ")
    print()

