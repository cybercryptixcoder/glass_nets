import itertools
def lookup_acc(cols):
    key = {}
    correct=0; tot=0
    # majority vote per key
    from collections import defaultdict
    tab=defaultdict(lambda: np.zeros(5))
    for i in range(len(X)):
        tab[tuple(X[i,c] for c in cols)][d[i]]+=1
    for i in range(len(X)):
        k=tuple(X[i,c] for c in cols)
        correct += (tab[k].argmax()==d[i])
    return correct/len(X)
