import numpy as np
SQ = 1.0/np.sqrt(6.0)

DESCRIPTION = ("Exact re-implementation (diagnostic) of the 2-layer attention-only transformer, written with the "
               "products that matter: A=W_Q W_K^T (score map) and B=W_V W_O (value-output map) for each layer, so "
               "only 4 six-by-six maps plus W_E, W_pos, W_U are needed. Variables: the five one-hot token indicators "
               "at the embed site; the per-position residual vectors after layer 0 (resid0.mid) and after layer 1 "
               "(resid1.mid). Each layer is a softmax over key positions of e_p A e_q / sqrt(6), adding the weighted "
               "value-output map of the key residuals; the output is the last residual through W_U.")

