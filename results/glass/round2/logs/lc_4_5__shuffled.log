import numpy as np
o=run(X); dec=o.argmax(1); N=len(X)
def onehot(rows): return np.eye(5)[rows]
F1=np.concatenate([onehot(X[:,j]) for j in range(5)],1)
pairs=[(i,j) for i in range(5) for j in range(i+1,5)]
F2=np.stack([(X[:,i]==X[:,j]).astype(float) for (i,j) in pairs],1)
def fit(F,y):
    A=np.hstack([F,np.ones((len(F),1))]); c,_,_,_=np.linalg.lstsq(A,y,rcond=None); return A@c
for nm,F in [('additive',F1),('add+eq',np.hstack([F1,F2]))]:
    pred=fit(F,o)
    print(nm,'logit R2',(1-((o-pred)**2).mean(0)/o.var(0)).round(3), 'acc', (pred.argmax(1)==dec).mean().round(4))
# how much does decision depend on which positions? marginal test: shuffle
rng=np.random.default_rng(0)
for j in range(5):
    Y=X.copy(); Y[:,j]=rng.permutation(Y[:,j])
    print('shuffle pos',j,'dec agree', (run(Y).argmax(1)==dec).mean().round(3))

