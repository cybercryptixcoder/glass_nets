import numpy as np
from sklearn.linear_model import RidgeCV, LogisticRegression
o=run(X); dec=o.argmax(1)
N=len(X)
def onehot(rows): return np.eye(5)[rows]
F1=np.concatenate([onehot(X[:,j]) for j in range(5)],1)  # 25
# pairwise equality features
pairs=[(i,j) for i in range(5) for j in range(i+1,5)]
F2=np.stack([(X[:,i]==X[:,j]).astype(float) for (i,j) in pairs],1)
for nm,F in [('additive',F1),('add+eq',np.hstack([F1,F2]))]:
    r=RidgeCV(alphas=[.01,.1,1,10]).fit(F,o)
    pred=r.predict(F)
    print(nm,'logit R2',1-((o-pred)**2).mean(0).mean()/o.var(0).mean(), 'acc', (pred.argmax(1)==dec).mean().round(4))

