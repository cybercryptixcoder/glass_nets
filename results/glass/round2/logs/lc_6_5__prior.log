import itertools, numpy as np
funcs=list(itertools.product(range(5), repeat=5))
def comp(f,g): return tuple(f[g[i]] for i in range(5))
def powf(f,k):
    r=tuple(range(5))
    for _ in range(k): r=comp(f,r)
    return r
def maxcycle(f):
    best=0
    for s in range(5):
        x=s
        for t in range(1,6):
            x=f[x]
            if x==s:
                best=max(best,t); break
    return best
Y=[maxcycle(f) for f in funcs]
print(len(funcs), np.bincount(Y))
# features
for k in range(1,6):
    print(k, len(set((tuple(powf(f,j) for j in range(1,k+1)) for f in funcs))))
# See if (f1,f2,f3) determines Y
keys={}
for f,y in zip(funcs,Y):
    key=tuple(powf(f,j) for j in range(1,4))
    keys.setdefault(key,set()).add(y)
print('f1f2f3 ambiguous', sum(len(v)>1 for v in keys.values()))
# check pairwise combos
for ks in [(1,2),(1,3),(2,3),(1,4),(2,4),(3,4),(1,5),(2,5),(3,5),(4,5),(1,2,3),(1,2,4),(1,3,4),(2,3,4)]:
    d={}
    for f,y in zip(funcs,Y):
        key=tuple(powf(f,j) for j in ks)
        d.setdefault(key,set()).add(y)
    print(ks, 'ambig',sum(len(v)>1 for v in d.values()))

