import itertools, numpy as np
funcs=list(itertools.product(range(5), repeat=5))
def maxcycle(f):
    best=0
    for s in range(5):
        x=s
        for t in range(1,6):
            x=f[x]
            if x==s: best=max(best,t); break
    return best
Y=np.array([maxcycle(f) for f in funcs])
C=[]
for f in funcs:
    f2=[f[f[i]] for i in range(5)]
    c=np.zeros(25)
    for i in range(5): c[f[i]*5+f2[i]]+=1
    C.append(c)
C=np.array(C)
# add bias
D=np.c_[np.ones(len(C)),C]
# one-hot
T=np.eye(5)[Y]
# train softmax regression by gradient descent
W=np.zeros((D.shape[1],5))
for it in range(20000):
    Z=D@W; Z-=Z.max(1,keepdims=True); P=np.exp(Z); P/=P.sum(1,keepdims=True)
    G=D.T@(P-T)/len(D)
    W-=0.5*G
pred=P.argmax(1)
print('logreg acc', (pred==Y).mean())
# linear least squares to one-hot
W2=np.linalg.lstsq(D,T,rcond=None)[0]
pred2=(D@W2).argmax(1)
print('lsq acc', (pred2==Y).mean())
# check if any linear score for each class separable one vs rest via fast perceptron
for c in range(5):
    y=(Y==c)*2-1
    w=np.zeros(D.shape[1])
    for it in range(10000):
        m=y*(D@w)
        idx=np.where(m<=0)[0]
        if len(idx)==0: break
        i=idx[np.random.randint(len(idx))] if False else idx[0]
        w+=y[i]*D[i]
    print(c, (np.sign(D@w)==y).mean())

