def classify(f):
    F=np.array(f)
    G=np.array([f[f[i]] for i in range(5)])
    H=np.array([f[f[f[f[i]]]] for i in range(5)])
    Ls=[]
    for s in range(5):
        fs=F[s]; gs=G[s]; hs=H[s]; fh=F[int(hs)]
        if fs==s: L=1
        elif gs==s: L=2
        elif hs==s: L=4
        elif fh==s: L=5
        elif hs==fs: L=3
        else: L=0
        Ls.append(L)
    return max(Ls)-1
