        x=s
        for t in range(1,6):
            x=f[x]
            if x==s: best=max(best,t); break
    return best-1
def classify(f):
    F=np.array(f)
    G=np.array([f[f[i]] for i in range(5)])
    H=np.array([f[f[f[f[i]]]] for i in range(5)])
    Fs=[F,G,np.array([F[G[i]] for i in range(5)]),H,np.array([F[H[i]] for i in range(5)])]
    best=0
