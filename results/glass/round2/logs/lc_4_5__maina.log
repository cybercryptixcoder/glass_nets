import numpy as np

DESCRIPTION = ("Two attention steps over the residual stream, written with the QK and OV products only (the residual basis "
  "is a gauge freedom, so Q,K,V,O need not be written separately). embed = token+position embedding (the position "
  "embedding is shifted so that position 0's vector is zero and carried in the token table: same embeddings, 4 fewer "
  "numbers). Layer-0 attention scores embeddings with QK0 (logits of order 100, so its softmax is essentially a hard "
  "pointer) and adds OV0 applied to the attended embedding. Layer-1 attention scores residuals with QK1 (nearly rank 1) "
  "and adds OV1 applied to the attended residual. The last position's residual is unembedded into 5 class scores.")

