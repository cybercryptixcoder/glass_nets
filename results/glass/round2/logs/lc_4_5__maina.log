import numpy as np

DESCRIPTION = ("Diagnostic exact re-implementation of the 2-layer attention-only transformer, "
  "written with measured weights, so that every stage can be verified before compression. "
  "embed = token+position embedding; layer0 attention (softmax over keys, no mask) writes an OV term; "
  "layer1 attention (rank-deficient QK) writes another OV term; the last position's residual is unembedded.")

WE = np.array([[-0.5547,-2.026,1.4238,0.301],[1.0222,-1.0874,0.6785,1.8459],
               [0.9991,-0.2001,1.1441,1.3961],[1.7693,1.8963,1.0939,-0.5216],
               [-0.6405,-0.0166,2.8816,-0.0738]])
