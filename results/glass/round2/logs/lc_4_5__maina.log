def r2feat(cols):
    F = np.zeros((len(X), len(cols)*5))
    for k,c in enumerate(cols):
        F[np.arange(len(X)), k*5+X[:,c]] = 1
    F = np.hstack([F, np.ones((len(X),1))])
    coef,res,rank,sv = np.linalg.lstsq(F,out,rcond=None)
    pred = F@coef
    return 1-((out-pred)**2).sum()/ ((out-out.mean(0))**2).sum()
