               [-1.5712,-1.1513,0.1696,2.6083]])
WU = np.array([[0.1397,-0.1018,-0.0272,-0.0296,-0.1579],[-0.0436,0.1143,0.1122,-0.1387,-0.3954],
               [0.6891,-0.418,0.1983,-0.5265,-1.4645],[-0.3152,-0.363,0.6068,0.3611,0.006]])
Q0 = np.array([[3.2001,1.6683,3.0831,2.6743],[-1.2368,2.8073,1.143,5.1298],
               [-2.6694,-2.0003,1.021,-0.4435],[0.9867,-0.6436,-2.109,-1.8283]])
K0 = np.array([[0.3338,-1.7759,-2.7886,-2.3371],[-1.7169,0.0349,1.7594,1.2848],
               [-2.2896,-3.2117,-0.5018,-2.6883],[-4.6616,0.3198,-0.7943,0.5497]])
V0 = np.array([[0.5573,0.0069,-0.9117,0.2999],[-0.1229,-0.1595,-0.5697,-0.3257],
               [0.8621,-0.0513,0.3206,-0.3577],[0.0109,-0.0025,-0.7993,-0.8032]])
O0 = np.array([[0.2002,1.0833,-0.3118,-0.7092],[-0.0439,-0.1009,-0.058,0.0292],
               [-1.4468,-0.6819,0.3432,-1.0248],[0.8705,-0.9573,-0.0243,-0.2886]])
Q1 = np.array([[-0.6085,-0.2795,-0.543,0.0627],[-0.0924,-0.2877,-0.1484,-0.1071],
               [0.4436,-2.3097,-3.5781,0.6081],[0.4666,-0.5981,-0.172,0.2837]])
K1 = np.array([[0.1338,0.4798,0.1351,-0.0392],[-0.2893,0.799,0.925,0.0082],
               [0.6468,-0.7584,-1.1471,0.3823],[0.1642,-0.8974,-1.9585,0.2631]])
V1 = np.array([[-1.4634,-1.3115,-0.4038,0.0581],[0.5144,-0.3847,-2.1988,-0.1269],
               [-2.5183,0.0285,-1.5646,1.1705],[0.3044,2.0461,0.6024,-0.342]])
O1 = np.array([[0.6729,-5.5002,0.7471,1.5071],[-0.0863,-2.5255,1.4241,-1.561],
               [-0.8041,-0.2032,0.1339,-0.0074],[0.2319,1.658,0.0931,-0.093]])

def _softmax(L):
    L = L - L.max(axis=2, keepdims=True)
    A = np.exp(L)
    return A / A.sum(axis=2, keepdims=True)

def model(x, iv):
    B = x.shape[0]
    emb = WP[None] + WE[x]
    e = iv("emb", emb.reshape(B, 20))
    emb = e.reshape(B, 5, 4)
    A0 = _softmax((emb @ Q0) @ (emb @ K0).transpose(0, 2, 1) / 2.0)
    p0 = iv("pat0", A0.reshape(B, 25))
    a0 = (p0.reshape(B, 5, 5) @ (emb @ V0)) @ O0
    o0 = iv("aout0", a0.reshape(B, 20))
    r0 = iv("res0", e + o0)
    h = r0.reshape(B, 5, 4)
    A1 = _softmax((h @ Q1) @ (h @ K1).transpose(0, 2, 1) / 2.0)
    p1 = iv("pat1", A1.reshape(B, 25))
    a1 = (p1.reshape(B, 5, 5) @ (h @ V1)) @ O1
    o1 = iv("aout1", a1.reshape(B, 20))
    r1 = iv("res1", r0 + o1)
    return r1.reshape(B, 5, 4)[:, -1, :] @ WU

ALIGN = {"emb": ["embed"], "pat0": ["attn0.pattern"], "aout0": ["attn0.out"],
