def fwd(WE,WP,WU,QK0,QK1,OV0,OV1,x=X):
    e = WE[x]+WP[None]
    A0 = np.exp(0.5*(e@QK0)@e.transpose(0,2,1)); A0/=A0.sum(-1,keepdims=True)
    h = e + A0@e@OV0
    A1 = np.exp(0.5*(h@QK1)@h.transpose(0,2,1)); A1/=A1.sum(-1,keepdims=True)
    r1 = h + A1@h@OV1
    return r1[:,-1,:]@WU, A0, A1
ref = run(X); refp = ref.argmax(1)
def trunc(M,k):
    U,s,Vt = np.linalg.svd(M)
    return (U[:,:k]*s[:k])@Vt[:k]
def acc(**kw):
    a = fwd(WE,WP,WU,QK0 if 'QK0' not in kw else kw['QK0'], QK1 if 'QK1' not in kw else kw['QK1'],
            OV0 if 'OV0' not in kw else kw['OV0'], OV1 if 'OV1' not in kw else kw['OV1'])[0]
    return (a.argmax(1)==refp).mean()
print('base',acc())
for nm,M in [('QK0',QK0),('QK1',QK1),('OV0',OV0),('OV1',OV1)]:
    for k in [1,2,3]:
        print(nm,'rank',k,'acc %.4f'%acc(**{nm:trunc(M,k)}))
for k in [1,2,3]:
    print('WU rank',k,'acc %.4f'%acc(WU=trunc(WU,k)))

