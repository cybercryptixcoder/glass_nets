QK0 = W['L0.W_Q'][0]@W['L0.W_K'][0].T
QK1 = W['L1.W_Q'][0]@W['L1.W_K'][0].T
OV0 = W['L0.W_V'][0]@W['L0.W_O'][0]
OV1 = W['L1.W_V'][0]@W['L1.W_O'][0]
WE=W['W_E']; WP=W['W_pos']; WU=W['W_U']
pred_ref = run(X).argmax(1)
def fwd(seq, QK0x=QK0, QK1x=QK1, OV0x=OV0, OV1x=OV1, WEx=WE, WPx=WP, WUx=WU, ret=False):
    e = WEx[seq]+WPx
    L0 = (e@QK0x)@e.transpose(0,2,1)/2
    A0 = np.exp(L0-L0.max(2,keepdims=True)); A0/=A0.sum(2,keepdims=True)
    a0 = (A0@e)@OV0x
    h = e + a0
    L1 = (h@QK1x)@h.transpose(0,2,1)/2
    A1 = np.exp(L1-L1.max(2,keepdims=True)); A1/=A1.sum(2,keepdims=True)
    a1 = (A1@h)@OV1x
    r1 = h + a1
    out = r1[:,-1,:]@WUx
    if ret: return out, A0, A1, a0, a1
    return out
out = fwd(X)
print("exact product fwd acc:", (out.argmax(1)==pred_ref).mean(), "R2", 1-((out-run(X))**2).sum()/((run(X)-run(X).mean(0))**2).sum())
def trunc(M,k):
    u,s,vt=np.linalg.svd(M); return (u[:,:k]*s[:k])@vt[:k]
for k in [1,2,3]:
    o=fwd(X,QK0x=trunc(QK0,k)); print("QK0 rank",k,"acc", (o.argmax(1)==pred_ref).mean())
for k in [1,2,3]:
