import numpy as np
Wx=W['W_x'][0]; Wh=W['W_h']; Wo=W['W_o']
print("Wx",Wx,"Wh\n",Wh,"Wo\n",Wo)
def net_dec(x1,x2):
    p=max(x1,0); n=max(-x1,0)
    h0=max(Wx[0]*x2+Wx[0]*Wh[0,0]*p+(-Wx[1]*Wh[1,0])*n,0)
    h1=max(Wx[1]*x2+Wx[0]*Wh[0,1]*p+(-Wx[1]*Wh[1,1])*n,0)
    s=(Wo[0,0]-Wo[0,1])*h0+(Wo[1,0]-Wo[1,1])*h1
    return 0 if s>0 else 1, s
# angular scan
th=np.linspace(0,2*np.pi,721)
r=1.0
dec=np.array([net_dec(r*np.cos(t),r*np.sin(t))[0] for t in th])
# print transitions
ch=np.where(np.diff(dec)!=0)[0]
print("transitions at angles(deg):",np.round(np.degrees(th[ch+1]),2), "dec there",dec[ch+1])
# center of class1 region
print("dec at angles 100,110,120,130 deg:",[net_dec(np.cos(np.radians(a)),np.sin(np.radians(a)))[0] for a in [100,110,120,130,140,150]])

