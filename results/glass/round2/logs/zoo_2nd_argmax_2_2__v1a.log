def net(x1,x2,verbose=False):
    p=max(x1,0); n=max(-x1,0)
    pre0=Wx[0]*x2+Wx[0]*Wh[0,0]*p+(-Wx[1]*Wh[1,0])*n
    pre1=Wx[1]*x2+Wx[0]*Wh[0,1]*p+(-Wx[1]*Wh[1,1])*n
    h0,h1=max(pre0,0),max(pre1,0)
    s=(Wo[0,0]-Wo[0,1])*h0+(Wo[1,0]-Wo[1,1])*h1
    if verbose: print("pre",pre0,pre1,"h",h0,h1,"s",s)
    return 0 if s>0 else 1
