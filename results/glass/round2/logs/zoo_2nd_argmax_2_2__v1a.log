a=Wx[0]; b=abs(Wx[1])
c=(Wo[0,0]-Wo[0,1])*a; d=-(Wo[1,0]-Wo[1,1])*b
r=-c/d  # score = c*w0 + d*w1 = c*(w0 - r*w1) with d<0
print("c,d,r",c,d,r)
ex_c0=0.38212356; ex_cn=2.08516624; ex_d0=1.14152943; ex_dn=0.75152266
