def evalc(c0,cn,d0,dn):
    w0=np.maximum(x2-c0*p+cn*n,0); w1=np.maximum(-x2+d0*p-dn*n,0)
    h=acts(X)['h2']
    R2_0=1-((h[:,0]-a*w0)**2).sum()/((h[:,0]-h[:,0].mean())**2).sum()
    R2_1=1-((h[:,1]-b*w1)**2).sum()/((h[:,1]-h[:,1].mean())**2).sum()
    s=w0-r*w1
    o=run(X); dec=np.argmax(o,axis=1)
    agree=((s>0).astype(int)==dec).mean()
    return R2_0,R2_1,agree,((x2<x1).astype(int)==dec).mean()
