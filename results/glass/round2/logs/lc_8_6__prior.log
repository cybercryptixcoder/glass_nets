    vals=[]
    for k in [1,2]:
        cnt=np.zeros(6)
        for i in range(6): cnt[ip(f,i,k)]+=1
        vals.extend(cnt)
    # counts of (f(i), f2(i)) diagonals? maybe f(i)-f2(i) mod6 histogram
