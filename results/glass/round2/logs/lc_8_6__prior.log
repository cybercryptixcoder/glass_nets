import itertools, collections
n=6
def maxcycle(f):
    best=0
    for i in range(n):
        seen={}; cur=i; t=0
        while cur not in seen:
            seen[cur]=t; cur=f[cur]; t+=1
        best=max(best,t-seen[cur])
    return best
def ip(f,i,k):
    for _ in range(k): i=f[i]
    return i
for Ks in [(1,2,4),(1,2,3,4),(1,2,4,5),(1,2,3,4,5),(1,2,4,5,6)]:
