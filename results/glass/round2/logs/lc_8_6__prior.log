        seen={}; cur=i; t=0
        while cur not in seen:
            seen[cur]=t; cur=f[cur]; t+=1
        best=max(best,t-seen[cur])
    return best
def ip(f,i,k):
    for _ in range(k): i=f[i]
    return i
# features histogram pairs (f(i),f2(i))
