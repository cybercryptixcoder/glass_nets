import itertools, collections
n=6
def cycles(f):
    # f tuple length n
    seen_global=[False]*n
    maxlen=0
    allinfo=[]
    for i in range(n):
        seen={}
        cur=i; t=0
        while cur not in seen:
            seen[cur]=t; cur=f[cur]; t+=1
        L=t-seen[cur]
        maxlen=max(maxlen,L)
        allinfo.append(L)
    return maxlen
def ck(f,k):
    return sum(1 for i in range(n) if (lambda: None)() is None and iter_pow(f,i,k)==i)
def iter_pow(f,i,k):
    for _ in range(k): i=f[i]
    return i
mapping=collections.defaultdict(set)
for f in itertools.product(range(n), repeat=n):
    key=(ck(f,1),ck(f,2),ck(f,3))
    mapping[key].add(cycles(f))
amb=[(k,v) for k,v in mapping.items() if len(v)>1]
print(len(mapping), len(amb))
print(amb[:20])
# also include c4
mapping2=collections.defaultdict(set)
for f in itertools.product(range(n), repeat=n):
    key=(ck(f,1),ck(f,2),ck(f,3),ck(f,4))
    mapping2[key].add(cycles(f))
amb2=[(k,v) for k,v in mapping2.items() if len(v)>1]
print(len(mapping2), len(amb2), amb2[:10])
# c5, c6
for K in [5,6]:
    m=collections.defaultdict(set)
    for f in itertools.product(range(n), repeat=n):
        key=tuple(ck(f,k) for k in range(1,K+1))
        m[key].add(cycles(f))
    amb3=[(k,v) for k,v in m.items() if len(v)>1]
    print(K, len(m), len(amb3), amb3[:5])
