import itertools, numpy as np
n=6
funcs=list(itertools.product(range(n), repeat=n))
def maxcycle(f):
    best=0
    for i in range(n):
        seen={}; cur=i; t=0
        while cur not in seen:
            seen[cur]=t; cur=f[cur]; t+=1
        best=max(best,t-seen[cur])
    return best
def ip(f,i,k):
    for _ in range(k): i=f[i]
    return i
# features: counts of pairs (f(i),f2(i)) 36, plus maybe f value counts, f2 value counts
X=np.zeros((len(funcs),36))
Y=np.zeros((len(funcs),6))
for idx,f in enumerate(funcs):
    for i in range(n):
        a=f[i]; b=ip(f,i,2)
        X[idx,a*6+b]+=1
    Y[idx,maxcycle(f)-1]=1
# add intercept
X1=np.concatenate([X,np.ones((len(X),1))],axis=1)
# least squares fit
W,res,rank,sv=np.linalg.lstsq(X1,Y,rcond=None)
pred=np.argmax(X1@W,axis=1)
acc=(pred==np.argmax(Y,axis=1)).mean()
print('pairhist linear',acc,'rank',rank)
# Try only f2 value counts (6) and f value counts (6)
X2=np.zeros((len(funcs),12))
for idx,f in enumerate(funcs):
    for i in range(n):
        X2[idx,f[i]]+=1
        X2[idx,6+ip(f,i,2)]+=1
X2=np.concatenate([X2,np.ones((len(X2),1))],axis=1)
W2=np.linalg.lstsq(X2,Y,rcond=None)[0]
print('value counts linear', (np.argmax(X2@W2,axis=1)==np.argmax(Y,axis=1)).mean())
# Try moments of pairs: sum f, sum f2, sum f^2, sum f2^2, sum f*f2, etc.
X3=[]
for f in funcs:
    vals=[]
    for k in [1,2]:
        arr=[ip(f,i,k) for i in range(n)]
        vals += [sum(arr), sum(x*x for x in arr), sum((x+1)**2 for x in arr)]
    vals += [sum(f[i]*ip(f,i,2) for i in range(n))]
    X3.append(vals)
X3=np.concatenate([np.array(X3),np.ones((len(funcs),1))],axis=1)
W3=np.linalg.lstsq(X3,Y,rcond=None)[0]
print('moments linear', (np.argmax(X3@W3,axis=1)==np.argmax(Y,axis=1)).mean())
# Print class distribution and maybe confusion
print(np.bincount(np.argmax(Y,axis=1)))
