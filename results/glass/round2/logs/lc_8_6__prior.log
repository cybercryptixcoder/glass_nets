import itertools, collections
n=6
def maxcycle(f):
    best=0
    for i in range(n):
        seen={}; cur=i; t=0
        while cur not in seen:
            seen[cur]=t; cur=f[cur]; t+=1
        best=max(best,t-seen[cur])
    return best
def ip(f,i,k):
    for _ in range(k): i=f[i]
    return i
# multiset of tuples of iterates up to K, sorted
for K in [2,3,4]:
    m=collections.defaultdict(set)
    for f in itertools.product(range(n), repeat=n):
        mult=tuple(sorted(tuple(ip(f,i,k) for k in range(1,K+1)) for i in range(n)))
        m[mult].add(maxcycle(f))
    amb=[(k,v) for k,v in m.items() if len(v)>1]
    print('K',K,'groups',len(m),'amb',len(amb),'examples',amb[:3])
# add labeled positions? trivially determines f if K=1 includes i? multiset of (i, f(i), f2...)
for K in [1,2,3]:
    m=collections.defaultdict(set)
    for f in itertools.product(range(n), repeat=n):
        mult=tuple(sorted((i,)+tuple(ip(f,i,k) for k in range(1,K+1)) for i in range(n)))
        m[mult].add(maxcycle(f))
    amb=[(k,v) for k,v in m.items() if len(v)>1]
