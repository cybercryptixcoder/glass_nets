import numpy as np
o=run(X)
n=len(X)
oh = np.zeros((n,6,6))
for p in range(6): oh[:,p,:] = (X[:,p][:,None]==np.arange(6))
def r2(F,Y):
    F1 = np.concatenate([F,np.ones((len(F),1))],1)
    coef,*_=np.linalg.lstsq(F1,Y,rcond=None)
    P=F1@coef
    return 1-((Y-P)**2).sum(0)/((Y-Y.mean(0))**2).sum(0)
lin = oh.reshape(n,36)
print("linear pos R2", r2(lin,o).round(3))
# quadratic
F=[lin]
for p in range(6):
    for q in range(p+1,6):
        F.append((oh[:,p,:,None]*oh[:,q,None,:]).reshape(n,36))
Fq=np.concatenate(F,1)
print("quad feats", Fq.shape)
print("pairwise R2", r2(Fq,o).round(3))

