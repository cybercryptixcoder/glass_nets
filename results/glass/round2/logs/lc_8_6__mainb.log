--- python ---

import numpy as np
pred = run(X).argmax(1)
n=len(X)
def t(x,i): return x[:,i]
rules={}
rules['after_last_occ_last'] = np.array([ (r[list(r).index(r[5])+1] if list(r).index(r[5])+1<6 else r[0]) for r in X])
rules['after_first_occ_last'] = np.array([r[i+1] if i+1<6 else r[0] for r in X for i in [list(r).index(r[5])]])
rules['after_last_occ_first'] = np.array([ (lambda r: r[list(r)[::-1].index(r[5]) and len(r)-1-list(r)[::-1].index(r[5])+1] if (len(r)-1-list(r)[::-1].index(r[5])+1)<6 else r[0])(r) for r in X])
rules['pos_of_x5'] = np.array([list(r).index(r[5]) for r in X])
rules['count_lt_last'] = np.array([(r<r[5]).sum() for r in X])
rules['count_gt_last'] = np.array([(r>r[5]).sum() for r in X])
rules['count_lt_first'] = np.array([(r<r[0]).sum() for r in X])
rules['count_gt_first'] = np.array([(r>r[0]).sum() for r in X])
rules['cnt_last'] = np.array([(r==r[5]).sum() for r in X])
rules['cnt_first'] = np.array([(r==r[0]).sum() for r in X])
rules['sum_mod6'] = X.sum(1)%6
rules['first_minus_last_mod6'] = (X[:,0]-X[:,5])%6
rules['first_plus_last_mod6'] = (X[:,0]+X[:,5])%6
rules['argmax'] = X.argmax(1); rules['argmin']=X.argmin(1)
rules['second_of_pair'] = np.array([ (lambda r: next((r[j+1] for j in range(5) if r[j]==r[j+1]), 0))(r) for r in X])
rules['num_results'] = {}
for k,v in rules.items():
    if isinstance(v,dict): continue
    print(k, (v==pred).mean().round(3))

