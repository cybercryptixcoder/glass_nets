import numpy as np
def r2(F,Y):
    F1 = np.concatenate([F, np.ones((len(F),1))],1)
    coef,*_ = np.linalg.lstsq(F1,Y,rcond=None)
    pred = F1@coef
    ss = 1 - ((Y-pred)**2).sum(0)/((Y-Y.mean(0))**2).sum(0)
    return ss, coef
cnt = np.array([np.bincount(r,minlength=6) for r in Xall],dtype=float)
