import numpy as np
pred = run(X).argmax(1)
def purity(cols):
    keys = X[:,cols[0]]*6+X[:,cols[1]] if len(cols)==2 else X[:,cols[0]]
    d={}
    for k,p in zip(keys,pred):
        d.setdefault(k,[]).append(p)
    return np.mean([np.bincount(v,minlength=6).max()/len(v) for v in d.values()])
print("singles", [round(purity([i]),3) for i in range(6)])
print("pairs", {(i,j):round(purity([i,j]),3) for i in range(6) for j in range(i+1,6)})

