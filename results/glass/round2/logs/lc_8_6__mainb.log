Xa = X[:300].copy()
base = run(Xa)
sens = np.zeros((6,6))
for p in range(6):
    for t in range(6):
        Xc = Xa.copy(); Xc[:,p]=t
        d = np.linalg.norm(run(Xc)-base,axis=1).mean()
        sens[p,t]=d
np.set_printoptions(precision=2,suppress=True)
print("sensitivity position x token\n", sens)
print("mean per pos", sens.mean(0), sens.mean(1))

