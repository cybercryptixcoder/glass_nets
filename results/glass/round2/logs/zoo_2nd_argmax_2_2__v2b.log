def variant(K,C1,C2,C3,C4,label):
    u=np.maximum(x2+C1*p+C2*n,0); w=np.maximum(-x2+C3*p+C4*n,0)
    s=u-K*w
    d=(s>0)
    # explained variance of affine fit
    def expl(v,act):
        A=np.c_[v,np.ones_like(v)]
        coef,res,_,_=np.linalg.lstsq(A,act,rcond=None)
        pred=A@coef
        return 1-((act-pred)**2).sum(0)/((act-act.mean(0))**2).sum(0)
    e1=expl(u,h2t[:,0]); e2=expl(w,h2t[:,1])
    print(label,"agree %.5f"%(np.mean(d==dec)),"expl",np.round(e1,4),np.round(e2,4))

