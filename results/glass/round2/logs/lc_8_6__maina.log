S = 2.8284271247461903

def model(x, iv):
    x = np.asarray(x).astype(int)
    B = x.shape[0]
    h = np.stack([iv("emb%d" % p, E[x[:, p]] + P[p]) for p in range(6)], 1)
    lg = np.einsum('bqd,de,bke->bqk', h, A0, h) / S
    lg = np.exp(lg - lg.max(-1, keepdims=True))
    a0 = iv("a0", (lg / lg.sum(-1, keepdims=True)).reshape(B, 36)).reshape(B, 6, 6)
    r0 = iv("r0", (h + np.einsum('bpk,bkd->bpd', a0, h @ VO0)).reshape(B, 48)).reshape(B, 6, 8)
    lg1 = np.einsum('bqd,de,bke->bqk', r0, A1, r0) / S
    lg1 = np.exp(lg1 - lg1.max(-1, keepdims=True))
    a1 = iv("a1", (lg1 / lg1.sum(-1, keepdims=True)).reshape(B, 36)).reshape(B, 6, 6)
    r1 = iv("r1", (r0 + np.einsum('bpk,bkd->bpd', a1, r0 @ VO1)).reshape(B, 48)).reshape(B, 6, 8)
    return r1[:, 5] @ U

