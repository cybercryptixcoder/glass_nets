def fwd(x, ret_full=False):
    x = np.asarray(x).astype(int)
    B = x.shape[0]
    h = T[x] + np.round(P)[:,None,:]   # B,6,8
    s0 = h @ A0 @ h.transpose(0,2,1)
    a0 = np.exp(s0 - s0.max(-1,keepdims=True)); a0 /= a0.sum(-1,keepdims=True)
    r0 = h + np.einsum('bqk,bkd->bqd', a0, h @ VO0)
    s1 = r0 @ A1 @ r0.transpose(0,2,1)
    a1 = np.exp(s1 - s1.max(-1,keepdims=True)); a1 /= a1.sum(-1,keepdims=True)
    r1_5 = r0[:,5] + np.einsum('bk,bkd->bd', a1[:,5], r0 @ VO1)
    d = r1_5 @ G     # 3 differences vs class0
    out = np.concatenate([np.zeros((B,1)), d, np.full((B,2), -1e9)], axis=1)
    if ret_full: return out, h, a0, r0, a1
    return out

Xa = X.astype(int)
out = fwd(Xa)
ref = run(X)
print("argmax agreement", (out.argmax(1)==ref.argmax(1)).mean(), "max score diff", np.abs(out[:,:4]-ref[:,:4]).max())

