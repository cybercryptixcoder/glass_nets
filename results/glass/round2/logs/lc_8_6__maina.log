P = np.concatenate([np.eye(6), np.zeros((6, 2))], 1)

def model(x, iv):
    x = np.asarray(x).astype(int)
    B = x.shape[0]
    E = np.eye(6)
    tok = [iv("tok%d" % p, E[x[:, p]]) for p in range(6)]
    h = np.stack([tok[p] @ T + P[p] for p in range(6)], 1)                 # embed
    s0 = h @ A0 @ h.transpose(0, 2, 1)
    a0 = np.exp(s0 - s0.max(-1, keepdims=True)); a0 /= a0.sum(-1, keepdims=True)
    a0 = iv("a0", a0.reshape(B, 36)).reshape(B, 6, 6)                      # attn0.pattern
    d0 = iv("d0", np.einsum("bqk,bkd->bqd", a0, h @ VO0).reshape(B, 48))
    d0 = d0.reshape(B, 6, 8)                                               # attn0.out
    r0 = iv("r0", (h + d0).reshape(B, 48)).reshape(B, 6, 8)                # resid0.mid
    s1 = r0 @ A1 @ r0.transpose(0, 2, 1)
    a1 = np.exp(s1 - s1.max(-1, keepdims=True)); a1 /= a1.sum(-1, keepdims=True)
    a1 = iv("a1", a1.reshape(B, 36)).reshape(B, 6, 6)                      # attn1.pattern
    d = r0[:, 5] @ G + np.einsum("bk,bkd->bd", a1[:, 5], r0 @ H)           # 3 class differences
    return np.concatenate([np.zeros((B, 1)), d, np.full((B, 2), -(10 ** 9))], 1)

ALIGN = {"tok%d" % p: ["embed"] for p in range(6)}
ALIGN.update({"a0": ["attn0.pattern"], "d0": ["attn0.out"], "r0": ["resid0.mid"], "a1": ["attn1.pattern"]})

