def dec_from_a1(a1p, r0, x):
    B=len(x)
    T_,A0_,VO0_,A1_,G_,H_ = ns['T'],ns['A0'],ns['VO0'],ns['A1'],ns['G'],ns['H']
    d = r0[:,5]@G_ + np.einsum('bk,bkd->bd', a1p[:,5], r0@H_)
