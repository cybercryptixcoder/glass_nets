def fit_map(V, Act):
    A1_ = np.concatenate([V, np.ones((len(V),1))],1)
    coef, *_ = np.linalg.lstsq(A1_, Act, rcond=None)
    pred = A1_@coef
    r2 = 1 - ((Act-pred)**2).sum()/ ((Act-Act.mean(0))**2).sum()
    return coef, r2
def varstack(v, names):
    return np.concatenate([v['tok'][int(n[3:])] if n.startswith('tok') else v[n].reshape(N,-1) for n in names],1)
base = net(Bin).argmax(1)
for s,(names, site) in sites.items():
    V = varstack(vB, names); Act = rB[site]
    coef, r2 = fit_map(V, Act)
    # partial: copy each variable alone from A
    res = []
    start = 0
    for nm in names:
        w = 6 if nm.startswith('tok') else vB[nm].reshape(N,-1).shape[1]
        Vm = V.copy(); Vm[:, start:start+w] = varstack(vA, names)[:, start:start+w]
        start += w
        actp = np.concatenate([Vm, np.ones((N,1))],1)@coef
        tgt = net(Bin, site, actp).argmax(1)
        ch = base!=tgt
        p = (call_model(Bin, {nm: Vm[:, start-w:start]}).argmax(1)==tgt)
        res.append((nm, ch.mean(), p[ch].mean() if ch.sum() else 1.0))
    print(s, "R2=%.6f"%r2, "partials:", [(a, "%.2f"%b, "%.2f"%c) for a,b,c in res])

