    a0 = sm(h@QK0@h.transpose(0,2,1)/np.sqrt(8))
    if site=='attn0.pattern': a0 = val.reshape(B,6,6)
    d0 = np.einsum('bqk,bkd->bqd', a0, h@VO0o)
    if site=='attn0.out': d0 = val.reshape(B,6,8)
    r0 = h+d0
    if site=='resid0.mid': r0 = val.reshape(B,6,8)
    a1 = sm(r0@QK1@r0.transpose(0,2,1)/np.sqrt(8))
    if site=='attn1.pattern': a1 = val.reshape(B,6,6)
    r1 = r0 + np.einsum('bqk,bkd->bqd', a1, r0@VO1o)
    return r1[:,5]@WU
