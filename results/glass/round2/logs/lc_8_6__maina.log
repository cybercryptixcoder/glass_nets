VO0 = Minv @ (W['L0.W_V'][0] @ W['L0.W_O'][0]) @ M
A1 = Minv @ (W['L1.W_Q'][0] @ W['L1.W_K'][0].T) @ Minv.T / np.sqrt(8)
VO1 = Minv @ (W['L1.W_V'][0] @ W['L1.W_O'][0]) @ M
WUd = WU[:,1:4] - WU[:,0:1]
G = Minv @ WUd
