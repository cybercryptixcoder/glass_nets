def sparsify(M,f):
    if f<=0: return M
    v=np.abs(M).ravel(); nz=np.sort(v[v>0]); k=int(f*len(nz))
    thr=nz[k-1]
    return np.where(np.abs(M)<=thr,0.0,M)
def runall(f, extra=None):
    mm=dict(E=sparsify(E,f),P=sparsify(P,f),A0x=sparsify(A0,f),VO0x=sparsify(VO0,f),A1x=sparsify(A1,f),WDx=sparsify(WD,f),Dx=sparsify(D,f))
    return mm
for f in [0.0,0.1,0.15,0.2,0.25,0.3]:
    mm=runall(f)
    acc=(fwdlean(X[:6000],**mm).argmax(1)==oref).mean()
    tot=sum(int((mm[k]!=0).sum()) for k in mm)
    print(f, "acc",round(acc,4), "total nonzero", tot)

