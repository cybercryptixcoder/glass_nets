o=run(X); pred=o.argmax(1); N=len(X)
F=np.zeros((N,36))
for p in range(6): F[np.arange(N),p*6+X[:,p]]=1
def r2(F,o):
    Fb=np.hstack([F,np.ones((len(F),1))])
    coef,_,_,_=np.linalg.lstsq(Fb,o,rcond=None)
    res=o-Fb@coef
    return 1-res.var(0).sum()/o.var(0).sum()
print("R2 onehot(pos,tok):", r2(F,o))
Cn=np.zeros((N,6))
for t in range(6): Cn[:,t]=(X==t).sum(1)
print("R2 counts:", r2(Cn,o))
print("R2 onehot+counts:", r2(np.hstack([F,Cn]),o))
# add products of counts? try squared counts
print("R2 counts+counts^2:", r2(np.hstack([Cn,Cn**2]),o))

