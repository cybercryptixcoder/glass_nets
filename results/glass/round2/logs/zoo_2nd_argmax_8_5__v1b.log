        for j in range(8):
            if wh[i,j]==0: continue
            w2=wh.copy(); w2[i,j]=0
            a,_,_=evaluate(w2,mask)
            if best is None or a>best[0]: best=(a,i,j)
    # also try zeroing a readout entry (only if it doesn't already have 4 zeros)
    a,i,j=best
    if mask.sum()>28:
        bestr=None
        for i2 in range(8):
