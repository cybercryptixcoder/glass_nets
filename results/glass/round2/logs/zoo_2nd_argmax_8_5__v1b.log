import numpy as np
Wx=W['W_x'].ravel(); Wh=W['W_h'].copy(); Wo=W['W_o']
Y=run(X); dec=Y.argmax(1); xs=X
RT=Y[:,1:]-Y[:,0:1]           # true relative logits
D=np.abs(Wx); G=np.sign(Wx)
def fwd_params(wx,wh,x):
    zs=[];hs=[np.zeros((len(x),8))];h=hs[0]
    for t in range(5):
        z=x[:,t:t+1]*wx[None,:]+h@wh; zs.append(z); h=np.maximum(z,0.0); hs.append(h)
    return hs,zs
def loss_grad(wx,wh,wd,maskW,maskD,x,tgt):
    hs,zs=fwd_params(wx,wh,x); h5=hs[-1]
    rel=h5@wd; r=rel-tgt
    L=(r**2).mean()
    dWd=(h5.T@r)/len(x)*2
    dh=r@wd.T*2/len(x)
    dWh=np.zeros((8,8))
    for t in range(4,-1,-1):
        dz=dh*(zs[t]>0)
        dWh+=hs[t].T@dz
        if t>0: dh=dz@wh.T
    dWh*=maskW; dWd*=maskD
    return L,dWh,dWd
rs=np.random.RandomState(0); perm=rs.permutation(len(xs)); tr=perm[:6000]; te=perm[6000:]
# choose masks: 6 readout zeros (smallest |Wd_raw|), 6 Wh zeros (smallest |Wh|) -> 58+26+0 = 84 constants
Wd=Wo[:,1:]-Wo[:,0:1]
mW=np.ones((8,8),bool); mD=np.ones((8,4),bool)
oW=np.argsort(np.abs(Wh).ravel()); oD=np.argsort(np.abs(Wd).ravel())
mW.ravel()[oW[:6]]=False; mD.ravel()[oD[:6]]=False
print("nnz",mW.sum(),mD.sum())
wh=Wh.copy(); wd=Wd.copy()
for p,m in [(wh,mW),(wd,mD)]:
    p[~m]=0.0
def acc_eval(wx,wh,wd,x,dd):
    hs,_=fwd_params(wx,wh,x)
    p=np.concatenate([np.zeros((len(x),1)),hs[-1]@wd],1).argmax(1)
    return (p==dd).mean(), p
print("init acc",acc_eval(Wx,wh,wd,xs,dec)[0], "val",acc_eval(Wx,wh,wd,xs[te],dec[te])[0])
np.save=None

