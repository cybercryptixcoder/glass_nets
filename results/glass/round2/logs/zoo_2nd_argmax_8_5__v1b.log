                 options={'maxiter':4000,'xatol':1e-3,'fatol':1e-4})
    if -res.fun>best[0]: best=(-res.fun,res.x)
    print(trial,-res.fun)
print("best",best[0])
L=best[1].reshape(5,5); print(L.round(2))
print("full acc", (np.argsort(-(xs@L.T),axis=1,kind='stable')[:,1]==dec).mean())

