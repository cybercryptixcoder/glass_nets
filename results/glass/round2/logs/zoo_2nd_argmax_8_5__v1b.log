N=len(xs)
def fwd(wh,x=xs):
    h=np.zeros((len(x),8))
    for t in range(5): h=np.maximum(x[:,t:t+1]*Wxp[None,:]+h@wh,0.0)
    return h
def rel_true(H): return H@((Wo[:,1:]-Wo[:,0:1])*D[:,None])
H5=fwd(Whp); RT=rel_true(H5)
def dec_of(H,Wd):
    rel=H@Wd
    return np.concatenate([np.zeros((len(H),1)),rel],1).argmax(1)
def fit_readout(H,RT,mask):
    W=np.zeros((8,4))
    for c in range(4):
        idx=np.where(mask[:,c])[0]
        coef,_,_,_=np.linalg.lstsq(H[:,idx],RT[:,c],rcond=None)
        W[idx,c]=coef
    return W
mask=np.ones((8,4),bool)
# greedy: at each step, try zeroing each remaining Wh entry (and optionally a readout entry); pick best accuracy
sel=np.random.RandomState(0).choice(N,3000,replace=False)
xs_sub=xs[sel]; dec_sub=dec[sel]
def evaluate(wh,mask,ret_H=False):
    H=fwd(wh,xs_sub)
    W=fit_readout(H,rel_true(fwd(wh,x=xs_sub)),mask)   # fit on the same subset (ok, then verify on all)
    p=dec_of(H,W)
    return (p==dec_sub).mean(),H,W
