def evald(A,B,rho):
    A=np.maximum(A,0);B=np.maximum(B,0)
    d=A-rho*B
    dec=(d>0).astype(int)
    # decision agreement
    agree=(dec==(net==0)).mean()
    return dec,agree,A,B
def r2(vars,act):
    Xd=np.column_stack([vars,np.ones(len(vars[0]))])
    M,_,_,_=np.linalg.lstsq(Xd,act,rcond=None)
    pred=Xd@M
    return 1-((act-pred)**2).sum(0)/((act-act.mean(0))**2).sum(0)
