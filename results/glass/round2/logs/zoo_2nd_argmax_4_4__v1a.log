import numpy as np, scipy.optimize as opt
np.set_printoptions(precision=3, suppress=True)
o=run(X); dtru=o.argmax(1)
Xs=X[:5000]; Os=o[:5000]; T=(Os-Os[:,3:4])
def make(k):
    def unpack(p):
        return p[:4*k].reshape(4,k), p[4*k:4*k+k*k].reshape(k,k), p[4*k+k*k:].reshape(k,3)
    def fg(p, x, tgt):
        s,Wh,W=unpack(p)
        B=len(x); hs=[np.zeros((B,k))]; us=[]
        for i in range(4):
            u=x[:,i:i+1]*s[i]+hs[-1]@Wh; us.append(u); hs.append(np.maximum(u,0))
        err=hs[4]@W-tgt; L=(err**2).mean(); g=2*err/B
        gW=hs[4].T@g; dh=g@W.T; gs=np.zeros((4,k)); gWh=np.zeros((k,k))
        for i in range(4,0,-1):
            du=dh*(us[i-1]>0)
            gWh+=hs[i-1].T@du
            gs[i-1]=(x[:,i-1:i]*du).sum(0)
            dh=du@Wh.T
        return L, np.concatenate([gs.ravel(),gWh.ravel(),gW.ravel()])
    return unpack,fg
best={}
for k in [2,3]:
    unpack,fg=make(k)
    for seed in range(4):
        rng=np.random.default_rng(seed)
        p0=np.concatenate([rng.normal(0,.5,4*k),rng.normal(0,.5,k*k),rng.normal(0,.3,3*k)])
        r=opt.minimize(lambda p: fg(p,Xs,T), p0, jac=True, method='L-BFGS-B', options={'maxiter':2000})
        s,Wh,W=unpack(r.x)
        h=np.zeros((len(X),k))
        for i in range(4): h=np.maximum(X[:,i:i+1]*s[i]+h@Wh,0)
        pred=h@W; acc=(np.c_[pred,np.zeros(len(X))].argmax(1)==dtru).mean()
        print(k,seed,round(r.fun,4),round(acc,4))
        best[(k,seed)]=(r.fun,acc,r.x)

