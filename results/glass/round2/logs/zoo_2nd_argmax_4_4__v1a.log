def runw(x, Wx, Wh, Wo):
    h = np.zeros((len(x),4))
    for t in range(4):
        h = np.maximum(x[:,t:t+1]*Wx + h@Wh, 0)
    return h@Wo
base = runw(X, Wx, Wh, Wo).argmax(1)
res={}
for name,M in [('Wx',Wx.reshape(1,4)),('Wh',Wh),('Wo',Wo)]:
    for i in range(M.shape[0]):
        for j in range(M.shape[1]):
            M2=M.copy(); M2[i,j]=0.0
            if name=='Wx': p=runw(X,M2.ravel(),Wh,Wo)
            elif name=='Wh': p=runw(X,Wx,M2,Wo)
            else: p=runw(X,Wx,Wh,M2)
            res[(name,i,j)] = (p.argmax(1)!=base).mean()
for k,v in sorted(res.items(), key=lambda kv:-kv[1]):
    print(k, round(v,4))

