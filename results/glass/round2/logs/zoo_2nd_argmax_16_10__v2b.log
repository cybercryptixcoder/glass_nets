    def recon(hh): return mu2+((hh-mu2)@P)@P.T
    h2r=recon(h2); o=chain(h2r)@WO
    print('h2 PCA',k,'expl',round(r2v(h2,h2r),6),'dec',round((o.argmax(1)==dec).mean(),4))
