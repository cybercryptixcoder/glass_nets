def feats(x, t):
    # after reading x[:, :t]
    pre = x[:, :t]
    s = -np.sort(-pre, axis=1)
    m1 = s[:,0]; m2 = s[:,1] if t>1 else np.zeros(len(x))
    mmin = pre.min(1)
    return np.column_stack([m1, m2, mmin, pre.sum(1), np.abs(pre).sum(1), x[:, t-1]])
xb = X[:3000]
A = acts(xb)
for t in [2,3,5,8,10]:
    F = feats(xb, t)
    H = A['h%d'%t]
    M = np.hstack([F, np.ones((len(F),1))])
    coef,*_ = np.linalg.lstsq(M,H,rcond=None)
    pred = M@coef
    r2 = 1-((H-pred)**2).sum(0)/ ((H-H.mean(0))**2).sum(0)
    print("t=%d R2 per unit:"%t, np.round(r2,2))

