import numpy as np
Wh = W['W_h'].copy(); Wx = W['W_x'].reshape(16).copy(); Wo = W['W_o'].copy()
outn = run(X); dtrue = outn.argmax(1)
XT, outT = X[:4000], outn[:4000]
XH, outH = X[4000:], outn[4000:]
def fwd(x, Wx, Wh, Wo):
    B=x.shape[0]; h=np.zeros((B,16)); hs=[h]; ms=[]
    for t in range(10):
        z = x[:,t:t+1]*Wx[None,:] + h@Wh
        m = z>0; h = z*m
        hs.append(h); ms.append(m)
    return h@Wo, hs, ms
def grads(x, Wx, Wh, Wo, target):
    out, hs, ms = fwd(x,Wx,Wh,Wo)
    d = 2*(out-target)/x.shape[0]
    dWo = hs[10].T@d
    dh = d@Wo.T
    dWx = np.zeros(16); dWh=np.zeros((16,16))
    for t in range(9,-1,-1):
        dz = dh*ms[t]
        dWx += (x[:,t:t+1]*dz).sum(0)
        dWh += hs[t].T@dz
        if t>0: dh = dz@Wh.T
    return dWx, dWh, dWo
# numeric check
