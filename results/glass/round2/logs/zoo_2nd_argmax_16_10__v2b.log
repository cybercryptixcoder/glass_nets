print('Q2 match', np.abs(Q2u-Q2s*a[:,None]).max(), 'Q3 match', np.abs(Q3u-Q3s*a[:,None]).max())
# residuals of the projection at step2
def step2(x, WXm, WHm, Q2, Q3):
    h=0.5*(np.abs(x[:,0:1])*np.abs(WXm)[None,:]+x[:,0:1]*WXm[None,:])
    h=_rel(x[:,1:2]*WXm[None,:]+h@WHm)
    r1=np.linalg.norm(h-(h@Q2)@Q2.T)/np.linalg.norm(h)
    h=(h@Q2)@Q2.T
    h=_rel(x[:,2:3]*WXm[None,:]+h@WHm)
    r2=np.linalg.norm(h-(h@Q3)@Q3.T)/np.linalg.norm(h)
    return r1,r2
