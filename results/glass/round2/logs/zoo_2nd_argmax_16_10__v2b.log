def fwd(Xq, WXq, WHq, WOq):
    h = np.maximum(Xq[:,0:1]*WXq[None,:],0)
    for t in range(1,10):
        h = np.maximum(Xq[:,t:t+1]*WXq[None,:] + h@WHq, 0)
    return h@WOq
out=run(X); dec=out.argmax(1)
x0=X[:,0]
h=np.maximum(np.outer(np.abs(x0),np.abs(WX))*0.5+np.outer(x0,WX)*0.5,0)  # rank2 exact
def fwd2(Xq,WHq,WOq):
    h = 0.5*(np.abs(Xq[:,0])[:,None]*np.abs(WX)[None,:] + Xq[:,0:1]*WX[None,:])
    h=np.maximum(h,0)
    for t in range(1,10):
        h = np.maximum(Xq[:,t:t+1]*WX[None,:] + h@WHq, 0)
    return h@WOq
print('base agree', (fwd2(X,WH,WO).argmax(1)==dec).mean())
for th in [0.02,0.05,0.1,0.15,0.2,0.3]:
    WHq=np.where(np.abs(WH)<th,0.0,WH)
    WOq=np.where(np.abs(WO)<th,0.0,WO)
    nzW=(WHq!=0).sum(); nzO=(WOq!=0).sum()
    agree=(fwd2(X,WHq,WOq).argmax(1)==dec).mean()
    print(th,'nzWh',nzW,'nzWo',nzO,'agree',round(agree,4),'consts',16+nzW+nzO)

