def run_z(x):
    B=len(x); h=np.zeros((B,16)); Zs=[]
    for t in range(10):
        z = x[:,t:t+1]*W['W_x'][None,:] + h @ W['W_h']
        Zs.append(z); h=np.maximum(z,0)
    return Zs, h
xb = X[:3000]
Zs, h = run_z(xb)
for t in [2,5,9]:
    pre = xb[:, :t]
    s = -np.sort(-pre,axis=1); m1=s[:,0]; m2=s[:,1]
    F = np.column_stack([xb[:,t], m1, m2, np.ones(len(xb))])
    Z = Zs[t]
    coef,*_ = np.linalg.lstsq(F,Z,rcond=None)
    pred=F@coef
    r2 = 1-((Z-pred)**2).sum(0)/((Z-Z.mean(0))**2).sum(0)
    print("t=%d R2 for z_t from (x_t,m1,m2):"%t, np.round(r2,2))
    big = np.argsort(-np.abs(col := coef[0]))[:6]
    print("  coef rows [x_t,m1,m2,1] for units", big, ":\n", np.round(coef[:,big],2))

