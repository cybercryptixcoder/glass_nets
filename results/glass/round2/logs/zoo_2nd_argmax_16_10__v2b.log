import numpy as np, time
Wh0 = W['W_h'].copy(); Wx0 = W['W_x'].reshape(16).copy(); Wo0 = W['W_o'].copy()
outn = run(X); dtrue = outn.argmax(1)
XT, outT = X[:4000], outn[:4000]; XH, outH = X[4000:], outn[4000:]
Xs, outS = XT[:1500], outT[:1500]
def fwd(x, Wx, Wh, Wo):
    B=x.shape[0]; h=np.zeros((B,16)); hs=[h]; ms=[]
    for t in range(10):
        z = x[:,t:t+1]*Wx[None,:] + h@Wh
        m = z>0; h = z*m
        hs.append(h); ms.append(m)
    return h@Wo, hs, ms
def grads(x, Wx, Wh, Wo, target):
    out, hs, ms = fwd(x,Wx,Wh,Wo)
    d = 2*(out-target)/x.shape[0]
    dWo = hs[10].T@d; dh = d@Wo.T
    dWx = np.zeros(16); dWh=np.zeros((16,16))
    for t in range(9,-1,-1):
        dz = dh*ms[t]
        dWx += (x[:,t:t+1]*dz).sum(0); dWh += hs[t].T@dz
        if t>0: dh = dz@Wh.T
    return dWx, dWh, dWo
def L(Wx,Wh,Wo,x=Xs,t=outS):
    o,_,_=fwd(x,Wx,Wh,Wo); return ((o-t)**2).mean()
def beh(Wx,Wh,Wo):
    return ((fwd(XT,Wx,Wh,Wo)[0].argmax(1)==dtrue[:4000]).mean(), (fwd(XH,Wx,Wh,Wo)[0].argmax(1)==dtrue[4000:]).mean())
# greedy with snapshots
Wx,Wh,Wo = Wx0.copy(),Wh0.copy(),Wo0.copy()
mx = np.ones(16,bool); mh=np.ones((16,16),bool); mo=np.ones((16,10),bool)
snaps={}
t0=time.time()
for step in range(120):
    best=(np.inf,None); 
    for i in range(16):
        if mx[i]:
            m=mx.copy(); m[i]=False; v=L(np.where(m,Wx,0.),Wh,Wo)
            if v<best[0]: best=(v,('x',i))
    for i in range(16):
        for j in range(16):
            if mh[i,j]:
                m=mh.copy(); m[i,j]=False; v=L(Wx,np.where(m,Wh,0.),Wo)
                if v<best[0]: best=(v,('h',(i,j)))
    for i in range(16):
        for k in range(10):
            if mo[i,k]:
                m=mo.copy(); m[i,k]=False; v=L(Wx,Wh,np.where(m,Wo,0.))
                if v<best[0]: best=(v,('o',(i,k)))
    kind,idx=best[1]
    if kind=='x': mx[idx]=False; Wx[idx]=0.
    elif kind=='h': mh[idx]=False; Wh[idx]=0.
    else: mo[idx]=False; Wo[idx]=0.
    if step+1 in (60,80,100,120):
        snaps[step+1]=(Wx.copy(),Wh.copy(),Wo.copy(),mx.copy(),mh.copy(),mo.copy())
        print(step+1, np.round(beh(Wx,Wh,Wo),4), round(time.time()-t0,1))
np.save('/tmp/snaps.npy', np.array([0]))

