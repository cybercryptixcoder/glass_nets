import numpy as np
WX=W['W_x'].ravel(); WH=W['W_h']; WO=W['W_o']
def onb(V):
    Q,R=np.linalg.qr(V); return Q
one=np.ones((16,1))
a=0.5*np.abs(WX)@WH; b=0.5*WX@WH; d=WX
A=acts(X); dec=run(X).argmax(1)
def r2(Y,P): 
    Yp=Y@P@P.T; return 1-((Y-Yp)**2).sum()/((Y-Y.mean(0))**2).sum()
h2=A['h2']; h3=A['h3']
cands={
 'basic3':[d,a,b,one.ravel()],
 'relu4':[np.maximum(a+b,0),np.maximum(a-b,0),one.ravel(),d],
 'relu5':[np.maximum(a+b,0),np.maximum(a-b,0),np.maximum(d,0),np.maximum(-d,0),one.ravel()],
 'relu7':[np.maximum(a+b,0),np.maximum(a-b,0),np.maximum(a,0),np.maximum(b,0),np.maximum(d,0),np.maximum(-d,0),one.ravel()],
 'relu9':[np.maximum(a+b,0),np.maximum(a-b,0),np.maximum(a,0),np.maximum(b,0),np.maximum(d,0),np.maximum(-d,0),one.ravel(),np.maximum(a+b+ d,0),np.maximum(a+b-d,0)],
}
for k,v in cands.items():
    P=onb(np.array(v).T)
    print(k,P.shape[1],'h2 expl',round(r2(h2,P),5))

