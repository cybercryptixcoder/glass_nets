def model(x, iv):
    x0 = x[:, 0]
    a = iv("x0abs", np.abs(x0))
    s = iv("x0", x0)
    h = iv("h1", 0.5*(a[:, None]*AWX[None, :] + s[:, None]*WX[None, :]))
    for t in range(1, 10):
        h = np.maximum(x[:, t:t+1]*WX[None, :] + h @ WH, 0)
        h = iv("h%d" % (t+1), h)
    return h @ WO
ALIGN = {"x0abs": ["h1"], "x0": ["h1"]}
for t in range(2, 11):
    ALIGN["h%d" % t] = ["h%d" % t]

