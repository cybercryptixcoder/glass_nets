def dbg(x, Wx, Wh, Wo, use_coef):
    AWX=np.abs(Wx); A2=0.5*(AWX@Wh); B2=0.5*(Wx@Wh)
    q2,_=np.linalg.qr(np.column_stack([_r(Wx+A2+B2),_r(Wx-A2-B2),_r(-Wx+A2+B2),_r(-Wx-A2-B2),
                                       _r(Wx+A2-B2),_r(Wx-A2-B2),_r(-Wx+A2-B2)]))
    GS=np.column_stack([Wx,(q2.T@Wh).T])
    if use_coef:
        CAND=_r(GS@COEF.T)
    else:
        CAND=[_r(GS@CS[i]) for i in range(256)]
        CAND+=[_r(GS[:,i]) for i in range(8)]+[_r(-GS[:,i]) for i in range(8)]
        CAND+=[_r(s1*GS[:,i]+s2*GS[:,j]) for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
        CAND=np.column_stack(CAND)
    q3,_=np.linalg.qr(CAND[:,SEL3])
    return q2,q3,CAND
