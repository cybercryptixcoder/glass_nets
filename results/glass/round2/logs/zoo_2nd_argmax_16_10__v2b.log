    _rel(WX + (A2 - B2)), _rel(WX - (A2 - B2)), _rel(-WX + (A2 - B2))]))
GS = np.column_stack([WX, (Q2.T @ WH).T])
_bits = (np.arange(256)[:, None] >> np.arange(7, -1, -1)[None, :]) & 1
