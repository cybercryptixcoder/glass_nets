def rel(v): return np.maximum(v,0)
def greedy(target, cands, k):
    sel=[]; Qs=None
    for _ in range(k):
        best=None
        for j in range(cands.shape[1]):
            if j in sel: continue
            M=np.column_stack([cands[:,s] for s in sel]+[cands[:,j]])
            Q,_=np.linalg.qr(M)
            r=((target-target@Q@Q.T)**2).sum()
            if best is None or r<best[0]: best=(r,j)
        sel.append(best[1])
    M=np.column_stack([cands[:,s] for s in sel]); Q,_=np.linalg.qr(M)
