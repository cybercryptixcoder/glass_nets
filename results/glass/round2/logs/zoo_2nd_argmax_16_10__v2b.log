def chainQ(xs,Q,fixed=None):
    h1=0.5*(np.abs(xs[:,0])[:,None]*AWX[None,:]+xs[:,0][:,None]*WX[None,:])
    h=rel(xs[:,1:2]*WX[None,:]+h1@WH); h=(h@Q2)@Q2.T
    h3=rel(xs[:,2:3]*WX[None,:]+h@WH); h=(h3@Q)@Q.T
    for t in range(3,10): h=rel(xs[:,t:t+1]*WX[None,:]+h@WH)
    return h
