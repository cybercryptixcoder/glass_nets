    _rel(WX + (A2 + B2)), _rel(WX - (A2 + B2)), _rel(-WX + (A2 + B2)), _rel(-WX - (A2 + B2)),
    _rel(WX + (A2 - B2)), _rel(WX - (A2 - B2)), _rel(-WX + (A2 - B2))]))          # 16 x 7

# ---- step 3: 10 gate coordinates on the 8-dim fan {Wx, Q2@Wh} --------------------
GS = np.column_stack([WX, (Q2.T @ WH).T])                                          # 16 x 8
_bits = (np.arange(256)[:, None] >> np.arange(7, -1, -1)[None, :]) & 1
CS = 1 - 2*_bits                                                                   # 256 x 8, sign patterns
CAND = [_rel(GS @ CS[i]) for i in range(256)]
CAND += [_rel(GS[:, i]) for i in range(8)] + [_rel(-GS[:, i]) for i in range(8)]
CAND = np.column_stack(CAND)                                                       # 16 x 272
SEL3 = [259, 192, 261, 170, 108, 4, 194, 101, 138, 224]
Q3, _ = np.linalg.qr(CAND[:, SEL3])                                                # 16 x 10

def model(x, iv):
    x0 = x[:, 0]
    a = iv("x0abs", np.abs(x0))
    s = iv("x0", x0)
    h1 = 0.5*(a[:, None]*AWX[None, :] + s[:, None]*WX[None, :])
    h2 = np.maximum(x[:, 1:2]*WX[None, :] + h1 @ WH, 0)
    h = iv("h2", h2 @ Q2) @ Q2.T
    h3 = np.maximum(x[:, 2:3]*WX[None, :] + h @ WH, 0)
    h = iv("h3", h3 @ Q3) @ Q3.T
    for t in range(3, 10):
        h = np.maximum(x[:, t:t+1]*WX[None, :] + h @ WH, 0)
        h = iv("h%d" % (t+1), h)
    return h @ WO
ALIGN = {"x0abs": ["h1"], "x0": ["h1"]}
for t in range(2, 11):
