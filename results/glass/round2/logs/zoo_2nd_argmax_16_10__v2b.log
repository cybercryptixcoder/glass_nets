import numpy as np, time
Wh0 = W['W_h'].copy(); Wx0 = W['W_x'].reshape(16).copy(); Wo0 = W['W_o'].copy()
outn = run(X); dtrue = outn.argmax(1)
XT, outT = X[:4000], outn[:4000]; XH, outH = X[4000:], outn[4000:]
_rels = lambda v: np.maximum(v,0.0)
# coefficient matrix (384 x 8), integers
bits = (np.arange(256)[:,None]>>np.arange(7,-1,-1)[None,:])&1
COEF = [1-2*bits]
COEF += [np.eye(8)[i][None,:]*(1 if s>0 else -1) for i in range(8) for s in (1,-1)]
COEF += [(s1*np.eye(8)[i]+s2*np.eye(8)[j])[None,:] for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
COEF = np.vstack(COEF)
SEL3 = [265,192,306,266,277,279,302,259,14,287]
def pipe(Wx, Wh, Wo, x):
    A2 = 0.5*(np.abs(Wx)@Wh); B2 = 0.5*(Wx@Wh)
    q2,_ = np.linalg.qr(np.column_stack([_rels(Wx+A2+B2),_rels(Wx-A2-B2),_rels(-Wx+A2+B2),_rels(-Wx-A2-B2),
                                         _rels(Wx+A2-B2),_rels(Wx-A2-B2),_rels(-Wx+A2-B2)]))
    GS = np.column_stack([Wx,(q2.T@Wh).T])
    CAND = _rels(GS@COEF.T)
    q3,_ = np.linalg.qr(CAND[:,SEL3])
    a=np.abs(x[:,0]); s=x[:,0]
    h1=0.5*(a[:,None]*np.abs(Wx)[None,:]+s[:,None]*Wx[None,:])
    h2=np.maximum(x[:,1:2]*Wx[None,:]+h1@Wh,0); h=(h2@q2)@q2.T
    h3=np.maximum(x[:,2:3]*Wx[None,:]+h@Wh,0); h=(h3@q3)@q3.T
    for t in range(3,10): h=np.maximum(x[:,t:t+1]*Wx[None,:]+h@Wh,0)
    return h@Wo
Xs, ds = XT[:1200], dtrue[:1200]
def score(Wx,Wh,Wo,x=Xs,d=ds):
    return (pipe(Wx,Wh,Wo,x).argmax(1)!=d).sum()
print("base trunc flips(1200)", score(Wx0,Wh0,Wo0), "holdout trunc", (pipe(Wx0,Wh0,Wo0,XH).argmax(1)==dtrue[4000:]).mean())

