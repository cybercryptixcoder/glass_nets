    h=np.zeros((x.shape[0],16))
    for t in range(10): h=np.maximum(x[:,t:t+1]*WX0[None,:]+h@WH,0)
    return h@WO
def agr(WH,WO): return (fwd(Xs,WH,WO).argmax(1)==ds).mean()
t0=time.time()
for it in range(45):
    best=None
    for i in range(16):
        for j in range(16):
            if WH[i,j]==0: continue
            wh=WH.copy(); wh[i,j]=0; s=agr(wh,WO)
            if best is None or s>best[0]: best=(s,'H',(i,j))
    for i in range(16):
        for j in range(1,10):
            if WO[i,j]==0: continue
            wo=WO.copy(); wo[i,j]=0; s=agr(WH,wo)
