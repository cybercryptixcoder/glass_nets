import numpy as np
A = acts(X[:2000])
H = {t: A['h%d'%t] for t in range(1,11)}
def topk_feats(x, k=4):
    n = x.shape[0]
    idx = np.argsort(-x, axis=1)
    f=[]
    for j in range(k):
        f.append(x[np.arange(n), idx[:,j]][:,None])
    for j in range(k):
        oh = np.zeros((n,10)); oh[np.arange(n), idx[:,j]] = 1.0
        f.append(oh)
    return np.concatenate(f,axis=1)
for t in [3,5,7,10]:
    F = topk_feats(X[:2000],4)
    F = np.concatenate([F, np.ones((2000,1))],axis=1)
    beta,*_ = np.linalg.lstsq(F, H[t], rcond=None)
    pred = F@beta
    r2 = 1 - ((H[t]-pred)**2).sum(0)/((H[t]-H[t].mean(0))**2).sum(0)
    print(t, 'R2 per unit', np.round(r2,3))

