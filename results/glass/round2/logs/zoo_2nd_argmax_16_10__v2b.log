H10=acts(xs)['h10']
pred=v1[:,None]*G[p1]+v2[:,None]*G[p2]
r2=1-((H10-pred)**2).sum()/((H10-H10.mean(0))**2).sum()
print('two-spike additive R2',round(r2,3))
# with per-slot refit: regress H10 on [G[p1],G[p2],G[p1]*v1col...]
F=np.c_[v1[:,None]*G[p1], v2[:,None]*G[p2], G[p1], G[p2], np.ones(len(p1))]
b,*_=np.linalg.lstsq(F,H10,rcond=None)
print('refit R2',round(1-((H10-F@b)**2).sum()/((H10-H10.mean(0))**2).sum(),3))

