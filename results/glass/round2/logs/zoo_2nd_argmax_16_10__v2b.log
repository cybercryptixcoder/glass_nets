def constr(x, Wx=Wx0, Wh=Wh0, Wo=Wo0, q2=Q2, q3=Q3, Q3ref=(Q2,)):
    a = np.abs(x[:,0]); s = x[:,0]
    h1 = 0.5*(a[:,None]*np.abs(Wx)[None,:] + s[:,None]*Wx[None,:])
    h2 = np.maximum(x[:,1:2]*Wx[None,:] + h1@Wh, 0)
    h = (h2@q2)@q2.T
    h3 = np.maximum(x[:,2:3]*Wx[None,:] + h@Wh, 0)
    h = (h3@q3)@q3.T
    for t in range(3,10):
        h = np.maximum(x[:,t:t+1]*Wx[None,:] + h@Wh, 0)
    return h@Wo
