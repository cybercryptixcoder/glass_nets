from sklearn.ensemble import GradientBoostingRegressor
N=2000
xs=X[:N]
A=acts(xs)
H=A['h10']
seg=xs
order=np.argsort(-seg,1)
p1=order[:,0].astype(float); p2=order[:,1].astype(float); p3=order[:,2].astype(float)
srt=np.sort(seg,1); m1=srt[:,-1]; m2=srt[:,-2]; m3=srt[:,-3]
F=np.column_stack([m1,m2,m3,p1,p2,p3,seg[:,9]])
r2=[]
for u in range(16):
    g=GradientBoostingRegressor(n_estimators=200,max_depth=3).fit(F[:1500],H[:1500,u])
    pred=g.predict(F[1500:]); y=H[1500:,u]
    r2.append(1-((y-pred)**2).sum()/((y-y.mean())**2).sum())
print('h10 RF R2 by unit:', ' '.join('%5.2f'%r for r in r2))

