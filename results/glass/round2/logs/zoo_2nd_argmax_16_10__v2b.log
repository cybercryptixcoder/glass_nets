import numpy as np
WX=W["W_x"].ravel().copy(); WH=W["W_h"].copy(); WO=W["W_o"].copy()
dnet = run(X).argmax(1)
free = np.array([0.0]+[s*k for k in range(1,9) for s in (1,-1)]+[0.5,-0.5])
def snap(arr, d):
    M = arr.copy(); cnt=0
    idx = np.abs(arr[...,None]-free).argmin(-1)
    dist = np.abs(arr-free[idx])
    m = dist<=d
    M[m]=free[idx][m]
    return M, m.sum()
def netW(x, WX, WH, WO):
    h=np.zeros((x.shape[0],16))
    for t in range(10):
        h=np.maximum(x[:,t:t+1]*WX[None,:]+h@WH,0)
    return h@WO
for d in [0.002,0.005,0.01,0.02,0.03,0.05,0.08]:
    WXs,c1=snap(WX,d); WHs,c2=snap(WH,d); WOs,c3=snap(WO,d)
    agr = (netW(X,WXs,WHs,WOs).argmax(1)==dnet).mean()
    print(d, "saved", c1+c2+c3, "(WX%d WH%d WO%d)"%(c1,c2,c3), "agreement", round(agr,4))

