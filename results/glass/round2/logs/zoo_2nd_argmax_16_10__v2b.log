def chain_from(hs,t0,Xq,WHq=None):
    h=hs; WHq=WH if WHq is None else WHq
    for t in range(t0,10):
        h=np.maximum(Xq[:,t:t+1]*WX[None,:]+h@WHq,0)
    return h@WO
