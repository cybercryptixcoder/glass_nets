def ft(snap, iters=800, lr=0.05):
    Wx,Wh,Wo,mx,mh,mo = [a.copy() for a in snap]
    mv=[np.zeros_like(a) for a in (Wx,Wh,Wo)]; vv=[np.zeros_like(a) for a in (Wx,Wh,Wo)]
    for it in range(1,iters+1):
        gx,gh,go = grads(XT,Wx,Wh,Wo,outT)
        for p,g,m,v in zip((Wx,Wh,Wo),(gx,gh,go),mv,vv):
            m*=0.9; m+=0.1*g; v*=0.999; v+=0.001*g*g
            p -= lr*m/(np.sqrt(v)+1e-8)
        Wx=np.where(mx,Wx,0.); Wh=np.where(mh,Wh,0.); Wo=np.where(mo,Wo,0.)
        if it%200==0: print(it, round(L(Wx,Wh,Wo,XT,outT),4), np.round(beh(Wx,Wh,Wo),4))
    return (Wx,Wh,Wo,mx,mh,mo)
