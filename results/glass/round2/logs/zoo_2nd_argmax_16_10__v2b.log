Xs=X[:2500]; ds=dnet[:2500]
def agr(WX,WH,WO,x=Xs,d=ds):
    h=np.zeros((x.shape[0],16))
    for t in range(10): h=np.maximum(x[:,t:t+1]*WX[None,:]+h@WH,0)
    return (h@WO).argmax(1)==d
print("start", agr(WX,WH,WO).mean())
# greedy block pruning
t0=time.time()
cur_WX,cur_WH,cur_WO = WX.copy(),WH.copy(),WO.copy()
def score_all(WX,WH,WO):
    out=[]
    for i in range(16):
        w=WX.copy(); w[i]=0; out.append(("X",i,agr(w,WH,WO).mean())); 
        for j in range(16):
            wh=WH.copy(); wh[i,j]=0; out.append(("H",i*16+j,agr(WX,wh,WO).mean()))
        for j in range(10):
            wo=WO.copy(); wo[i,j]=0; out.append(("O",i*10+j,agr(WX,WH,wo).mean()))
    return out
s=score_all(cur_WX,cur_WH,cur_WO)
s.sort(key=lambda z:-z[2])
print("round0 best10", [(a,b,round(c,4)) for a,b,c in s[:10]])
print("time", time.time()-t0)

