def lstsq_r2(A_,Y):
    A1 = np.hstack([A_, np.ones((len(A_),1))])
    coef,*_ = np.linalg.lstsq(A1,Y,rcond=None)
    pred = A1@coef
    ss = ((Y-pred)**2).sum(0); st=((Y-Y.mean(0))**2).sum(0)
    return 1-ss/st, coef
o = run(X)
r2,coef = lstsq_r2(X,o)
print("R2:", np.round(r2,3))
print("linear coefs (rows=inputs, cols=classes):\n", np.round(coef[:10],3))

