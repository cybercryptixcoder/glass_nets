import numpy as np, time
WX = W['W_x'].ravel().astype(float); WH = W['W_h'].astype(float); WO = W['W_o'].astype(float)
DEC = run(X).argmax(1)
def _rel(v): return np.maximum(v,0.0)
def build(WHm, WXm):
    A2 = 0.5*(np.abs(WXm)@WHm); B2 = 0.5*(WXm@WHm)
    Q2,_ = np.linalg.qr(np.column_stack([
      _rel(WXm+(A2+B2)),_rel(WXm-(A2+B2)),_rel(-WXm+(A2+B2)),_rel(-WXm-(A2+B2)),
      _rel(WXm+(A2-B2)),_rel(WXm-(A2-B2)),_rel(-WXm+(A2-B2))]))
    GS = np.column_stack([WXm,(Q2.T@WHm).T])
    bits = (np.arange(256)[:,None]>>np.arange(7,-1,-1)[None,:])&1
    CS = 1-2*bits
    CAND = [_rel(GS@CS[i]) for i in range(256)]
    CAND += [_rel(GS[:,i]) for i in range(8)]+[_rel(-GS[:,i]) for i in range(8)]
    CAND += [_rel(s1*GS[:,i]+s2*GS[:,j]) for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
    CAND = np.column_stack(CAND)
    SEL3=[265,192,306,266,277,279,302,259,14,287]
    Q3,_ = np.linalg.qr(CAND[:,SEL3])
    return Q2,Q3
def pipe(x, WXm, WHm, WOm, Q2, Q3):
    a = np.abs(x[:,0]); sx = x[:,0]
    h = 0.5*(a[:,None]*np.abs(WXm)+sx[:,None]*WXm)
    h = _rel(x[:,1:2]*WXm[None,:]+h@WHm); h = (h@Q2)@Q2.T
    h3 = _rel(x[:,2:3]*WXm[None,:]+h@WHm); h = (h3@Q3)@Q3.T
    for t in range(3,10):
        h = _rel(x[:,t:t+1]*WXm[None,:]+h@WHm)
    return h@WOm
