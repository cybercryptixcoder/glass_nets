def r2v(Y,Yp): return 1-((Y-Yp)**2).sum()/((Y-Y.mean(0))**2).sum()
def chain(h2h,t0=2,Xq=X):
    h=h2h
    for t in range(t0,10):
        h=np.maximum(Xq[:,t:t+1]*WX[None,:]+h@WH,0)
    return h
