def trunc_eval(Wx, Wh, Wo):
    AWX = np.abs(Wx)
    A2 = 0.5*(AWX @ Wh); B2 = 0.5*(Wx @ Wh)
    def _r(v): return np.maximum(v,0.0)
    q2,_ = np.linalg.qr(np.column_stack([_r(Wx+(A2+B2)),_r(Wx-(A2+B2)),_r(-Wx+(A2+B2)),_r(-Wx-(A2+B2)),
                                        _r(Wx+(A2-B2)),_r(Wx-(A2-B2)),_r(-Wx+(A2-B2))]))
    GS = np.column_stack([Wx, (q2.T@Wh).T])
    bits=(np.arange(256)[:,None]>>np.arange(7,-1,-1)[None,:])&1; CS=1-2*bits
    CAND=[_r(GS@CS[i]) for i in range(256)]
    CAND+=[_r(GS[:,i]) for i in range(8)]+[_r(-GS[:,i]) for i in range(8)]
    CAND+=[_r(s1*GS[:,i]+s2*GS[:,j]) for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
    CAND=np.column_stack(CAND)
    q3,_ = np.linalg.qr(CAND[:,[265,192,306,266,277,279,302,259,14,287]])
    def mdl(x):
        a=np.abs(x[:,0]); s=x[:,0]
        h1=0.5*(a[:,None]*np.abs(Wx)[None,:]+s[:,None]*Wx[None,:])
        h2=np.maximum(x[:,1:2]*Wx[None,:]+h1@Wh,0)
        h=(h2@q2)@q2.T
        h3=np.maximum(x[:,2:3]*Wx[None,:]+h@Wh,0)
        h=(h3@q3)@q3.T
        for t in range(3,10):
            h=np.maximum(x[:,t:t+1]*Wx[None,:]+h@Wh,0)
        return h@Wo
    o = mdl(X)
    return (o[:4000].argmax(1)==dtrue[:4000]).mean(), (o[4000:].argmax(1)==dtrue[4000:]).mean(), (o.argmax(1)==dtrue).mean()
