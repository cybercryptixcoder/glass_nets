# --- step-2 code: the 7 gate directions, built from the weights only (no free constants) ---
_a = 0.5*AWX @ WH
_b = 0.5*WX @ WH
_B2 = np.array([np.maximum(_a+_b, 0), np.maximum(_a-_b, 0), np.maximum(_a, 0),
                np.maximum(_b, 0), np.maximum(WX, 0), np.maximum(-WX, 0), np.ones(16)])
P2, _ = np.linalg.qr(_B2.T)          # 16 x 7 orthonormal

def model(x, iv):
    x0 = x[:, 0]
    aa = iv("x0abs", np.abs(x0))
    ss = iv("x0", x0)
    h = iv("h1", 0.5*(aa[:, None]*AWX[None, :] + ss[:, None]*WX[None, :]))
    # step 2: keep only the 7 gate coordinates of the state
    z2 = np.maximum(x[:, 1:2]*WX[None, :] + h @ WH, 0)
    v2 = iv("h2", z2 @ P2)
    h = v2 @ P2.T
    for t in range(2, 10):
        h = np.maximum(x[:, t:t+1]*WX[None, :] + h @ WH, 0)
        h = iv("h%d" % (t+1), h)
    return h @ WO
ALIGN = {"x0abs": ["h1"], "x0": ["h1"], "h2": ["h2"]}
for t in range(3, 11):
    ALIGN["h%d" % t] = ["h%d" % t]

