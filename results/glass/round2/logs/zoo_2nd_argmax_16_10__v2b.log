def rel(v): return np.maximum(v,0)
A2v=0.5*(AWX@WH); B2v=0.5*(WX@WH)
Q2,_=np.linalg.qr(np.column_stack([rel(WX+(A2v+B2v)),rel(WX-(A2v+B2v)),rel(-WX+(A2v+B2v)),rel(-WX-(A2v+B2v)),
    rel(WX+(A2v-B2v)),rel(WX-(A2v-B2v)),rel(-WX+(A2v-B2v))]))
GS=np.column_stack([WX,(Q2.T@WH).T])
bits=(np.arange(256)[:,None]>>np.arange(7,-1,-1)[None,:])&1
CS=1-2*bits
CAND=[rel(GS@CS[i]) for i in range(256)]+[rel(GS[:,i]) for i in range(8)]+[rel(-GS[:,i]) for i in range(8)]
