def model(x, iv):
    x0 = x[:, 0]
    a = iv("x0abs", np.abs(x0))
    s = iv("x0", x0)
    h = iv("h1", 0.5*(a[:, None]*AWX[None, :] + s[:, None]*WX[None, :]))
    x1 = iv("x1", x[:, 1])
    h = iv("h2", np.maximum(x1[:, None]*WX[None, :] + h @ WH, 0))
    for t in range(2, 10):
        h = np.maximum(x[:, t:t+1]*WX[None, :] + h @ WH, 0)
        h = iv("h%d" % (t+1), h)
    return h @ WO
