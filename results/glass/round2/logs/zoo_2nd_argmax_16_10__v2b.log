def mdl_old(x, Wx, Wh, Wo):
    AWX=np.abs(Wx); A2=0.5*(AWX@Wh); B2=0.5*(Wx@Wh)
    def _rr(v): return np.maximum(v,0.0)
    q2,_=np.linalg.qr(np.column_stack([_rr(Wx+(A2+B2)),_rr(Wx-(A2+B2)),_rr(-Wx+(A2+B2)),_rr(-Wx-(A2+B2)),
                                       _rr(Wx+(A2-B2)),_rr(Wx-(A2-B2)),_rr(-Wx+(A2-B2))]))
    GS=np.column_stack([Wx,(q2.T@Wh).T])
    C=[_rr(GS@CS[i]) for i in range(256)]
    C+=[_rr(GS[:,i]) for i in range(8)]+[_rr(-GS[:,i]) for i in range(8)]
    C+=[_rr(s1*GS[:,i]+s2*GS[:,j]) for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
    C=np.column_stack(C)
    q3,_=np.linalg.qr(C[:,[265,192,306,266,277,279,302,259,14,287]])
    a=np.abs(x[:,0]); s=x[:,0]
    h=0.5*(a[:,None]*AWX[None,:]+s[:,None]*Wx[None,:])
    h=np.maximum(x[:,1:2]*Wx[None,:]+h@Wh,0); h=(h@q2)@q2.T
    h=np.maximum(x[:,2:3]*Wx[None,:]+h@Wh,0); h=(h@q3)@q3.T
    for t in range(3,10): h=np.maximum(x[:,t:t+1]*Wx[None,:]+h@Wh,0)
    return h@Wo
