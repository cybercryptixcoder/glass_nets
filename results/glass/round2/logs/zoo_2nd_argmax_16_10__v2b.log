def jac(x1, h=1e-4):
    x1 = np.asarray(x1).reshape(1,10)
    base = run(x1)[0]
    J = np.zeros((10,10))
    for j in range(10):
        e = np.zeros((1,10)); e[0,j]=h
        J[:,j] = (run(x1+e)[0]-run(x1-e)[0])/(2*h)
    return J, base
for i in range(4):
    J,b = jac(X[i])
    print("input", X[i])
    print("J (rows=class):\n", np.round(J,2))
    print("decision", b.argmax(), "base:", np.round(b,1))

