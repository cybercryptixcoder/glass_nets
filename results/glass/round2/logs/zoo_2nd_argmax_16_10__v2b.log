bits=(np.arange(256)[:,None]>>np.arange(7,-1,-1)[None,:])&1; CS=1-2*bits
CAND=[rel(GS@CS[i]) for i in range(256)]+[rel(GS[:,i]) for i in range(8)]+[rel(-GS[:,i]) for i in range(8)]
CAND+=[rel(s1*GS[:,i]+s2*GS[:,j]) for i in range(8) for j in range(i+1,8) for s1 in (1,-1) for s2 in (1,-1)]
