WX0=W["W_x"].ravel().copy(); WH=W["W_h"].copy(); WO=W["W_o"].copy(); WO=WO-WO[:,[0]]
dnet=run(X).argmax(1); Xs=X[:3000]; ds=dnet[:3000]
