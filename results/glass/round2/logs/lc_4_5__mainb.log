print('M1r1+Gr2', acc(fwd2(X,M1=rank(M1,1),G=rank(G,2))))
print('hardA0', acc(fwd2(X,A0hard=True)))
print('M1r1+Gr2+hard', acc(fwd2(X,M1=rank(M1,1),G=rank(G,2),A0hard=True)))

