import numpy as np
# reduced forward: layer1 only at query position 4, readout via G=V1@WU
def fwd3(x, M0=M0, V0=V0, M1=M1, G=G, WU=W['W_U'], WE=W['W_E'], WP=W['W_pos']):
    x=np.asarray(x).astype(int)
    R = WE[x] + WP[None,:,:]
    S = R@M0@R.transpose(0,2,1)/2.0
    A0 = np.exp(S-S.max(axis=2,keepdims=True)); A0/=A0.sum(axis=2,keepdims=True)
    Z = R + A0@R@V0
    T4 = Z[:,4,:]@M1@Z.transpose(0,2,1)/2.0
    A1 = np.exp(T4-T4.max(axis=1,keepdims=True)); A1/=A1.sum(axis=1,keepdims=True)
    return Z[:,4,:]@WU + (A1[:,:,None]*(Z@G)).sum(1)
