WE = np.array([[-0.55,-2.03, 1.42, 0.30],
               [ 1.02,-1.09, 0.68, 1.85],
               [ 1.00,-0.20, 1.14, 1.40],
               [ 1.77, 1.90, 1.09,-0.52],
               [-0.64,-0.02, 2.88,-0.07]])
WP = np.array([[ 0.93,-0.53, 2.25, 0.03],
               [ 1.91,-1.15, 0.59,-1.67],
               [-1.30, 1.96, 2.55,-0.47],
               [-1.59,-0.45,-0.07, 2.06],
               [-1.57,-1.15, 0.17, 2.61]])
# additive placeholder: logits ~ b + sum_p C[p][token_p]
C = np.array([[[ 2.6,-1.14,-0.04,-0.03,-1.41],[-1.43,1.4,0.35,0.18,-0.52],[-1.1,-0.4,1.73,-0.76,0.51],[-0.7,-0.25,-0.27,2.0,-0.8],[-1.4,-1.5,0.58,-0.28,2.57]],
