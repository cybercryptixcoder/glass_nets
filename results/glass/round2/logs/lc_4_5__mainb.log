              [[-1.4,0.56,0.36,0.11,0.54],[0.51,-0.54,-0.07,-0.05,0.33],[0.6,0.3,-0.98,0.48,-0.22],[0.47,0.06,-0.01,-0.79,0.45],[0.62,0.37,-0.46,0.21,-0.57]],
              [[-0.96,-0.15,-0.22,-0.01,0.52],[-0.37,-0.32,-0.14,-0.04,0.06],[0.1,0.37,-1.08,0.64,-0.84],[-0.16,0.17,-0.4,-0.26,-0.15],[0.69,0.91,-0.98,0.4,-1.83]],
              [[-0.55,-0.65,-1.11,-0.46,0.67],[-0.87,-0.36,-0.37,-0.21,-0.29],[-0.2,0.44,-1.51,0.85,-1.69],[-0.79,0.61,-0.84,-0.26,-0.83],[1.06,1.74,-1.74,0.41,-3.58]]]).reshape(5,25)

def model(x, iv):
    x = np.asarray(x).astype(int)
    B = x.shape[0]
    vs = []
    for p in range(5):
        oh = np.zeros((B, 5)); oh[np.arange(B), x[:, p]] = 1.0
        vs.append(iv("e%d" % p, oh @ WE + WP[p]))
    F = np.hstack([np.eye(5)[x[:, p]] for p in range(5)])
    return F @ C.T

