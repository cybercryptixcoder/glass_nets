def fwd_from_state(h,t,Xs):
    for s in range(t,10):
        h=np.maximum(Xs[:,s:s+1]*Wxr+h@Whr,0)
    return (h@Wor).argmax(1)
ref=run(Xb).argmax(1)
Hh=A2
def subspace(t,k,mode):
    Hc=Hh['h%d'%t]-Hh['h%d'%t].mean(0)
    Sig=Hc.T@Hc/Hc.shape[0]
    Mt=M[t]
    if mode=='pca':
        w,V=np.linalg.eigh(Sig); U=V[:,::-1][:,:k]
    elif mode=='sens':
        w,V=np.linalg.eigh(Mt); U=V[:,::-1][:,:k]
    else:
        S2h=np.linalg.cholesky(Sig+1e-9*np.eye(16))
        Bm=S2h@Mt@S2h
        w,V=np.linalg.eigh(Bm); Wk=V[:,::-1][:,:k]
        U=np.linalg.solve(S2h, Wk)
        U,_=np.linalg.qr(U)
    return U
for t,ks in [(2,[4,6,8]),(3,[6,10]),(4,[8,12]),(5,[10,12])]:
    H=Hh['h%d'%t]; mu=H.mean(0)
    out=[]
    for k in ks:
        for mode in ['pca','sens','comb']:
            U=subspace(t,k,mode)
            Hk=mu+(H-mu)@U@U.T
            out.append((k,mode,round(float((fwd_from_state(Hk,t,Xb)==ref).mean()),3)))
    print(t,out)

