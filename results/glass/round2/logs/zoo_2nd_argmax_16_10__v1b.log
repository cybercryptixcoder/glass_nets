import numpy as np
np.set_printoptions(precision=3, suppress=True, linewidth=250)
def feats(t, X):
    P=X[:,:t]
    so=np.argsort(-P,axis=1)
    a1=so[:,0]; a2=so[:,1]
    m1=P[np.arange(len(P)),a1]; m2=P[np.arange(len(P)),a2]
    n=len(P)
    oh1=np.zeros((n,10)); oh1[np.arange(n),a1]=1
    oh2=np.zeros((n,10)); oh2[np.arange(n),a2]=1
    return dict(oh1=oh1,oh2=oh2,m1=m1,m2=m2,a1=a1,a2=a2)
for t in [2,3,5,10]:
    f=feats(t,X); h=A['h%d'%t]
    y=h-h.mean(0)
    for name, cols in [("oh2",[f['oh2']]),("oh1,oh2",[f['oh1'],f['oh2']]),
                       ("oh1,oh2,m",[f['oh1'],f['oh2'],f['m1'][:,None],f['m2'][:,None]]),
                       ("oh1,oh2,m,x1..t",[f['oh1'],f['oh2'],f['m1'][:,None],f['m2'][:,None],X[:,:t]])]:
        D=np.hstack([np.ones((len(y),1))]+cols)
        c,res,rank,sv=np.linalg.lstsq(D,y,rcond=None)
        pred=D@c
        r2=1-((y-pred)**2).sum()/ (y**2).sum()
        print("t=%d %-18s R2=%.3f"%(t,name,r2))

