def model(x, iv):
    B = x.shape[0]
    pos1 = iv("pos1", np.maximum(x[:, 0], 0.0))
    neg1 = iv("neg1", np.maximum(-x[:, 0], 0.0))
    h = pos1[:, None] * WP + neg1[:, None] * WN
    h = iv("h2", np.maximum(np.outer(x[:, 1], WX) + h @ WH, 0.0))
    h = iv("h3", np.maximum(np.outer(x[:, 2], WX) + h @ WH, 0.0))
    h = iv("h4", np.maximum(np.outer(x[:, 3], WX) + h @ WH, 0.0))
    h = iv("h5", np.maximum(np.outer(x[:, 4], WX) + h @ WH, 0.0))
    h = iv("h6", np.maximum(np.outer(x[:, 5], WX) + h @ WH, 0.0))
    h = iv("h7", np.maximum(np.outer(x[:, 6], WX) + h @ WH, 0.0))
    h = iv("h8", np.maximum(np.outer(x[:, 7], WX) + h @ WH, 0.0))
    h = iv("h9", np.maximum(np.outer(x[:, 8], WX) + h @ WH, 0.0))
    h = iv("h10", np.maximum(np.outer(x[:, 9], WX) + h @ WH, 0.0))
    return h @ WO

