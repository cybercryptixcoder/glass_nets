def greedy(a,dmax):
    sel=[]; 
    tgt=((a-a.mean(0))**2).sum()
    for _ in range(dmax):
        best=None
        for j in range(16):
            if j in sel: continue
            s=sel+[j]; Z=np.c_[np.ones(len(a)),a[:,s]]
            co,_,_,_=np.linalg.lstsq(Z,a,rcond=None); res=((a-Z@co)**2).sum()
            if best is None or res<best[0]: best=(res,j,co)
        sel.append(best[1]); 
        print('  d=%d add u%d expl=%.6f'%(len(sel),best[1],1-best[0]/tgt))
    return sel
