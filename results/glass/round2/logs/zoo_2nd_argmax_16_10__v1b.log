A=acts(X[:4000])['h10']
def r2feat(F,name):
    F=np.asarray(F,float)
    Z=np.c_[np.ones(len(F)),F]
    coef,_,_,_=np.linalg.lstsq(Z,A,rcond=None)
    pred=Z@coef
    r2=1-((A-pred)**2).sum(0)/((A-A.mean(0))**2).sum(0)
    print(name, np.round(r2,2), "meanR2", round(r2.mean(),3))
Xs=X[:4000]
s=np.sort(-Xs,axis=1)
r2feat(Xs,"x all")
r2feat(s[:,:2],"s1,s2")
r2feat(np.c_[s[:,:2],np.argsort(-Xs,axis=1)[:,:2]],"s1,s2,p1,p2")
