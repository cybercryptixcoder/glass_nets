def model(x, iv):
    B = x.shape[0]
    pos1 = iv("pos1", np.maximum(x[:, 0], 0.0))
    neg1 = iv("neg1", np.maximum(-x[:, 0], 0.0))
    h = pos1[:, None]*WXP + neg1[:, None]*WXN
    h2 = np.maximum(x[:, 1:2]*WX + h@WH, 0.0)
    v2 = iv("v2", (h2 - MU2)@U2)
    h = MU2 + v2@U2.T
    h3 = np.maximum(x[:, 2:3]*WX + h@WH, 0.0)
    v3 = iv("v3", (h3 - MU3)@U3)
    h = MU3 + v3@U3.T
    h = iv("h4", np.maximum(x[:, 3:4]*WX + h@WH, 0.0))
    h = iv("h5", np.maximum(x[:, 4:5]*WX + h@WH, 0.0))
    h = iv("h6", np.maximum(x[:, 5:6]*WX + h@WH, 0.0))
    h = iv("h7", np.maximum(x[:, 6:7]*WX + h@WH, 0.0))
    h = iv("h8", np.maximum(x[:, 7:8]*WX + h@WH, 0.0))
    h = iv("h9", np.maximum(x[:, 8:9]*WX + h@WH, 0.0))
    h = iv("h10", np.maximum(x[:, 9:10]*WX + h@WH, 0.0))
    o = h@WD
    return np.hstack([o, np.zeros((B, 1))])
ALIGN = {"pos1": ["h1"], "neg1": ["h1"], "v2": ["h2"], "v3": ["h3"], "h4": ["h4"], "h5": ["h5"], "h6": ["h6"], "h7": ["h7"], "h8": ["h8"], "h9": ["h9"], "h10": ["h10"]}


