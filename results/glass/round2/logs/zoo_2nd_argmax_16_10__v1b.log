import numpy as np
WXr=np.round(W['W_x'].ravel(),3); WHr=np.round(W['W_h'],3); WOr=np.round(W['W_o'],3)
def fwd(x, WX_=WXr, WH_=WHr, WO_=WOr):
    B=x.shape[0]; h=np.zeros((B,16)); hs=[]
    for t in range(10):
        h=np.maximum(np.outer(x[:,t],WX_)+h@WH_,0.0); hs.append(h)
    return hs, h@WO_
