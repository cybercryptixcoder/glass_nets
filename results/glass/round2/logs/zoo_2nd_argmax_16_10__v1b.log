        p2=np.where(nt,p1,np.where(ns,t,p2)); v2=np.where(nt,v1,np.where(ns,xs,v2))
        p1=np.where(nt,t,p1); v1=np.where(nt,xs,v1)
        oh1=np.eye(10)[p1]; oh2=np.eye(10)[p2]
