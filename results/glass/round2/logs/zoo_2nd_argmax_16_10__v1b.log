def model(x, iv):
    B = x.shape[0]
    pos1 = iv("pos1", np.maximum(x[:, 0], 0.0))
    neg1 = iv("neg1", np.maximum(-x[:, 0], 0.0))
    h = pos1[:, None] * np.maximum(WX, 0.0) + neg1[:, None] * np.maximum(-WX, 0.0)
    h2 = np.maximum(x[:, 1:2] * WX + h @ WH, 0.0)
    v2 = iv("v2", h2[:, S2])
    h = np.c_[np.ones(B), v2] @ B2
    h3 = np.maximum(x[:, 2:3] * WX + h @ WH, 0.0)
    v3 = iv("v3", h3[:, S3])
    h = np.c_[np.ones(B), v3] @ B3
    for t in range(3, 10):
        h = np.maximum(x[:, t:t+1] * WX + h @ WH, 0.0)
        h = iv("h%d" % (t + 1), h)
    return h @ WO

ALIGN = {"pos1": ["h1"], "neg1": ["h1"], "v2": ["h2"], "v3": ["h3"]}
for _t in range(4, 11):
    ALIGN["h%d" % _t] = ["h%d" % _t]

