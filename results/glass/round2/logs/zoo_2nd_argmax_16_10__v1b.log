import numpy as np
Wxr=W['W_x'].ravel(); Whr=W['W_h']; Wor=W['W_o']
def fwd_cache(Xs):
    B=Xs.shape[0]; h=np.zeros((B,16)); pre=[]; hs=[np.zeros((B,16))]
    for t in range(10):
        p=Xs[:,t:t+1]*Wxr+h@Whr; pre.append(p); h=np.maximum(p,0); hs.append(h)
    return hs,pre
Xs=X[:2000]
hs,pre=fwd_cache(Xs)
# backprop of logits
G=[np.zeros((16,16)) for _ in range(11)]
for c in range(10):
    dl=hs[10]@Wor[:,c]   # scalar per input (logit)
    dh=(Wor[:,c])[None,:].repeat(Xs.shape[0],0)   # d logit / d h10 = Wo[:,c]
    for t in range(10,0,-1):
        G[t]+=dh.T@dh
        dpre=dh*(pre[t-1]>0)
        if t>1: dh=dpre@Whr.T
    # also nothing for h0
M=[G[t]/(2000*10) for t in range(11)]
for t in range(2,6):
    w=np.linalg.eigvalsh(M[t])[::-1]; print(t, np.round(w/w[0],3)[:8])

