WP = np.maximum(Wx,0.0)
WN = np.maximum(-Wx,0.0)

def model(x, iv):
    p1 = iv("pos1", np.maximum(x[:,0],0.0))
    n1 = iv("neg1", np.maximum(-x[:,0],0.0))
    h = p1[:,None]*WP + n1[:,None]*WN
    for t in range(1,10):
        h = np.maximum(x[:,t:t+1]*Wx + h@Wh, 0.0)
    return h@Wo

ALIGN = {"pos1":["h1"], "neg1":["h1"]}

