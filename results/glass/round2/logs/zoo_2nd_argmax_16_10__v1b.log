def substtest(V, site='h2', t0=2, Hs=None):
    H = H2 if Hs is None else Hs
    A=np.hstack([np.ones((H.shape[0],1)),V])
    M,_,_,_=np.linalg.lstsq(A,H,rcond=None)
    pred=A@M
    r2=1-((H-pred)**2).sum()/((H-H.mean(0))**2).sum()
    out=fwd_from(pred,Xb,t0)
    return r2,(out.argmax(1)==net_dec).mean()
