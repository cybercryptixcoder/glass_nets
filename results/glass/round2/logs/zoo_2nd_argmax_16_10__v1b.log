def acts_states(Xs):
    out=[]; h=np.zeros((Xs.shape[0],16))
    for t in range(10):
        h=np.maximum(Xs[:,t:t+1]*Wxr+h@Whr,0); out.append(h.copy())
    return out
Hb=acts_states(Xs_b); Ha_=acts_states(Xs_a)
def continue_from(h,t,Xs):
    for s in range(t,10): h=np.maximum(Xs[:,s:s+1]*Wxr+h@Whr,0)
    return (h@Wor).argmax(1)
for t,Mx,MU,XX in [(2,None,MU2,U2),(3,None,MU3,U3)]:
    hB=Hb[t-1]; hA=Ha_[t-1]
    # judge's probe: fit M from [1, v] to h  (they fit on held-out activation pairs)
    V=np.hstack([np.ones((hB.shape[0],1)),(hB-MU)@XX])
    Mfit,_,_,_=np.linalg.lstsq(V,hB,rcond=None)   # 1+k x 16
    dA=(hA-MU)@XX; dB=(hB-MU)@XX
    new=hB+(dA-dB)@XX.T
    Dnet=continue_from(new,t,Xs_b)
    # model: deltas from A
