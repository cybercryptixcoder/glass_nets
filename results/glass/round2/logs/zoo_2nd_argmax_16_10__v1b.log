def sim(Wx,Wh,Wo,Xs):
    B=len(Xs); h=np.zeros((B,16))
    for t in range(10):
        h=np.maximum(Xs[:,t:t+1]*Wx + h@Wh,0)
    return h@Wo
def agree(Wx,Wh,Wo,Xs):
    o=sim(Wx,Wh,Wo,Xs); r=run(Xs)
    return (o.argmax(1)==r.argmax(1)).mean(), 1-((r-o)**2).sum()/((r-r.mean(0))**2).sum()
Wx,Wh,Wo=W['W_x'].ravel().copy(),W['W_h'].copy(),W['W_o'].copy()
for k in [10,100,1000,10000]:
    a,r2=agree(np.round(Wx*k)/k,np.round(Wh*k)/k,np.round(Wo*k)/k,X[4000:6000])
    print(k,"agree %.4f r2 %.3f"%(a,r2))

