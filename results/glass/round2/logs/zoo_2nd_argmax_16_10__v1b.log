def groupR2(key,D,build=None,minn=60):
    tot=sse=0
    for k in np.unique(key):
        m=key==k
        if m.sum()<minn: continue
        DD=np.hstack([np.ones((m.sum(),1)),D[m]]); c=np.linalg.lstsq(DD,y[m],rcond=None)[0]
        sse+=((y[m]-DD@c)**2).sum(); tot+=(y[m]**2).sum()
    return 1-sse/tot
