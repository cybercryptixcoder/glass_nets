A = {t: acts(X)["h%d"%t] for t in range(1,11)}
for t in [1,2,3,5,10]:
    M=A[t]; Mc=M-M.mean(0)
    s=np.linalg.svd(Mc,compute_uv=False)**2
    print("h%d"%t, np.round((s/s.sum())[:10],3))
    # how well do k PCs predict activations linearly (they always do) & decisions
    u,sv,vt=np.linalg.svd(Mc,full_matrices=False)
    out=run(X); dec=out.argmax(1)
    for k in [1,2,3,4,5,6,8]:
        R=M.mean(0)+u[:,:k]@np.diag(sv[:k])@vt[:k]
        d2=(R@W["W_o"]).argmax(1)
        print("   k",k,"dec agree",np.round((d2==dec).mean(),3))

