def fwd(tokens, mod=None):
    Ee = (E[tokens] + P).astype(float)
    if mod and 'e' in mod: Ee = mod['e'](Ee)
    A0m = mod['A0'] if mod and 'A0' in mod else A0
    VO0m = mod['VO'] if mod and 'VO' in mod else VO0
    A1m = mod['A1'] if mod and 'A1' in mod else A1
    Mm = mod['M'] if mod and 'M' in mod else M
    WUm = mod['WU'] if mod and 'WU' in mod else WU
    q=Ee@A0m.T if False else None
    S=np.einsum('bid,de,bje->bij',Ee,A0m,Ee)/np.sqrt(3)
    a0=np.exp(S-S.max(-1,keepdims=True)); a0/=a0.sum(-1,keepdims=True)
    if mod and 'A0post' in mod: a0 = mod['A0post'](a0)
    h0 = Ee + np.einsum('bij,bjd,de->bie',a0,Ee,VO0m)
    S1=np.einsum('bid,de,bje->bij',h0,A1m,h0)/np.sqrt(3)
    a1=np.exp(S1-S1.max(-1,keepdims=True)); a1/=a1.sum(-1,keepdims=True)
    if mod and 'A1post' in mod: a1 = mod['A1post'](a1)
    h1 = h0 + np.einsum('bij,bjd,de->bie',a1,h0,Mm)
    return h1[:,-1]@WUm, a0, a1, h0, h1

def rk(X, k):
    u,s,vt = np.linalg.svd(X); return (u[:,:k]*s[:k])@vt[:k]

base,_,_,_,_ = fwd(X)
print("check", np.abs(base-run(X)).max())
db = base.argmax(1)
def test(name, mod):
    o = fwd(X, mod)[0]
    print(name, "dec agree", (o.argmax(1)==db).mean(), "max err", np.abs(o-base).max())
