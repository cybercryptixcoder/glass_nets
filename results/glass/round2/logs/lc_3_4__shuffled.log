    q=Ee@W['L0.W_Q'][0]; k=Ee@W['L0.W_K'][0]; v=Ee@W['L0.W_V'][0]
    S=q@k.transpose(0,2,1)/np.sqrt(3); A=np.exp(S-S.max(-1,keepdims=True)); A/=A.sum(-1,keepdims=True)
    if mod and 'A0' in mod: A = mod['A0'](A)
    h0 = Ee + (A@v)@W['L0.W_O'][0]
