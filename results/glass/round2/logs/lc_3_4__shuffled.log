def pcsuff(site, key, shp):
    A = a[site]; mu=A.mean(0)
    u,s,vt=np.linalg.svd(A-mu,full_matrices=False)
    res=[]
    for k in range(0,8):
        rec = mu+(A-mu)@vt[:k].T@vt[:k]
        o = fw(**{key: rec.reshape(shp)})
        res.append(round(float((o.argmax(1)==db).mean()),3))
    print(site, "var", np.round((s**2/(s**2).sum())[:8],2), "suff", res)
