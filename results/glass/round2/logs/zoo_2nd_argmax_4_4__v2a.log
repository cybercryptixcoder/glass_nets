# exact relation hunt: a_i + a_j + a_k = 0 and a_i = a_j + a_k etc, tolerance relative
def hunt(M,name,tol=1e-7):
    v=M.ravel(); n=len(v); out=[]
    for i,j in itertools.combinations(range(n),2):
        if abs(v[i]+v[j])<tol*max(1,abs(v[i])): out.append(('sum0',i,j,v[i]))
        if abs(v[i]-v[j])<tol*max(1,abs(v[i])): out.append(('eq',i,j,v[i]))
    for i,j,k in itertools.permutations(range(n),3):
        sc=max(abs(v[i]),abs(v[j]),abs(v[k]))
        if abs(v[i]+v[j]+v[k])<tol*sc: out.append(('sum3',i,j,k))
        if abs(v[i]+v[j]-v[k])<tol*sc: out.append(('sum3m',i,j,k))
        if abs(v[i]*v[j]-v[k])<tol*abs(v[k]): out.append(('prod',i,j,k))
    print(name, len(out), out[:10])
hunt(Wh2,'Wh2'); hunt(WOD,'WOD'); hunt(Wh,'Wh'); hunt(Wo,'Wo')

