import numpy as np

DESCRIPTION = """Stage 1 (VERIFIED): h1 = x_1 split by sign (units 0,3 carry max(x1,0), units 1,2 carry max(-x1,0)).
Stages 2-4: transition h_t = relu(x_t*W_x + h_(t-1)@W_h) with the measured recurrent weights; the readout is the
4 class-score rows. The network is homogeneous of degree 1 (out(2x)=2*out(x)), all 20 recurrent/input constants are
individually necessary (zeroing any entry changes >10% of decisions, 0.3% weight noise changes 5%), so this is a
diagnostic exact re-description while I look for a coarser rule."""

WX = np.array([0.9975, -2.2207, -2.0354, 0.3939])
WH = np.array([[-0.2137,  2.8348, -0.1426,  0.9157],
               [ 2.4333,  1.3203, -0.4893,  2.5231],
               [-2.1697, -1.4067,  0.5307, -2.7988],
               [-0.0335,  0.4774,  2.4935, -0.7525]])
WO = np.array([[ 1.6376,  0.6297, -2.5617,  0.5466],
               [ 1.0779, -0.5340, -1.0086,  0.6374],
               [-1.2079,  1.2053,  0.8859, -0.9309],
               [-2.5583, -0.5449,  3.3309, -0.8870]])

def model(x, iv):
    x = np.asarray(x, dtype=float)[:, :4]
    xp = iv("x1pos", np.maximum(x[:, 0], 0.0))
    xm = iv("x1neg", np.maximum(-x[:, 0], 0.0))
    h = np.stack([0.9975*xp, 2.2207*xm, 2.0354*xm, 0.3939*xp], 1)
    for t in range(1, 4):
        pre = x[:, t:t+1] * WX[None, :] + h @ WH
        h = iv("h%d" % (t+1), np.maximum(pre, 0.0))
    return h @ WO

ALIGN = {"x1pos": ["h1"], "x1neg": ["h1"], "h2": ["h2"], "h3": ["h3"], "h4": ["h4"]}

