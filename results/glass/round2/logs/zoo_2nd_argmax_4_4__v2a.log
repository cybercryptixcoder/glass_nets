import numpy as np
Wx=W['W_x'].ravel().astype(float); Wh=W['W_h'].astype(float); Wo=W['W_o'].astype(float)
tgt=np.concatenate([Wx,Wh.ravel(),Wo.ravel()])
tgt2=tgt/ np.linalg.norm(tgt)
def check(gen, N=50000):
    best=(1e9,None,None)
    for sd in range(N):
        r=gen(sd)
        if r is None: continue
        r=r/np.linalg.norm(r)
        a=abs(float(r@tgt2))
        if 1-a<best[0]: best=(1-a,sd,a)
    return best
def g1(sd):
    np.random.seed(sd); return np.random.randn(36)
print("legacy randn", check(g1))
def g2(sd):
    r=np.random.default_rng(sd); return r.standard_normal(36)
print("default_rng", check(g2))
def g3(sd):
    np.random.seed(sd); return np.random.uniform(-1,1,36)
print("uniform", check(g3))

