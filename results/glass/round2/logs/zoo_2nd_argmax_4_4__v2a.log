import numpy as np
Wx=W['W_x'].ravel().astype(float); Wh=W['W_h'].astype(float); Wo=W['W_o'].astype(float)
X0=X.astype(float)
def net(Wx_=Wx,Wh_=Wh,Wo_=Wo):
    h=np.zeros((X0.shape[0],4))
    for t in range(4): h=np.maximum(X0[:,t:t+1]*Wx_[None,:]+h@Wh_,0)
    return h@Wo_
ref=net().argmax(1)
rng=np.random.default_rng(0)
for eps in [1e-4,3e-4,1e-3]:
    accs=[]
    for _ in range(3):
        accs.append((net(Wh_=Wh*(1+eps*rng.standard_normal(Wh.shape))).argmax(1)==ref).mean())
    print("Wh noise",eps,np.mean(accs))
# rank truncations of the 4x4 recurrent map: decisions
U,S,Vt=np.linalg.svd(Wh,full_matrices=False)
for k in [1,2,3]:
    print("Wh rank",k,(net(Wh_=(U[:,:k]*S[:k])@Vt[:k]).argmax(1)==ref).mean())

