import numpy as np, itertools
dec=run(X).argmax(1); Y=np.eye(4)[dec]; n=len(X)
def acc(F,lam=0.0):
    B=np.linalg.lstsq(F,Y,rcond=None)[0]
    return ((F@B).argmax(1)==dec).mean()
base=np.c_[X]
pairs=list(itertools.combinations(range(4),2))
Fp=np.stack([np.maximum(X[:,i]-X[:,j],0) for i,j in pairs],1)
Fa=np.stack([np.abs(X[:,i]-X[:,j]) for i,j in pairs],1)
print("x",acc(base).round(3))
print("x+relu diff",acc(np.c_[X,Fp]).round(3))
print("x+abs diff",acc(np.c_[X,Fa]).round(3))
print("x+relu diff+absdiff",acc(np.c_[X,Fp,Fa]).round(3))
# add sorting features
S=np.sort(X,1)
print("sorted",acc(S).round(3), "x+sorted", acc(np.c_[X,S]).round(3))

