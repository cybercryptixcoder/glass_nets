import numpy as np, itertools
Wx=W['W_x'].ravel().astype(float); Wh=W['W_h'].astype(float); Wo=W['W_o'].astype(float)
s=np.abs(Wx); Wh2=(s[:,None]*Wh)/s[None,:]; WOD=s[:,None]*(Wo[:,1:]-Wo[:,0][:,None])
v=np.concatenate([Wh2.ravel(),WOD.ravel()]); n=len(v); print(n)
# quadruple hunt: a_i a_j = a_k a_l  and  a_i+a_j = a_k+a_l
hits=[]
for i,j,k,l in itertools.combinations(range(n),4):
    for (a,b,c,d) in [(i,j,k,l),(i,k,j,l),(i,l,j,k)]:
        if abs(v[a]*v[b]-v[c]*v[d])<1e-6*max(1,abs(v[a]*v[b])): hits.append(('prod',a,b,c,d))
        if abs(v[a]+v[b]-v[c]-v[d])<1e-6*max(1,abs(v[a])): hits.append(('sum',a,b,c,d))
print("quad hits", len(hits), hits[:6])
# pairs with same ratio (would share one alpha literal)
rat=[]
for i in range(n):
    for j in range(n):
        if i!=j and abs(v[j])>1e-3: rat.append((v[i]/v[j],i,j))
rat.sort()
close=[(abs(rat[m+1][0]-rat[m][0])/max(1,abs(rat[m][0])),rat[m],rat[m+1]) for m in range(len(rat)-1)]
close.sort()
print("closest repeated ratios:", [(round(c[0],9),c[1],c[2]) for c in close[:5]])
# how far each entry is from an integer or half-integer (free literals)
d=np.abs(v-np.round(v*2)/2); print("nearest free-literal distances (sorted):", np.sort(d)[:6])

