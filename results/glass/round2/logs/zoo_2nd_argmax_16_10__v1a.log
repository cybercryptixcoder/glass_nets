def model(x, iv):
    h = np.zeros((x.shape[0], 16))
    for t in range(10):
        h = np.maximum(x[:, t:t+1] * Wx + h @ Wh, 0.0)
        h = iv("h%d" % (t+1), h)
    return h @ Wo

