--- python ---

h10 = acts(X)['h10']
# PCA
hc = h10 - h10.mean(0)
u,s,vt = np.linalg.svd(hc, full_matrices=False)
print("singular values", s[:10]/s[0])
print("cumulative", np.cumsum(s**2)/np.sum(s**2))
# correlation of top PCs with candidate features
x = X
feats = {
 'sum': x.sum(1), 'last': x[:,-1], 'first': x[:,0], 'max': x.max(1), 'min': x.min(1),
 'npos': (x>0).sum(1), 'argmax': x.argmax(1), 'argmin': x.argmin(1),
 'sumpos': np.maximum(x,0).sum(1), 'sumneg': np.minimum(x,0).sum(1),
 'absmax': np.abs(x).max(1), 'sq': (x**2).sum(1),
}
pcs = hc @ vt[:6].T
for k,v in feats.items():
    c = [np.corrcoef(v, pcs[:,j])[0,1] for j in range(6)]
    print(k, np.round(c,3))

