h=acts(X[:2000])
def prefix_feats(x,t):
    p=x[:,:t]
    feats=[p.max(1)]
    if t>=2: feats.append(np.sort(p,1)[:,-2])
    if t>=3: feats.append(np.sort(p,1)[:,-3])
    feats += [p.sum(1),(p>0).sum(1)*1.0,np.maximum(p,0).sum(1),np.minimum(p,0).sum(1),np.abs(p).max(1)]
    return np.stack(feats,1)
for t in [1,2,3,5,8,10]:
    F=prefix_feats(X[:2000],t)
    ht=h['h%d'%t]
    A=np.hstack([F,np.ones((len(F),1))])
    coef,_,_,_=np.linalg.lstsq(A,ht,rcond=None)
    pred=A@coef
    r2=1-((ht-pred)**2).sum(0)/((ht-ht.mean(0))**2).sum(0)
    print(t,"mean R2",np.round(r2.mean(),3),np.round(r2,2))

