def pref(x,t):
    p=x[:,:t]
    M=p.max(1)
    s=np.sort(p,1)
    M2=s[:,-2]
    return dict(M=M,M2=M2,mn=p.min(1),sum=p.sum(1),xt=p[:,-1],M_minus_xt=M-p[:,-1],xt_minus_M2=p[:,-1]-M2,
                cntpos=(p>0).sum(1)*1.0, sumsq=(p**2).sum(1))
H=acts(X[:2000])
def r2_spline(y,f,k=12):
    qs=np.quantile(f,np.linspace(0,1,k+1)[1:-1])
    B=np.stack([f]+[np.maximum(f-q,0) for q in qs]+[np.ones_like(f)],1)
    c,_,_,_=np.linalg.lstsq(B,y,rcond=None)
    pred=B@c
    ss=((y-y.mean())**2).sum()
    return 1-((y-pred)**2).sum()/ss if ss>0 else 0
for t in [3,6,10]:
    d=pref(X[:2000],t)
    ht=H['h%d'%t]
    print("=== t",t)
    for k,v in d.items():
        rs=[r2_spline(ht[:,j],v) for j in range(16)]
        print(" %-12s mean %.2f"%(k,np.mean(rs)), np.round(rs,2))

