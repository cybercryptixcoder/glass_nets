from sklearn.linear_model import LinearRegression
h10 = acts(X)['h10']
lr = LinearRegression().fit(X, h10)
pred = lr.predict(X)
print("R2 linear per unit", np.round(lr.score(X,h10)*np.ones(1),3))
r2 = 1 - ((h10-pred)**2).sum(0)/((h10-h10.mean(0))**2).sum(0)
print("R2", np.round(r2,3))
# quadratic features
from sklearn.preprocessing import PolynomialFeatures
pf = PolynomialFeatures(2, include_bias=False)
Xp = pf.fit_transform(X)
lr2 = LinearRegression().fit(Xp, h10)
r2b = 1 - ((h10-lr2.predict(Xp))**2).sum(0)/((h10-h10.mean(0))**2).sum(0)
print("R2 quad", np.round(r2b,3))
print("R2 quad mean", r2b.mean())

