def model(x, iv):
    h = np.zeros((x.shape[0], 16))
    for t in range(1, 11):
        h = np.maximum(x[:, t-1:t] * Wx + h @ Wh, 0.0)
        if t == 2:
            v = iv("h2", (h - mu2) @ V2.T)
            h = v @ V2 + mu2
        elif t == 3:
            v = iv("h3", (h - mu3) @ V3.T)
            h = v @ V3 + mu3
        else:
            h = iv("h%d" % t, h)
    return h @ Wo

ALIGN = {("h%d" % t): [("h%d" % t)] for t in range(1, 11)}

