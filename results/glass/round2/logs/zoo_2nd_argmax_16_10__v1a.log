def runx(x): return run(x)
# finite difference gradient of out_j wrt x_i
B=200
x0=X[:B]
eps=1e-3
G=np.zeros((10,10))
for i in range(10):
    xp=x0.copy(); xp[:,i]+=eps
    xm=x0.copy(); xm[:,i]-=eps
    d=(runx(xp)-runx(xm))/(2*eps)
    G[:,i]=d.mean(0)   # mean over batch
np.set_printoptions(precision=2,suppress=True,linewidth=200)
print("mean d out_j / d x_i  (rows class j, cols pos i)")
print(G)

