from numpy.linalg import lstsq
H=acts(X[:4000])
def posfeat(p):
    n,t=p.shape
    srt=np.argsort(-p,1)
    pm=srt[:,0]; p2=srt[:,1]
    M=p[np.arange(n),pm]; M2=p[np.arange(n),p2]
    OM=np.zeros((n,10)); OM[np.arange(n),pm]=1
    O2=np.zeros((n,10)); O2[np.arange(n),p2]=1
    # also value of x at each position relative to M
    return np.hstack([OM,O2,M[:,None],M2[:,None],p]), (pm,p2,M,M2)
for t in [3,5,10]:
    p=X[:4000,:t]; ht=H['h%d'%t]
    F,info=posfeat(p)
    A=np.hstack([F,np.ones((len(F),1))])
    c,_,_,_=lstsq(A,ht,rcond=None); pred=A@c
    r2=1-((ht-pred)**2).sum(0)/((ht-ht.mean(0))**2).sum(0)
    print("t",t,"mean R2",np.round(r2.mean(),3), np.round(r2,2))

