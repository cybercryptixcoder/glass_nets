h=acts(X[:2000])
def prefix_feats(x,t):
    p=x[:,:t]
    sp=np.sort(p,1)
    feats=[]
    for k in [1,2,3]:
        feats.append(sp[:,-k])
    feats.append(p.sum(1))
    feats.append((p>0).sum(1))
    feats.append(np.maximum(p,0).sum(1))
    feats.append(np.minimum(p,0).sum(1))
    feats.append(np.abs(p).max(1))
    return np.stack(feats,1)
for t in [1,2,3,5,8,10]:
    F=prefix_feats(X[:2000],t)
    ht=h['h%d'%t]
    # linear regression
    A=np.hstack([F,np.ones((len(F),1))])
    coef,res,rank,sv=np.linalg.lstsq(A,ht,rcond=None)
    pred=A@coef
    r2=1-((ht-pred)**2).sum(0)/((ht-ht.mean(0))**2).sum(0)
    print(t, "mean R2", np.round(r2.mean(),3), np.round(r2,2))

