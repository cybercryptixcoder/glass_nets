o = run(X)
F = np.zeros((len(X),36))
for p in range(6): F[np.arange(len(X)), p*6+X[:,p]] = 1
F1 = np.hstack([F, np.ones((len(X),1))])
coef, res, rank, sv = np.linalg.lstsq(F1, o, rcond=None)
pred = F1@coef
print("R2 per class", 1-((o-pred)**2).sum(0)/((o-o.mean(0))**2).sum(0))
# only position 5
for p in range(6):
    cols = [p*6+t for t in range(6)]+[36]
    c = np.linalg.lstsq(F1[:,cols], o, rcond=None)[0]
    pr = F1[:,cols]@c
    print("pos",p, "R2", np.round(1-((o-pr)**2).sum(0)/((o-o.mean(0))**2).sum(0),3))

