    s=s-s.max(-1,keepdims=True); e=np.exp(s); return e/e.sum(-1,keepdims=True)
def model(x, iv):
    B=x.shape[0]
    emb=E[x]+P
    v5=iv("tok5", np.eye(6)[x[:,5]][:,:5])
    row5=DE+v5@ME
    emb=np.concatenate([emb[:,:5],row5[:,None,:]],1)
    x1=emb+(sm(emb@S0@emb.transpose(0,2,1)*0.3535533905932738)@emb)@V0
    p1=sm(x1@S1@x1.transpose(0,2,1)*0.3535533905932738)
    r5=iv("pat1", p1[:,5,:5])
    p1=np.concatenate([p1[:,:5],np.concatenate([r5,(1.0-r5.sum(1))[:,None]],1)[:,None]],1)
    x2=x1+(p1@x1)@V1
    r1=iv("res1", x2[:,5,:5])
    last=np.concatenate([r1,x2[:,5,5:]],1)
    return last@U
