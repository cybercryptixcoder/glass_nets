def fwd_hard(tokens, Wd, hard_layers=(0,1)):
    x = Wd['W_E'][tokens] + Wd['W_pos'][None]
    for l in [0,1]:
        Q=x@Wd['L%d.W_Q'%l][0]; K=x@Wd['L%d.W_K'%l][0]; Vv=x@Wd['L%d.W_V'%l][0]
        s=Q@K.transpose(0,2,1)/np.sqrt(8)
        if l in hard_layers:
            idx=s.argmax(-1); p=np.zeros_like(s); np.put_along_axis(p, idx[...,None],1.0,-1)
        else:
            p=np.exp(s-s.max(-1,keepdims=True)); p/=p.sum(-1,keepdims=True)
        x = x + (p@Vv)@Wd['L%d.W_O'%l][0]
    return x[:,5]@Wd['W_U']
