def fwd(tokens, Wd):
    E = Wd['W_E'][tokens] + Wd['W_pos'][None]
    x = E
    for l in [0,1]:
        Q = x@Wd['L%d.W_Q'%l][0]; K = x@Wd['L%d.W_K'%l][0]; Vv = x@Wd['L%d.W_V'%l][0]
        s = Q@K.transpose(0,2,1)/np.sqrt(8)
        p = np.exp(s-s.max(-1,keepdims=True)); p/=p.sum(-1,keepdims=True)
        x = x + (p@Vv)@Wd['L%d.W_O'%l][0]
    return x[:,5]@Wd['W_U'], x

o2,_ = fwd(X[:20], W)
