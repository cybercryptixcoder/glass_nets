import numpy as np, itertools
X=np.array(list(itertools.product(range(5), repeat=5)))
B=len(X); P=5; V=5
def tok4(vals):
    out=np.zeros((B,P,4))
    for p in range(P):
        for t in range(4):
            out[:,p,t]=(vals[:,p]==t)
    return out.reshape(B,P*4)
def dec4(v4):
    a=v4.reshape(-1,P,4)
    s=a.sum(axis=2)
    d=a.argmax(axis=2)
    return np.where(s>0.5, d, 4)
def model(x):
    B=x.shape[0]
    tok=tok4(x)
    t=dec4(tok)
    a0=np.zeros((B,25))
    for i in range(P):
        a0[np.arange(B), i*V+t[:,i]]=1
    g=a0.reshape(-1,P,V).argmax(axis=2)
    o0t_raw=np.zeros_like(t)
    for i in range(P):
        o0t_raw[:,i]=t[np.arange(B), g[:,i]]
    o0=tok4(o0t_raw)
    o0t=dec4(o0)
    h=g.copy()
    for i in range(P):
        h[np.arange(B), g[:,i]]=o0t[:,i]
    seq=np.zeros((B,P,6),dtype=int)
    seq[:,:,0]=np.arange(P)
    for k in range(1,6):
        seq[:,:,k]=h[np.arange(B)[:,None], seq[:,:,k-1]]
    cl=np.zeros((B,P),dtype=int)
    for k in range(1,6):
        for j in range(k):
            m=(seq[:,:,k]==seq[:,:,j]) & (cl==0)
            cl=np.where(m,k-j,cl)
    longest=cl.max(axis=1)
    cls=np.zeros((B,5))
    cls[np.arange(B), longest-1]=1
    return cls,longest,t,g,o0t,h
cls,L,t,g,o,h=model(X)
