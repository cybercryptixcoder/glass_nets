import numpy as np, itertools
X=np.array(list(itertools.product(range(5), repeat=5)))
def onehot_vals(vals, n=5):
    B,P=vals.shape
    oh=np.zeros((B,P*n))
    for p in range(P):
        oh[np.arange(B), p*n+vals[:,p].astype(int)]=1
    return oh
def decode(oh,n=5):
    return oh.argmax(axis=1).reshape(-1,n)
def model(x):
    B=x.shape[0]
    tok=onehot_vals(x)
    t=decode(tok)
    # a0 targets
    a0=np.zeros((B,25))
    for i in range(5):
        a0[np.arange(B), i*5+t[:,i]]=1
    g=decode(a0)
    o0_vals=np.zeros_like(t)
    for i in range(5):
        o0_vals[:,i]=t[np.arange(B), g[:,i]]
    o0=onehot_vals(o0_vals)
    o0t=decode(o0)
    h=g.copy()
    for i in range(5):
        h[np.arange(B), g[:,i]]=o0t[:,i]
    seq=np.zeros((B,5,6),dtype=int)
    seq[:,:,0]=np.arange(5)
    for k in range(1,6):
        seq[:,:,k]=h[np.arange(B)[:,None], seq[:,:,k-1]]
    cl=np.zeros((B,5),dtype=int)
    for k in range(1,6):
        for j in range(k):
            m=(seq[:,:,k]==seq[:,:,j]) & (cl==0)
            cl=np.where(m,k-j,cl)
    longest=cl.max(axis=1)
    cls=np.zeros((B,5))
    cls[np.arange(B), longest-1]=1
    return cls, longest, t, g, o0_vals, h
cls,L,t,g,o,v,h=model(X)
# compute true longest cycle by direct iteration
true=[]
for row in X:
    best=0
    for s in range(5):
        seen={}
        cur=s;k=0
        while cur not in seen:
            seen[cur]=k; cur=row[cur]; k+=1
        best=max(best,k-seen[cur])
    true.append(best)
true=np.array(true)
print('acc', (L==true).mean(), 'maxdiff', np.abs(L-true).max())
print('class counts', np.bincount(L-1))

