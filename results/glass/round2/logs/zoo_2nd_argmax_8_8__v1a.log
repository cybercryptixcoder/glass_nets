import numpy as np

DESCRIPTION = ("Exact scaffold at full precision: h_t = relu(x_t*W_x + h_{t-1}@W_h) (8 units, no biases), "
               "decision = argmax of h_8@W_o. Mechanism notes measured so far: the input weights are "
               "essentially nonzero only on units {0,1,2,3,4,6}; units {1,6} are driven by x_t^+ and units "
               "{0,2,3,4} by x_t^-, so each step splits the current input into its positive and negative "
               "part. At step 1 only those units are alive; the relu is active for an increasing share of "
               "units as t grows (by t=8 nearly all units fire for almost every input), so the tail of the "
               "recurrence is a fixed linear map whose spectral radius is ~1.35 (complex eigenvalue pairs at "
               "angles ~39, 85, 133 deg) and the readout is a linear comparison of 8 class scores, class k "
               "reading mostly x_{k+1}. Margins are small (1% of inputs have top1-top2 < 0.005), so all 136 "
