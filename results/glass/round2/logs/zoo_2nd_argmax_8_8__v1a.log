index=[('h',i,j) for i in range(8) for j in range(8)]+[('o',i,j) for i in range(8) for j in range(7)]
cur=np.array([Wh_g[i,j] if t=='h' else W72[i,j] for (t,i,j) in index])
def build(v,par):
    WH=np.zeros((8,8)); W7=np.zeros((8,7))
    for n,(t,i,j) in enumerate(index):
        if t=='h': WH[i,j]=v[par[n]]
        else: W7[i,j]=v[par[n]]
    return WH,W7
par=list(range(len(cur)))
pairs=sorted(itertools.combinations(range(len(cur)),2), key=lambda ab: abs(cur[ab[0]]-cur[ab[1]]))[:1500]
Xs=X[:1500]; rs=r[:1500]; t0=time.time()
for step in range(13):
    best=None
    for a,b in pairs:
        if par[a]==par[b]: continue
        v=0.5*(cur[a]+cur[b]); p=par[:]
        pa,pb=par[a],par[b]
        for n in range(len(cur)):
            if p[n]==pb: p[n]=pa
        vv=np.arange(len(cur)); vv=v if False else None
        w=cur.copy(); w[a]=v; w[b]=v
        A=ag(Xs,rs,*build(w,p))
        if best is None or A>best[0]: best=(A,a,b,p)
    A,a,b,p=best; v=0.5*(cur[a]+cur[b]); cur[a]=v; cur[b]=v; par=p
    print(step+1,index[a],index[b],round(float(v),4),round(A,4),'full',round(ag(X,r,*build(cur,par)),4),round(time.time()-t0,1))
print('groups',len(set(par)))
np.save('/tmp/cur.npy',cur); np.save('/tmp/par.npy',np.array(par))

