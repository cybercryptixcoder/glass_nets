def ag2(x,rr,WH,W7): return (np.concatenate([np.zeros((x.shape[0],1)),fw(x,WH,W7,Wx_g)],1).argmax(1)==rr).mean()
print('agree refit full',ag2(X,r,WHr,W7r))
np.savez('/tmp/refit.npz',p=p,gmap=gmap,par=np.array(par))

