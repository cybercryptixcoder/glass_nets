Wx=W['W_x'].ravel().astype(np.float64); Wh=W['W_h'].astype(np.float64); Wo=W['W_o'].astype(np.float64)
r=run(X).argmax(1); o=run(X); D=o[:,1:]-o[:,0:1]
Htrue={t:acts(X)['h%d'%t] for t in [1,4,8]}
# mild gauge: normalize only the 6 substantial Wx entries
dd=np.ones(8); dd[[0,1,2,3,4,6]]=1.0/np.abs(Wx[[0,1,2,3,4,6]])
Wx_g=Wx*dd; Wh_g=(Wh/dd[:,None])*dd[None,:]; Wo_g=Wo/dd[:,None]; W72=Wo_g[:,1:]-Wo_g[:,0:1]
print('Wx_g',Wx_g.round(5),'range Wh',np.abs(Wh_g).min().round(5),np.abs(Wh_g).max().round(4),'range W7',np.abs(W72).max().round(3))
def fw(x,WH,W7,Wxr):
    h=np.zeros((x.shape[0],8))
    for t in range(8): h=np.maximum(x[:,t:t+1]*Wxr[None,:]+h@WH,0.0)
    return h@W7
def ag(x,rr,WH,W7,Wxr=Wx_g): return (np.concatenate([np.zeros((x.shape[0],1)),fw(x,WH,W7,Wxr)],1).argmax(1)==rr).mean()
