import numpy as np
o=run(X); dec=o.argmax(1)
T=X.shape[1]
def ema(x,w,rev=False):
    B,T=x.shape
    S=np.zeros_like(x)
    s=np.zeros(B)
    for t in range(T):
        j = T-1-t if rev else t
        s = s*w + x[:,j]
        S[:,j]=s
    return S
best=[]
for rev in [False,True]:
    for w in [0.2,0.4,0.6,0.7,0.8,0.85,0.9,0.95,1.0,1.05,1.1,1.2]:
        S=ema(X,w,rev)
        acc=(S.argmax(1)==dec).mean()
        best.append((acc,rev,w))
best.sort(reverse=True)
print(best[:8])
# also normalized by weight sum
for rev in [False,True]:
    for w in [0.5,0.7,0.85,1.0]:
        S=ema(X,w,rev)/(w**np.arange(T))[None,:] if not rev else ema(X,w,rev)/(w**np.arange(T))[::-1][None,:]
        print(rev,w,(S.argmax(1)==dec).mean())

