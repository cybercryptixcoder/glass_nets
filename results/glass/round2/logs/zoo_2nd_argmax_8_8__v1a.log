def model(x, iv):
    B = x.shape[0]
    p1 = iv("pos1", np.maximum(x[:, 0], 0.0))
    n1 = iv("neg1", np.maximum(-x[:, 0], 0.0))
    h = p1[:, None] * WP[None, :] + n1[:, None] * WN[None, :]
    for t in range(1, 8):
        h = np.maximum(h @ WH + x[:, t:t + 1] * WX[None, :], 0.0)
        h = iv("h%d" % (t + 1), h)
    d = h @ W7
    return np.concatenate([np.zeros((B, 1)), d], axis=1)

ALIGN = {"pos1": ["h1"], "neg1": ["h1"]}
ALIGN.update({"h%d" % t: ["h%d" % t] for t in range(2, 9)})

