import numpy as np
Xs=X[:2000]; Ds=D[:2000]
Hs=np.stack([acts(Xs)['h%d'%t] for t in range(1,9)])  # 8,B,8
sc=Hs.reshape(8,-1).std(1)[:,None,None]
gid={}
for n in range(len(cur)):
    gid.setdefault(par[n],len(gid))
G=len(gid); gmap=np.array([gid[par[n]] for n in range(len(cur))])
hi=np.array([index[n][1] for n in range(len(cur))]); hj=np.array([index[n][2] for n in range(len(cur))])
ish=np.array([index[n][0]=='h' for n in range(len(cur))])
p0=np.zeros(G)
for n in range(len(cur)): p0[gmap[n]]=cur[n]
def mats(p):
    WH=np.zeros((8,8)); W7=np.zeros((8,7))
    WH[hi[ish],hj[ish]]=p[gmap[ish]]; W7[hi[~ish],hj[~ish]]=p[gmap[~ish]]
    return WH,W7
def loss_grad(p,wst=1.0):
    WH,W7=mats(p); B=Xs.shape[0]
    h=[np.zeros((B,8))]; pre=[]
    for t in range(8):
        u=Xs[:,t:t+1]*Wx_g[None,:]+h[-1]@WH; pre.append(u); h.append(np.maximum(u,0.0))
    out=h[8]@W7
    L=((out-Ds)**2).mean()+wst*sum((((h[t+1]-Hs[t])/sc[t])**2).mean() for t in range(8))
    dOut=2*(out-Ds)/(B*Ds.size/ B)  # mean over B*7 -> 2*(out-D)/7/B
    dOut=2*(out-Ds)/(B*7)
    dW7=h[8].T@dOut; dh=dOut@W7.T
    for t in range(8):
        dh=dh+wst*2*(h[t+1]-Hs[t])/sc[t]**2/(B*8)
    dWH=np.zeros((8,8))
    for t in range(7,-1,-1):
        du=dh*(pre[t]>0)
        dWH+=h[t].T@du
        dh=du@WH.T
    gp=np.zeros(G)
    np.add.at(gp,gmap[ish],dWH[hi[ish],hj[ish]]); np.add.at(gp,gmap[~ish],dW7[hi[~ish],hj[~ish]])
    return L,gp
p=p0.copy(); m=np.zeros(G); v=np.zeros(G); lr=3e-3
