import numpy as np
np.set_printoptions(precision=3, suppress=True)
Wx=W['W_x'].ravel(); Wh=W['W_h'].copy(); Wo=W['W_o'].copy()
def fwd(X, wx, wh, wo):
    h=np.zeros((len(X),8))
    for t in range(8):
        h=np.maximum(X[:,t:t+1]*wx[None,:]+h@wh,0)
    return h@wo
o=run(X); dec=o.argmax(1)
def agree(wx,wh,wo):
    oo=fwd(X,wx,wh,wo); return (oo.argmax(1)==dec).mean(), oo
def lowrank(M,r):
    u,s,vt=np.linalg.svd(M); return (u[:,:r]*s[:r])@vt[:r]
for r in [1,2,3,4,5,6]:
    a,_=agree(Wx,lowrank(Wh,r),Wo); print('Wh rank',r,a)
for r in [1,2,3,4,5,6]:
    a,_=agree(Wx,Wh,lowrank(Wo,r)); print('Wo rank',r,a)

