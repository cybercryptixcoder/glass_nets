import numpy as np

DESCRIPTION = (
    "Exact reconstruction of the network's computation. A one-layer ReLU RNN with no biases: "
    "the state after step t is h_t = relu(x_t * W_x + h_(t-1) @ W_h), which is exactly what each "
    "hidden site holds, so the 8 sites are the 8 steps of one running recurrence. The readout is "
    "linear, out = h_8 @ W_o, and only the argmax matters, so the 8 class scores are written as "
    "differences from class 0 (one of the network's own readout invariances: adding a constant to "
    "all class scores changes no decision), i.e. 7 columns instead of 8. No unit, root or direction "
    "of the recurrence is redundant: the state is 8-dimensional and full rank, every hidden unit "
    "carries independent information at every step (unit 5 and unit 7 receive an input weight of "
    "about 0.003, i.e. essentially no direct input, and are driven only by the recurrence)."
)

