# diagonal readout: score_k=a_k H[k]  (identify permutation by matching correlation)
C=np.corrcoef(np.hstack([H,o]).T)[:8,8:]
perm=C.argmax(1)  # unit for each class
print('corr unit->class', perm, np.round(C.max(1),2))
for name,units in [('perm',perm),('ident',np.arange(8))]:
    Hh=H[:,units]
    aks=[np.dot(Hh[:,k],o[:,k])/np.dot(Hh[:,k],Hh[:,k]) for k in range(8)]
    sc=Hh*np.array(aks)
    print(name,'diag agree', (sc.argmax(1)==dec).mean())
