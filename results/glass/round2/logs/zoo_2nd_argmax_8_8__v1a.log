import numpy as np
np.set_printoptions(precision=2, suppress=True)
Wh=W['W_h']; Wx=W['W_x'].ravel(); Wo=W['W_o']
n=8
F=np.fft.fft(np.eye(n))/np.sqrt(n)
for name,Q in [('DFT',F),('DCT',None),('Hadamard',None)]:
    pass
def energy_offdiag(B,band=0):
    M=np.abs(B).copy()
    idx=np.arange(n)
    mask=np.abs(idx[:,None]-idx[None,:])>band
    return (M*mask).sum()/M.sum()
print('Wh offdiag frac', energy_offdiag(Wh))
B=F@Wh@F.conj().T
print('DFT basis |Wh|:'); print(np.abs(B))
print('offdiag frac in DFT basis', energy_offdiag(B,0))
# Hadamard
H=np.ones((1,1))
while H.shape[0]<8: H=np.block([[H,H],[H,-H]])
H=H/np.sqrt(8)
print('offdiag frac Hadamard', energy_offdiag(H@Wh@H.T,0))
print('offdiag frac random baseline')
rng=np.random.default_rng(0); R=rng.standard_normal((8,8))
print(energy_offdiag(R), energy_offdiag(F@R@F.conj().T,0))

