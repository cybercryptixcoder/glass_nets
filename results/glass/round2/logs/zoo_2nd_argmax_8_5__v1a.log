    cand[f"pmax{t}"]=pos[:,:t+1].max(1); cand[f"pmin{t}"]=pos[:,:t+1].min(1)
    cand[f"nmax{t}"]=neg[:,:t+1].max(1); cand[f"nmin{t}"]=neg[:,:t+1].min(1)
    cand[f"sump{t}"]=pos[:,:t+1].sum(1); cand[f"sumn{t}"]=neg[:,:t+1].sum(1)
    cand[f"x{t}"]=X[:,t]; cand[f"m1_{t}"]=X[:,:t+1].max(1); cand[f"m2_{t}"]=np.sort(X[:,:t+1],1)[:,-2] if t>=1 else X[:,0]
def r2_1d(v,y,nb=30):
    q=np.quantile(v,np.linspace(0,1,nb+1)); q[0]-=1e-9; q[-1]+=1e-9
    idx=np.digitize(v,q[1:-1])
    pred=np.zeros_like(y)
    for i in range(nb):
        m=idx==i
        if m.sum()>0: pred[m]=y[m].mean()
    return 1-((y-pred)**2).sum()/((y-y.mean())**2).sum()
for t in range(5):
    H=A[f"h{t+1}"]
    print("--- h%d"%t)
    for k in range(8):
        best=sorted(((r2_1d(v,H[:,k]),n) for n,v in cand.items()),reverse=True)[:3]
        print("  u%d"%k, [(n,round(s,3)) for s,n in best])

