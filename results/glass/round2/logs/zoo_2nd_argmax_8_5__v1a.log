import numpy as np
A=acts(X); h=[None]+[A[f"h{t}"] for t in range(1,6)]
Wh=W["W_h"]; Wx=W["W_x"].ravel()
def decayed_max(vals, g):
    # vals: [N,t] ; M_s = max(g*M_{s-1}, vals_s)
    M=vals[:,0].copy()
    for s in range(1,vals.shape[1]):
        M=np.maximum(g*M, vals[:,s])
    return M
def decayed_min(vals,g):
    return -decayed_max(-vals,g)
best={}
for t in [3,4,5]:
    Hprev=h[t-1]
    print("=== step",t)
    for k in [1,3,5,7]:
        th = -(Hprev@Wh[:,k])/Wx[k]
        res=[]
        for g in [1.0,0.95,0.9,0.8,0.7,0.5,0.3]:
            for nm,fn in [("max",decayed_max),("min",decayed_min)]:
                M = fn(X[:,:t-1], g)
                res.append((abs(np.corrcoef(th,M)[0,1]), round(np.corrcoef(th,M)[0,1],3), nm, g))
        res.sort(reverse=True)
        print("  u%d best:"%k, [(n,g,round(c,3)) for _,c,n,g in res[:3]])

