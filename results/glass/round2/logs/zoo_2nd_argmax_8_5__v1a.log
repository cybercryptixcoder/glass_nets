A=acts(X); h5=A["h5"]; out=run(X)
Xc=X
# features: rectified inputs and pairwise differences
def feats(x):
    F=[]
    names=[]
    for s in range(5):
        F.append(np.maximum(x[:,s],0)); names.append(f"p{s}")
        F.append(np.maximum(-x[:,s],0)); names.append(f"n{s}")
    for s in range(5):
        for r in range(5):
            if s!=r:
                F.append(np.maximum(x[:,s]-x[:,r],0)); names.append(f"d{s}{r}")
    return np.stack(F,1), names
Fp,names=feats(Xc)
print(Fp.shape)
# fit out (5 targets) from features, linear + intercept
Amat=np.c_[np.ones(len(Xc)),Fp]
coef,_,_,_=np.linalg.lstsq(Amat,out,rcond=None)
pred=Amat@coef
print("out R2", 1-((out-pred)**2).sum()/ ((out-out.mean(0))**2).sum())
print("decision acc from pairwise-lin", (pred.argmax(1)==out.argmax(1)).mean())
# fit h5
coefh,_,_,_=np.linalg.lstsq(Amat,h5,rcond=None)
ph=Amat@coefh
print("h5 R2 per unit", np.round(1-((h5-ph)**2).sum(0)/((h5-h5.mean(0))**2).sum(0),3))

