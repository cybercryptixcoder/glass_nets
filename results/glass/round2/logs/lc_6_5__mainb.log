def fit_comp(S, comps):
    N=len(tok); pred=np.zeros_like(S)
    for i in range(5):
        for j in range(5):
            Xd=[]
            if 'a' in comps: Xd.append(dum(tok[:,i])*0+ (dum(tok[:,i])[:,:,None]*dum(tok[:,j])[:,None,:]).reshape(N,25))
            if 'b' in comps: Xd.append(dum(tok[:,i])*0 + np.tile(0,0) if False else np.eye(25)[tok[:,i]*5+j])
            if 'c' in comps: Xd.append(np.eye(25)[i*5+tok[:,j]])
            if 'd' in comps: Xd.append(np.ones((N,1)))
            Xd=np.hstack(Xd)
            coef,_,_,_=np.linalg.lstsq(Xd,S[:,i,j],rcond=None)
            pred[:,i,j]=Xd@coef
    return pred
