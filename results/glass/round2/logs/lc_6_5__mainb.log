def fw2(WEx,Px,B0x,M0x,B1x,M1x,WUx,tok):
    e=WEx[tok]+Px[None]
    A0=sma(e@B0x@e.transpose(0,2,1)/np.sqrt(6.0))
    a0=A0@e@M0x; r0=e+a0
    A1=sma(r0@B1x@r0.transpose(0,2,1)/np.sqrt(6.0))
    a1=A1@r0@M1x; r1=r0+a1
