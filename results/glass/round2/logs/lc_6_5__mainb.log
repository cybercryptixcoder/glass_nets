# also one-hot per position of own token
def posfeats(tok):
    B=tok.shape[0]; cols=[]
    for i in range(5):
        oh=np.zeros((B,5)); oh[np.arange(B),tok[:,i]]=1; cols.append(oh)
    return np.concatenate(cols,1)
print('pos', fit_acc(posfeats(X),O,dec)[:2])
print('orbit+pos', fit_acc(np.concatenate([Fo,posfeats(X)],1),O,dec)[:2])

