def runM(B0f=B0,M0f=M0,B1f=B1,M1f=M1,WUf=WU,WEf=WE,WPf=WP):
    ee=WEf[tok]+WPf[None]
    p0=sm(ee@B0f@ee.transpose(0,2,1)/np.sqrt(6)); r0=ee+p0@(ee@M0f)
    p1=sm(r0@B1f@r0.transpose(0,2,1)/np.sqrt(6)); r1=r0+p1@(r0@M1f)
    return (r1[:,4]@WUf).argmax(1)
def trunc(M,r):
    U,s,Vt=np.linalg.svd(M,full_matrices=False); return (U[:,:r]*s[:r])@Vt[:r]
