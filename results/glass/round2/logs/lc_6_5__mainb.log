import numpy as np, collections
A=acts(X); p1=A['attn1.pattern'].reshape(-1,5,5)
N=len(X)
def props(x):
    seen={}; cur=4; t=0
    while cur not in seen:
        seen[cur]=t; cur=x[cur]; t+=1
    return seen[cur], t-seen[cur]
P=np.array([props(x) for x in X])
j1=p1[:,4].argmax(1)
tab=collections.defaultdict(collections.Counter)
for n in range(N): tab[(P[n,0],P[n,1])][j1[n]]+=1
for k in sorted(tab): print(k, dict(sorted(tab[k].items())))
# also mean p1 row4 per (tail,cycle)
for k in sorted(tab):
    m=(P[:,0]==k[0])&(P[:,1]==k[1])
    print(k, np.round(p1[m,4].mean(0),2))

