M0 = WV0 @ WO0
M1 = WV1 @ WO1

def sma(S):
    S = S - S.max(2, keepdims=True)
    A = np.exp(S); return A / A.sum(2, keepdims=True)

def model(x, iv):
    tok = np.asarray(x).astype(int)
    B = tok.shape[0]
    e = iv("embed", (WE[tok] + WP[None]).reshape(B, 30))
    E = e.reshape(B, 5, 6)
    A0 = sma(E @ WQ0 @ (E @ WK0).transpose(0, 2, 1) / np.sqrt(6.0))
    p0 = iv("pat0", A0.reshape(B, 25))
    o = iv("a0", (p0.reshape(B, 5, 5) @ E @ M0).reshape(B, 30))
    r0 = iv("r0", e + o)
    R0 = r0.reshape(B, 5, 6)
    A1 = sma(R0 @ WQ1 @ (R0 @ WK1).transpose(0, 2, 1) / np.sqrt(6.0))
    a1 = iv("a1", (A1 @ R0 @ M1).reshape(B, 30))
    r1 = iv("r1", r0 + a1)
    return r1.reshape(B, 5, 6)[:, 4, :] @ WU

