    q = E @ WQ; k = E @ WK; v = E @ WV
    s = q @ k.transpose(0, 2, 1) / np.sqrt(6.0)
    s = s - s.max(2, keepdims=True)
    A = np.exp(s); A = A / A.sum(2, keepdims=True)
    return A, A @ v @ WO

def model(x, iv):
    tok = np.asarray(x).astype(int)
    B = tok.shape[0]
    e = iv("embed", (WE[tok] + WP[None]).reshape(B, 30))
    E = e.reshape(B, 5, 6)
    A0, o0 = attn(E, WQ0, WK0, WV0, WO0)
    p0 = iv("pat0", A0.reshape(B, 25))
    A0 = p0.reshape(B, 5, 5)
    q = E @ WQ0; k = E @ WK0; v = E @ WV0
    o = iv("a0", (A0 @ v @ WO0).reshape(B, 30))
    r0 = iv("r0", e + o)
    R0 = r0.reshape(B, 5, 6)
    A1, _ = attn(R0, WQ1, WK1, WV1, WO1)
    p1 = iv("pat1", A1.reshape(B, 25))
    A1 = p1.reshape(B, 5, 5)
    q1 = R0 @ WQ1; k1 = R0 @ WK1; v1 = R0 @ WV1
    a1 = iv("a1", (A1 @ v1 @ WO1).reshape(B, 30))
    r1 = iv("r1", r0 + a1)
    return r1.reshape(B, 5, 6)[:, 4, :] @ WU

ALIGN = {"embed": ["embed"], "pat0": ["attn0.pattern"], "a0": ["attn0.out"],
         "r0": ["resid0.mid"], "pat1": ["attn1.pattern"], "a1": ["attn1.out"],
         "r1": ["resid1.mid"]}

