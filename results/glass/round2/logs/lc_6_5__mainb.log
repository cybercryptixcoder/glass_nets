import numpy as np, collections
o=run(X); dec=o.argmax(1)
N=len(X)
def graph_feats(x):
    # functional graph
    nxt=x
    CL=np.zeros(5,int); tail=np.zeros(5,int)
    for s in range(5):
        seen={}; cur=s; t=0
        while cur not in seen:
            seen[cur]=t; cur=nxt[cur]; t+=1
        tail[s]=seen[cur]; CL[s]=t-seen[cur]
    return CL,tail
CL=np.zeros((N,5),int); TL=np.zeros((N,5),int)
for n,x in enumerate(X):
    c,t=graph_feats(x); CL[n]=c; TL[n]=t
feats={
 'CL4':CL[:,4],'tail4':TL[:,4],'nfix':(X==np.arange(5)).sum(1),
 'nCL1':(CL==1).sum(1),'nCL2':(CL==2).sum(1),'nCL3':(CL==3).sum(1),'nCL4':(CL==4).sum(1),'nCL5':(CL==5).sum(1),
 'sumCL':CL.sum(1),'sumtail':TL.sum(1),
 'CL0':CL[:,0],'CL1':CL[:,1],'CL2':CL[:,2],'CL3':CL[:,3],
 'distinct_orbit':np.array([len(set([4,x[4],x[x[4]],x[x[x[4]]],x[x[x[x[4]]]]])) for x in X]),
}
def r2(s):
    D=np.stack([np.ones(N),s],1)
    coef,_,_,_=np.linalg.lstsq(D,o,rcond=None)
    pred=D@coef
    return 1-((o-pred)**2).sum()/((o-o.mean(0))**2).sum()
for k,v in feats.items(): print(k, round(r2(v),3), round((v==dec).mean(),3))

