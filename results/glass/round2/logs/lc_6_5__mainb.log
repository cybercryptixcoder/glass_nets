import numpy as np
o=run(X); a=np.argmax(o,1)
# test candidate rules
def rule(f): return np.array([f(x) for x in X])
for name,f in [("min",lambda x:x.min()),("max",lambda x:x.max()),
               ("mode",lambda x:np.bincount(x,minlength=5).argmax()),
               ("first",lambda x:x[0]),("last",lambda x:x[-1]),
               ("second",lambda x:x[1]),
               ("count0",lambda x:(x==0).sum()),("count1",lambda x:(x==1).sum()),
               ("ndiff",lambda x:len(set(x.tolist()))),
               ("lastdiff",lambda x: x[-1])]:
    r=rule(f)
    print(name, (r==a).mean())

