    A1=np.concatenate([Fm, np.ones((Fm.shape[0],1))],1)
    coef,_,_,_=np.linalg.lstsq(A1,y,rcond=None)
    pred=A1@coef
    return (pred.argmax(1)==dec).mean(), np.corrcoef(pred.ravel(),y.ravel())[0,1], coef
dec=O.argmax(1)
