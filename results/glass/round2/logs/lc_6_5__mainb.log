out = run(X)
print("decision counts", np.bincount(out.argmax(1), minlength=5))
# functional graph analysis: orbit of node 4
def features(row):
    x = list(row)
    # orbit from node 4
    seen={}; path=[]; n=4
    while n not in seen:
        seen[n]=len(path); path.append(n); n=x[n]
    cyc = path[seen[n]:]
    tail = path[:seen[n]]
    return len(cyc), len(tail)
F = np.array([features(r) for r in X])
print("cycle/tail counts", np.unique(F, axis=0, return_counts=True))
dec = out.argmax(1)
import collections
tab = collections.defaultdict(list)
for (c,t),d in zip(F,dec): tab[(c,t)].append(d)
for k in sorted(tab): 
