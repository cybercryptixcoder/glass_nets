def orbit_feats(tok):
    # tokens along orbit from position 4, 5 steps
    cur = tok[:,4]
    cols=[]
    for s in range(5):
        oh=np.zeros((tok.shape[0],5)); oh[np.arange(tok.shape[0]),cur]=1; cols.append(oh)
        cur = tok[np.arange(tok.shape[0]),cur]
    return np.concatenate(cols,1)  # 25 features
