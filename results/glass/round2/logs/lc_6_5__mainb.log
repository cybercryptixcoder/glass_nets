def fwd_proj(tok, Pi):
    Ep = WE@Pi; Pp = WP@Pi
    B0p = Pi.T@B0@Pi; M0p = Pi.T@M0@Pi; B1p = Pi.T@B1@Pi; M1p = Pi.T@M1@Pi; WUp = Pi.T@WU
    e = Ep[tok]+Pp[None]
    p0 = sm(e@B0p@e.transpose(0,2,1)/np.sqrt(6))
    r0 = e + p0@(e@M0p)
    p1 = sm(r0@B1p@r0.transpose(0,2,1)/np.sqrt(6))
    r1 = r0 + p1@(r0@M1p)
    return r1[:,4,:]@WUp, p0, p1
# basis choices
E25 = (WE[:,None,:]+WP[None,:,:]).reshape(25,6)   # all 25 e vectors
for name, basis in [("e-PCA", E25), ("E;P", np.vstack([WE,WP])), ("r0-act", None)]:
    if basis is None:
        continue
    U,s,Vt = np.linalg.svd(basis, full_matrices=False)
    for d in [3,4,5,6]:
        Pi = Vt[:d].T
        L,_,_ = fwd_proj(tok, Pi)
        print(name, d, "dec", round((L.argmax(1)==ref).mean(),4))

