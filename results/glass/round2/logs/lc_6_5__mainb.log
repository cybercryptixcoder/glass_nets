o=run(X); a=np.argmax(o,1)
cands={}
cands['sum%5']=X.sum(1)%5
cands['sum%4']=X.sum(1)%4
cands['count_max']=np.array([np.bincount(x,minlength=5).max() for x in X])
cands['pos_of_min']=np.array([x.argmin() for x in X])
cands['pos_of_max']=np.array([x.argmax() for x in X])
cands['n_ge']=np.array([(x>=x[-1]).sum()-1 for x in X])
cands['first_dup']=np.array([next((i for i in range(5) if (x[:i]==x[i]).any()),5) for x in X])
cands['n_repeat']=np.array([5-len(set(x.tolist())) for x in X])
for k,v in cands.items(): print(k, (v==a).mean())
# check dependence on last token only, or on first 4 only
for i in range(5):
    print("fixed pos",i, "unique classes", np.unique(a))
    # is decision determined by other 4 positions?
    d=(X[:,i:i+1])
    keys=[tuple(x) for x in np.delete(X,i,axis=1)]
    import collections
    m=collections.defaultdict(set)
    for kk,aa in zip(keys,a): m[kk].add(aa)
    print("  determined by rest?", all(len(s)==1 for s in m.values()), "nkeys",len(m))

