def build(y,a):
    G=np.concatenate([Wp+np.outer(m,y), a*m[:,None]],1)
    Gi=np.linalg.inv(G)
    return G,Gi
def mats(G,Gi):
    return dict(P=W_pos@G, B0=Gi@B0@Gi.T, M0=Gi@M0@G, B1=Gi@B1@Gi.T, M1=Gi@M1@G, U=Gi@WU)
def run_trunc(d, drop='row', Umode='row'):
    P=d['P'].copy(); B0x=d['B0'].copy(); M0x=d['M0'].copy(); B1x=d['B1'].copy(); M1x=d['M1'].copy(); Ux=d['U'].copy()
    if drop=='row':
        for Mx in (B0x,M0x,B1x,M1x): Mx[5,:]=0
        Ux[5,:]=0
    else:
        for Mx in (B0x,M0x,B1x,M1x): Mx[:,5]=0
        Ux[5,:]=0
    e=W_E[X]+P[X]   # this already has 6th coord zero for tokens
    A0=sma(e@B0x@e.transpose(0,2,1)/np.sqrt(6.0)); a0=A0@e@M0x; r0=e+a0
    A1=sma(r0@B1x@r0.transpose(0,2,1)/np.sqrt(6.0)); a1=A1@r0@M1x; r1=r0+a1
    return (r1[:,4,:]@Ux)
