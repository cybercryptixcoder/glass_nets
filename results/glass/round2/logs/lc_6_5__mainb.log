# full (no truncation) sanity in this basis
def run_full(d):
    e=W_E[X]+d['P'][X]
    A0=sma(e@d['B0']@e.transpose(0,2,1)/np.sqrt(6.0)); a0=A0@e@d['M0']; r0=e+a0
    A1=sma(r0@d['B1']@r0.transpose(0,2,1)/np.sqrt(6.0)); a1=A1@r0@d['M1']; r1=r0+a1
