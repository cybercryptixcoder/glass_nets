import collections
P1 = p1e[:,4,:]
# roles of each position j for query 4
def orbit(x):
    # returns list of tokens in the orbit from 4
    seq=[x[4]]; n=x[4]
    seen={4}
    while n not in seen:
        seen.add(n); seq.append(x[n]); n=x[n]
    return seq
roles = collections.defaultdict(list)
for n in range(len(tok)):
    x=tok[n]; o=orbit(x); s=set(o)
    for j in range(5):
        if j==0: r='pos0'
        elif j==4: r='pos4'
        elif tok[n,j] in s: r='orbit_tok'
        else: r='other'
        roles[r].append(P1[n,j])
for r in roles: print(r, len(roles[r]), round(np.mean(roles[r]),3))
