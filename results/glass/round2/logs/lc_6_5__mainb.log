import itertools
def feats_role(x):
    o=orbit(x); s=set(o); F=np.zeros((5,6))
    for j in range(5):
        F[j,0]=1.0
        F[j,1]=(j==0); F[j,2]=(j==4)
        F[j,3]= (j!=0 and j!=4 and tok[x,j] in s)
        F[j,4]= (j!=0 and j!=4 and tok[x,j]==x[4])
        F[j,5]= (j!=0 and j!=4 and tok[x,j]==x[x[4]])
    return F
