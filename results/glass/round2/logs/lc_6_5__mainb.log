from scipy.optimize import minimize
def nll(w):
    S = FR@w
    lp = S - np.log(np.exp(S).sum(1,keepdims=True))
    return -np.sum(lp*np.log(P1+1e-12))/len(P1)
w0=np.zeros(6)
r=minimize(nll,w0,method='Nelder-Mead',options={'maxiter':4000,'fatol':1e-8})
