import numpy as np
Wx=np.array([1.0,-1.0,-1.0,1.0]); P=np.array([1.0,0,0,1.0]); N=np.array([0,1.0,1.0,0])
Wh = np.array([[-0.213736534119, 1.273340361715,-0.069904836276, 2.318978878224],
               [ 5.417269176118, 1.320339441299,-0.533873623023,14.224694293973],
               [-4.427177187757,-1.289345995725, 0.530658245087,-14.462237823581],
               [-0.013221333672, 0.084671199711, 0.482564510760,-0.752541124821]])
D = np.array([[ 0.953772171334,-3.020182886703,-0.078624318557],
              [ 3.395878210871,-1.0              , 2.467857699874],
              [-4.659860812152,-0.616750965691,-4.124908772225],
              [-0.752398905547, 1.448382561829,-0.127842974292]])
def fwd(x,Wh=Wh,D=D):
    h=np.maximum(x[:,0:1],0)*P+np.maximum(-x[:,0:1],0)*N
    for t in range(1,4): h=np.maximum(x[:,t:t+1]*Wx+h@Wh,0)
    s=h@D; return np.column_stack([s[:,0],np.zeros(len(x)),s[:,1],s[:,2]])
ref=run(X).argmax(1)
def agree(Wh,D): return (fwd(X,Wh,D).argmax(1)==ref).mean()
# greedy: drop entries (set 0) or round to free values, one at a time
cur=Wh.copy(); Dc=D.copy(); print("full",agree(cur,Dc))
cands=[("Wh",i,j) for i in range(4) for j in range(4)]+[("D",i,j) for i in range(4) for j in range(3)]
for step in range(3):
    best=None
    for nm in cands:
        M=(cur if nm[0]=="Wh" else Dc).copy()
        M[nm[1],nm[2]]=0.0
        a=agree(cur if nm[0]!="Wh" else M, Dc if nm[0]=="Wh" else M)
        if best is None or a>best[0]: best=(a,nm,M)
    a,nm,M=best
    if nm[0]=="Wh": cur=M
    else: Dc=M
    print("drop",nm,"agree",round(a,4))

