I=np.eye(4)
def spanfit(M,basis):
    B=np.stack([b.ravel() for b in basis],1)
    c,res,_,_=np.linalg.lstsq(B,M.ravel(),rcond=None)
    pred=(B@c).reshape(4,4)
    return c, np.abs(pred-M).max(), np.linalg.norm(pred-M)/np.linalg.norm(M)
