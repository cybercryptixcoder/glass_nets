def opt(nkeep, iters=3000, seed=0):
    mag=np.abs(Dtrue); flat=sorted([(mag[i,c],i,c) for i in range(4) for c in range(3)])
    zeros=[(i,c) for _,i,c in flat[:12-nkeep]]
    keep=np.ones((4,3),bool)
    for i,c in zeros: keep[i,c]=False
