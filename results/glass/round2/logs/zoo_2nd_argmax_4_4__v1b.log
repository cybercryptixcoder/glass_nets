Wx=np.array([1.,-1,-1,1.]); Wh=W['W_h'].copy(); Wo=W['W_o'].copy()
def fwd_all(Xx,Wh,Wo):
    hs=[]; h=np.zeros((len(Xx),4))
    for t in range(4):
        h=np.maximum(Xx[:,t:t+1]*Wx+h@Wh,0); hs.append(h)
    return hs, h@Wo
