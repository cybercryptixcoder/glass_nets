base=np.zeros((4,4))
def unpack(p):
    W2=base.copy(); W2[mask]=p; return W2
def loss(p):
    W2=unpack(p); h=np.zeros((len(Xtr),4)); L=0
    for t in range(4):
        h=np.maximum(Xtr[:,t:t+1]*Wx+h@W2,0)
        L+= ((h-hs[t])**2).sum()
    return L
