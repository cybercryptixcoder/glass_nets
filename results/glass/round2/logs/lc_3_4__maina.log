import numpy as np
DESCRIPTION = "Attention-only transformer using composite QK and VO maps (attention scores depend only on QK^T and values only on V O, so the pairs collapse). Residual dim 3, 4 positions."

E = np.array([[-1.593979001045227,-0.9618171453475952,0.2582477033138275],
 [1.0295182466506958,0.8282491564750671,0.07643824815750122],
 [0.3151198923587799,0.942376434803009,0.4280821979045868],
 [1.303342580795288,0.17055730521678925,1.369555950164795]])
P = np.array([[0.8673731088638306,-0.7002357840538025,-0.6549220085144043],
 [-0.06621990352869034,-0.13180100917816162,2.992027997970581],
 [-4.174537181854248,1.2921202182769775,1.2030577659606934],
 [1.7988672256469727,1.4152004718780518,-0.1053674966096878]])
U = np.array([[12.902763366699219,-24.54276466369629,11.061068534851074,12.34278392791748],
 [2.914991617202759,-3.3876664638519287,0.24672181904315948,1.1435809135437012],
 [2.388655185699463,1.3247005939483643,-3.3412983417510986,-1.2613189220428467]])
QK0=np.array([[0.3233,-0.6832,0.1702],[-0.7763,-2.1876,2.504],[-4.8977,-2.8640,4.5893]])
VO0=np.array([[0.0304,-0.7735,0.1300],[1.0644,-0.1022,0.2457],[0.7457,1.1135,-0.1066]])
QK1=np.array([[0.4471,5.0893,0.4603],[-0.3384,-3.8714,-0.3667],[-0.4814,2.2049,6.5987]])
VO1=np.array([[-1.8793,1.5715,-1.8118],[0.0451,0.4417,-0.4049],[-0.1692,-9.8468,5.8460]])

def _sm(s):
    s = s - s.max(-1, keepdims=True)
    e = np.exp(s)
    return e / e.sum(-1, keepdims=True)

def model(x, iv):
    B = x.shape[0]
    emb = E[x] + P[None, :, :]
    e = iv("embed", emb.reshape(B, 12))
    h = e.reshape(B, 4, 3)
    p0 = _sm((h @ QK0) @ h.transpose(0, 2, 1) / np.sqrt(3.0))
    p0 = iv("p0", p0.reshape(B, 16)).reshape(B, 4, 4)
    ao = iv("ao", ((p0 @ h) @ VO0).reshape(B, 12)).reshape(B, 4, 3)
    h = h + ao
    r0 = iv("r0", h.reshape(B, 12)).reshape(B, 4, 3)
    h = r0
    p1 = _sm((h @ QK1) @ h.transpose(0, 2, 1) / np.sqrt(3.0))
    p1 = iv("p1", p1.reshape(B, 16)).reshape(B, 4, 4)
    a1 = iv("a1", ((p1 @ h) @ VO1).reshape(B, 12)).reshape(B, 4, 3)
    h = h + a1
    r1 = iv("r1", h.reshape(B, 12)).reshape(B, 4, 3)
    return r1[:, 3, :] @ U

ALIGN = {"embed": ["embed"], "p0": ["attn0.pattern"], "ao": ["attn0.out"],
         "r0": ["resid0.mid"], "p1": ["attn1.pattern"], "a1": ["attn1.out"],
         "r1": ["resid1.mid"]}

