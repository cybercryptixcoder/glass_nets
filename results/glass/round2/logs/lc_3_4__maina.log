cand("pos1",lambda x:x[1])
cand("pos2",lambda x:x[2])
def mode(x):
    c=Counter(x); m=max(c.values()); 
    for t in x:
        if c[t]==m: return t
    return 0
cand("mode_first",mode)
def mode_last(x):
    c=Counter(x); m=max(c.values())
    for t in x[::-1]:
        if c[t]==m: return t
    return 0
cand("mode_last",mode_last)
def least(x):
    c=Counter(x); m=min(c.values())
    for t in range(4):
        if c.get(t,0)==m: return t
    return 0
cand("least",least)
cand("summod4",lambda x: sum(x)%4)
cand("indexmax_val",lambda x: int(np.argmax(x)))
for pos in range(4):
    cand(f"max_occ_at{pos}",lambda x,pos=pos:x[pos] if Counter(x)[x[pos]]>1 else (x[pos]+1)%4)

