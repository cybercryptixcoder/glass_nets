import numpy as np

DESCRIPTION = ("Placeholder/direct construction: the recurrent network reads 8 inputs one at a time; "
               "the hidden state is ReLU(x_t W_x + h_{t-1} W_h) and the output is h_8 @ W_o (scores per class). "
               "First pass, exact recurrence with rounded weights, one variable per hidden state.")

WxL = [[-0.207, 0.03, -1.203, -0.151, -0.467, 0.003, 0.619, 0.004]]
WhL = [[0.082, 0.387, 0.74, -1.331, -0.646, 0.143, -0.323, 0.688],
       [-0.138, 0.48, -0.837, 0.094, 0.773, -1.2, -0.449, 1.909],
       [0.668, -0.155, 0.235, 0.036, 0.901, 1.754, 0.966, -0.52],
       [1.227, 1.953, -0.584, -0.671, -0.194, 0.97, 0.168, 0.114],
       [-0.318, -0.865, -0.451, 1.279, 0.272, -0.043, 0.537, -0.409],
       [-0.214, -0.023, -0.318, 1.098, -0.663, 0.785, 0.866, 0.614],
       [1.4, -0.115, 0.513, 0.33, 1.208, 0.588, 0.488, -1.103],
       [-0.246, 0.791, 0.033, 0.104, -0.245, 0.282, 1.816, -0.6]]
WoL = [[-0.852, -0.352, -0.243, -0.179, -0.558, -0.129, 2.122, -0.372],
       [0.679, 0.115, -0.05, -0.223, -1.256, -0.216, 0.363, 0.126],
       [-0.16, 0.072, -0.136, 0.155, 0.534, 0.167, 0.659, -4.45],
       [0.424, 0.023, 0.156, -0.199, -0.288, -2.593, 1.314, 0.045],
       [0.557, -0.003, 0.212, 0.173, 0.481, 0.865, -2.247, 0.268],
       [0.534, 0.334, 0.556, 0.275, -0.111, 0.244, -2.48, 0.344],
       [-0.433, -0.099, -0.448, 0.105, 0.707, 0.108, 0.027, -0.096],
       [-0.004, 0.011, 0.067, -0.658, 0.372, 0.029, -0.364, 0.013]]
Wx = np.array(WxL); Wh = np.array(WhL); Wo = np.array(WoL)

def model(x, iv):
    B = x.shape[0]
    h = np.zeros((B, 8))
    for t in range(8):
        z = np.outer(x[:, t], Wx[0]) + h @ Wh
        h = iv("h%d" % (t + 1), np.maximum(z, 0.0))
    return h @ Wo

ALIGN = {"h%d" % t: ["h%d" % t] for t in range(1, 9)}

