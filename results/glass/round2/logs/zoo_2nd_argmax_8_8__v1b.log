import numpy as np

DESCRIPTION = ("The recurrence is exactly relu(x_t W_x + h_{t-1} W_h); the output scores are h_8 @ W_o and the "
               "decision is the largest score. Each stage's variable is the hidden state at that step, computed "
               "from the previous state; the readout maps the last state to 8 class scores. Working copy: three "
               "negligible input weights are dropped (units 1,5,7 receive almost no direct input).")

Wx = np.array([-0.207, 0.0, -1.203, -0.151, -0.467, 0.0, 0.619, 0.0])
Wh = np.array([[0.082, 0.387, 0.74, -1.331, -0.646, 0.143, -0.323, 0.688],
       [-0.138, 0.48, -0.837, 0.094, 0.773, -1.2, -0.449, 1.909],
