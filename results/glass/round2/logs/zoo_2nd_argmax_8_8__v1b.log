# coordinate descent on a,b
best=(a.copy(),b.copy(),0)
rng=np.random.default_rng(0)
for it in range(3000):
    a2,b2 = best[0].copy(), best[1].copy()
    k=rng.integers(8)
    if rng.random()<.5: a2[k]+= rng.normal()*0.3
    else: b2[k]+= rng.normal()*0.3
    acc = ((a2*X+b2).argmax(1)==d).mean()
    if acc>best[2]: best=(a2,b2,acc)
print("best", best[2].round(3), best[0].round(2), best[1].round(2))

