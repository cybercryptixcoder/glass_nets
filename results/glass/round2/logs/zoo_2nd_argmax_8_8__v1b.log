    F = np.hstack([X[:,:t], np.ones((len(X),1))])
    B_,_,_,_ = np.linalg.lstsq(F, h, rcond=None)
    pred = F@B_
    r2 = 1-((h-pred)**2).sum(0)/((h-h.mean(0))**2).sum(0)
    print(t, "R2", r2.round(2))

