def flipC(q,p,k,lo=0.4,hi=0.5001):
    d0=lambda c: run(mkseq({q:1.0,p:0.5,k:c})[None,:])[0].argmax()
    if d0(lo)!=k: return ("err@lo",None)
    if d0(hi)==k: return ("noerr",1.0)
    for _ in range(24):
        m=(lo+hi)/2
        if d0(m)==k: lo=m
        else: hi=m
    return ("ok",(lo+hi)/2/0.5)
