    line=[]
    for r in [2,3,5,7,9,11,13,15]:
        P = V[:,:r]@V[:,:r].T
        hp = mu + (Ht-mu)@P
        line.append((r, round((run_from(hp,t,X).argmax(1)==pred).mean(),3)))
    print("site",t,line)

