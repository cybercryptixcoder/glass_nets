def run_from(h, t, Xb, Wh=Wh, Wo=Wo, Wx=Wx):
    B=Xb.shape[0]; hh=h.copy()
    for s in range(t,10):
        hh = np.maximum(Xb[:,s:s+1]*Wx + hh@Wh, 0)
    return hh@Wo
