import numpy as np
def slots(x):
    B,nn=x.shape
    Lv=np.full(B,-1e6); Lp=np.zeros(B,int); Av=np.full(B,-1e6); Ap=np.zeros(B,int)
    for t in range(nn):
        xt=x[:,t]; above=xt>Lv; sec=xt>Av
        nAv=np.where(above,Lv,np.where(sec,xt,Av)); nAp=np.where(above,Lp,np.where(sec,t,Ap))
        Lv=np.where(above,xt,Lv); Lp=np.where(above,t,Lp); Av=nAv; Ap=nAp
    return Lv,Lp,Av,Ap
Lv,Lp,Av,Ap=slots(X)
O=run(X)
def onehot(v,n=10):
    M=np.zeros((len(v),n)); M[np.arange(len(v)),v]=1; return M
P=onehot(Ap); Q=onehot(Lp)
feats=[P,Q,P*Av[:,None],Q*Lv[:,None],Av[:,None],Lv[:,None],np.ones((len(Ap),1))]
F=np.hstack(feats)
coef,res,rank,sv=np.linalg.lstsq(F,O,rcond=None)
pred=F@coef
print("R2 per class:", np.round(1-((O-pred)**2).sum(0)/((O-O.mean(0))**2).sum(0),3))
# compare simplified: only onehot(p), onehot(q) scaled by nothing
F2=np.hstack([P,Q,np.ones((len(Ap),1))]); c2=np.linalg.lstsq(F2,O,rcond=None)[0]; p2=F2@c2
print("R2 simple:", np.round(1-((O-p2)**2).sum(0)/((O-O.mean(0))**2).sum(0),3))
print("decision match simple:", (p2.argmax(1)==O.argmax(1)).mean())
# bigger feature set: also 3rd slot? check top-3 info

