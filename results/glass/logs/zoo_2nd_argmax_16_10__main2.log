import numpy as np
def mkseq(pairs, base=0.001):
    s=np.full(10,base)
    for p,v in pairs: s[p]=v
    return s
def flip(i,j):
    # bisect on f in (0.9,1) where decision changes from j (correct) to i
    lo,hi=0.9,1.0
    o=run(mkseq([(i,1.0),(j,lo)])[None,:])[0].argmax()
    if o!=j: return None,o
    o=run(mkseq([(i,1.0),(j,hi)])[None,:])[0].argmax()
    if o==j: return 1.0,o
    for _ in range(25):
        m=(lo+hi)/2
        if run(mkseq([(i,1.0),(j,m)])[None,:])[0].argmax()==j: lo=m
        else: hi=m
    return (lo+hi)/2, None
for (i,j) in [(0,1),(0,2),(0,5),(0,7),(0,9),(2,8),(2,9),(5,9),(6,0),(9,0),(1,5),(3,8),(4,7),(6,2),(9,4),(5,6),(1,9)]:
    f,tag=flip(i,j)
    print(f"max@{i} 2nd@{j}: boundary f={f}")

