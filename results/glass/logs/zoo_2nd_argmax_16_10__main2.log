        L = np.where(np.abs(Wx)>1.0, -c/Wx, np.nan)
        print(t, "ht>0 units", np.where(ht>0)[0], "L(1,4,6,7,8)", np.round(L[[1,4,6,7,8]],3), "c others", np.round(c[[0,2,3,5,9,10,11,12,13,14,15]],2))

