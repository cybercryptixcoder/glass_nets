def sim_smooth(Xb, k=1.0, ka=1.0):
    B=Xb.shape[0]
    L=np.full(B,-1e9); pL=np.zeros(B,int); A=np.full(B,-1e9); pA=np.zeros(B,int)
    for t in range(10):
        x=Xb[:,t]
        up1 = x > L
        # demote
        A=np.where(up1, L, A); pA=np.where(up1, pL, pA)
        L=np.where(up1, L + k*(x-L), L); pL=np.where(up1, t, pL)
        up2 = (~up1) & (x > A)
        A=np.where(up2, A + ka*(x-A) if False else x, A); pA=np.where(up2, t, pA)
    return pA
for k in [1.0,0.95,0.9,0.8,0.7,0.5,0.3]:
    p=sim_smooth(X,k)
    print("k",k,"agree",round((p==pnet).mean(),4),"repro",round((p[wrong0]==pnet[wrong0]).mean(),3))

