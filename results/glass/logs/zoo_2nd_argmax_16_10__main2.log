import numpy as np
netdec = run(X).argmax(1)
n=X.shape[0]
def scan_pred(x, rl, ra):
    B,nn=x.shape
    Lv=np.full(B,-1e6); Lp=np.zeros(B); Av=np.full(B,-1e6); Ap=np.zeros(B)
    for t in range(nn):
        Lv=Lv*rl; Av=Av*ra
        xt=x[:,t]
        above=xt>Lv; sec=xt>Av
        nAv=np.where(above,Lv,np.where(sec,xt,Av)); nAp=np.where(above,Lp,np.where(sec,float(t),Ap))
        Lv=np.where(above,xt,Lv); Lp=np.where(above,float(t),Lp); Av=nAv; Ap=nAp
    return Ap.astype(int)
# exact second max rule (ties -> last)
def exact(x):
    B,nn=x.shape
    out=np.zeros(B,int)
    o2=x.copy()
    idx=np.argsort(-o2,axis=1)
    # second largest tie->last: sort by (-value, -index)
    key=[( -x[i], -np.arange(nn)) for i in range(0)]
    # simple loop:
    for i in range(B):
        v=x[i]; j=int(np.lexsort((-np.arange(nn), -v))[1]); out[i]=j
    return out
ex=exact(X)
print("net vs exact:", (netdec==ex).mean())
print("net exact-mistake count:", (netdec!=ex).sum())

