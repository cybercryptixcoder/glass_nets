def rule2(Xb, d1=0.0, d2=0.0):
    B=Xb.shape[0]
    L=np.full(B,-1e9); pL=np.zeros(B,int); A=np.full(B,-1e9); pA=np.zeros(B,int)
    for t in range(10):
        x=Xb[:,t]
        up1 = x > L + d1
        A=np.where(up1, L, A); pA=np.where(up1, pL, pA)
        L=np.where(up1, x, L); pL=np.where(up1, t, pL)
        up2 = (~up1) & (x >= A + d2)
        A=np.where(up2, x, A); pA=np.where(up2, t, pA)
    return pA
