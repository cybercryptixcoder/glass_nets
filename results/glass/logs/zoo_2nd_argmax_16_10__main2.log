import numpy as np
def mkseq(d):
    s=np.full(10,0.001)
    for p,v in d.items(): s[p]=v
    return s
def flip(q,p,k,A=0.5,L=1.0):
    d=lambda c: run(mkseq({q:L,p:A,k:c})[None,:])[0].argmax()
    lo,hi=0.47,A
    if d(lo)==k: return ("err@lo",None)
    if d(hi)!=k: return ("noflip",None)
    for _ in range(26):
        m=(lo+hi)/2
        if d(m)==k: hi=m
        else: lo=m
    return ("ok",(lo+hi)/2/A)
