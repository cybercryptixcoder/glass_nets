def explained(V, Ht):
    V = np.hstack([V, np.ones((V.shape[0],1))])
    beta, *_ = np.linalg.lstsq(V, Ht, rcond=None)
    res = ((Ht - V@beta)**2).sum()
    tot = ((Ht - Ht.mean(0))**2).sum()
    return 1-res/tot
for t in [2,3,5,7,10]:
    pre = X[:,:t]
    L = pre.max(1)
    u = np.minimum(pre, L[:,None])       # demoted scores
    s1 = pre
    s4 = np.hstack([u, L[:,None]])
    s5 = np.hstack([np.maximum(L[:,None]-pre,0), L[:,None], np.maximum(pre-L[:,None],0)])
    print(t, "rawprefix", round(explained(s1,H[t]),3), "demoted", round(explained(s4,H[t]),3), "relu-level", round(explained(s5,H[t]),3))

