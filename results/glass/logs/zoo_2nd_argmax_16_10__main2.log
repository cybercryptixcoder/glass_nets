import numpy as np
def mkseq(pairs, base=0.001):
    s=np.full(10,base)
    for p,v in pairs: s[p]=v
    return s
def flip(i,j,Amax,base=0.001):
    lo,hi=0.5,1.0
    d=lambda f: run(mkseq([(i,Amax),(j,f*Amax)],base)[None,:])[0].argmax()
    if d(lo)!=j: return None
    if d(hi)==j: return 1.0
    for _ in range(22):
        m=(lo+hi)/2
        if d(m)==j: lo=m
        else: hi=m
    return (lo+hi)/2
