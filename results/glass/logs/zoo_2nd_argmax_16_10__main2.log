import numpy as np
def slots(x, rl=1.0, ra=1.0):
    B,nn=x.shape
    Lv=np.full(B,-1e6); Lp=np.full(B,-1); Av=np.full(B,-1e6); Ap=np.full(B,-1)
    for t in range(nn):
        Lv=Lv*rl; Av=Av*ra
        xt=x[:,t]; above=xt>Lv; sec=xt>Av
        nAv=np.where(above,Lv,np.where(sec,xt,Av)); nAp=np.where(above,Lp,np.where(sec,t,Ap))
        Lv=np.where(above,xt,Lv); Lp=np.where(above,t,Lp); Av=nAv; Ap=nAp
    return Lv,Lp,Av,Ap
