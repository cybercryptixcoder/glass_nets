M1=X[np.arange(len(X)),srt[:,0]]; M2=X[np.arange(len(X)),srt[:,1]]; M3=X[np.arange(len(X)),srt[:,2]]
k3=srt[:,2]
mis=netdec!=p0
for c in [0.002,0.005,0.01,0.02,0.03,0.05,0.08]:
    pred=np.where((M2-M3)<c*M2, k3, p0)
    print(f"c={c}: acc={(pred==netdec).mean():.4f} rep={(pred[mis]==netdec[mis]).mean():.3f}")
# also: fraction of the mismatch cases where netdec==k3
print("netdec==k3 among mismatches:", (netdec[mis]==k3[mis]).mean())
print("netdec==Lp among mismatches:", (netdec[mis]==Lp[mis]).mean())

