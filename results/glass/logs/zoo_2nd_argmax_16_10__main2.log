import numpy as np
def mkseq(pairs, base=0.001):
    s=np.full(10,base)
    for p,v in pairs: s[p]=v
    return s
def flip(i,j,A=1.0,lo=0.99,hi=1.0001):
    d=lambda f: run(mkseq([(i,A),(j,f*A)])[None,:])[0].argmax()
    if d(lo)!=j: return ("err at lo",None)
    if d(hi)==j: return ("no err",1.0)
    for _ in range(26):
        m=(lo+hi)/2
        if d(m)==j: lo=m
        else: hi=m
    return ("ok",(lo+hi)/2)
print("adjacent pairs f*(i,i+1):")
for i in range(9):
    print(i, flip(i,i+1))
print("reverse (i+1,i):")
for i in range(9):
    print(i, flip(i+1,i))

