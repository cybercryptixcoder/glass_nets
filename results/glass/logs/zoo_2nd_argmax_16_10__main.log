def r2(y,H):
    Hc=np.hstack([H,np.ones((len(H),1))])
    coef,res,rank,sv=np.linalg.lstsq(Hc,y,rcond=None)
    pred=Hc@coef
    return 1-((y-pred)**2).sum()/((y-y.mean())**2).sum()
cands={}
cs=np.cumsum(X,1)
for k in range(10):
    cands['x%d'%k]=X[:,k]
    cands['cs%d'%k]=cs[:,k]
cands['nsignpos']=(X>0).sum(1).astype(float)
cands['sumabs']=np.abs(X).sum(1)
for t in [1,3,5,10]:
    H=A['h%d'%t]
    r={k:round(r2(v,H),3) for k,v in cands.items()}
    top=sorted(r.items(),key=lambda kv:-kv[1])[:8]
    print(t,top)

