def rule1(X,a,b,L0=-99.0,S0=-99.0):
    n=len(X); L=np.full(n,L0); S=np.full(n,S0); p=np.zeros(n,dtype=int); i1=np.zeros(n,dtype=int)
    for t in range(10):
        xt=X[:,t]
        nm=xt>L+a
        S=np.where(nm,L,S); p=np.where(nm,i1,p)
        i1=np.where(nm,t,i1); L=np.where(nm,xt,L)
        up=(~nm)&(xt>S+b)
        S=np.where(up,xt,S); p=np.where(up,t,p)
    return p
def rule2(X,delta):
    q=np.round(X/delta)
    # second largest with ties->earliest
    out=np.zeros(len(X),dtype=int)
    for k in range(len(X)):
        r=q[k]; s=np.sort(r)[::-1]; v=s[1]; out[k]=int(np.argmax(r==v))
    return out
