def jac(x,eps=1e-4):
    x=np.asarray(x,float).reshape(1,10)
    o0=run(x)[0]
    J=np.zeros((10,10))
    for t in range(10):
        d=np.zeros((1,10)); d[0,t]=eps
        J[:,t]=(run(x+d)[0]-run(x-d)[0])/(2*eps)
    return o0,J
