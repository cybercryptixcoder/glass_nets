def model(x, iv):
    x=np.asarray(x,dtype=float); Bx=x.shape[0]
    pos=iv("u1",np.maximum(x[:,0],0.0)); neg=iv("v1",np.maximum(-x[:,0],0.0))
    h=pos[:,None]*AP+neg[:,None]*AN
    h=np.maximum(x[:,1:2]*WX+h@WH,0.0)
    u2=iv("u2",np.maximum(x[:,1],0.0)); v2=iv("v2",np.maximum(-x[:,1],0.0))
    for t in range(2,10):
        h=np.maximum(x[:,[t]]*WX+h@WH,0.0)
        h=iv("h%d"%(t+1),h)
    return h@WO
