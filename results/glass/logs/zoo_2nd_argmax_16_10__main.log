from sklearn.ensemble import ExtraTreesRegressor
Xs=X[:3000]; A4=acts(Xs)
def feats(t):
    pref=Xs[:,:t+1]
    srt=np.argsort(-pref,1)
    M=np.take_along_axis(pref,srt[:,:1],1); N=np.take_along_axis(pref,srt[:,1:2],1)
    p1=srt[:,0]; p2=srt[:,1]
    return np.hstack([M,N,np.eye(10)[p1],np.eye(10)[p2]])
for t in [2,4,6,9]:
    H=A4['h%d'%(t+1)]
    F=feats(t)
    m=ExtraTreesRegressor(n_estimators=50,min_samples_leaf=2,n_jobs=-1,random_state=0).fit(F,H)
    pred=m.predict(F)
    r=1-((H-pred)**2).sum(0)/((H-H.mean(0))**2).sum(0)
    print(t+1, np.round(r,2))

