def expl(F):
    F=np.hstack([F,np.ones((len(F),1))]); tot=0
    for i in range(16):
        y=h2[:,i]; c=lstsq(F,y,rcond=None)[0]; p=F@c
        tot+=1-((y-p)**2).sum()/((y-y.mean())**2).sum()
    return tot/16
