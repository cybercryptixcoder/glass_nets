import numpy as np
Wx=W['W_x']; Wh=W['W_h']; Wo=W['W_o']
def fwd(Xc,Wx,Wh,Wo):
    h=np.zeros((Xc.shape[0],4))
    for t in range(4):
        h=np.maximum(Xc[:,t:t+1]*Wx.ravel()[None,:]+h@Wh,0)
    return h@Wo
base=run(X); yb=base.argmax(1)
def ag(Wx2,Wh2,Wo2):
    return np.mean(fwd(X,Wx2,Wh2,Wo2).argmax(1)==yb)
