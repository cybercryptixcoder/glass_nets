# max-tracking test: perturb a middle value downward below running max
rng=np.random.default_rng(0)
idx=rng.choice(8000,200,replace=False)
base=acts(X[idx])['h8']
Xp=X[idx].copy()
for i in range(len(idx)):
    t=rng.integers(1,7)
    mx=Xp[i,:t].max()
    Xp[i,t]=mx-abs(rng.normal())-0.1
new=acts(Xp)['h8']
chg=np.abs(new-base).max(1)
print("fraction with tiny change (<1e-6):",(chg<1e-6).mean(), "median abs change", np.median(chg).round(3), "median |h8|",np.median(np.abs(base)).round(2))

