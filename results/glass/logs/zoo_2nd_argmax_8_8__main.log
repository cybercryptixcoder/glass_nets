import numpy as np
# linear fit out ~ x
A=np.hstack([X,np.ones((len(X),1))])
coef,res,rk,sv=np.linalg.lstsq(A,y,rcond=None)
pred=A@coef
print("R2 linear:", 1-((y-pred)**2).sum(0)/((y-y.mean(0))**2).sum(0))
print(coef[:8].round(2))
# quadratic terms
from itertools import combinations_with_replacement as cwr
feats=[X[:,i]*X[:,j] for i,j in cwr(range(8),2)]
B=np.hstack([X]+feats+[np.ones((len(X),1))])
c2=np.linalg.lstsq(B,y,rcond=None)[0]
p2=B@c2
print("R2 quad:", 1-((y-p2)**2).sum(0)/((y-y.mean(0))**2).sum(0))

