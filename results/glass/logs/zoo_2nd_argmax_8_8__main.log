import numpy as np
np.set_printoptions(precision=2, suppress=True, linewidth=200)
H=acts(X)
# exact linear (all-active) prediction of h_t = sum_s x_s u_{t-s}
Wx=W['W_x'][0]; Wh=W['W_h']
u=[Wx]; 
for k in range(8): u.append(u[-1]@Wh)
U=np.array(u)
for t in [4,8]:
    pred=np.zeros((len(X),8))
    for s in range(t):
        pred+=X[:,s][:,None]*U[t-1-s][None,:]
    err=np.abs(pred-H['h%d'%t])
    act=(H['h%d'%t]>1e-9)
    print(t,'err on all-active samples med',np.median(err.max(1)).round(2),'frac<1e-6',(err.max(1)<1e-6).mean().round(3))

