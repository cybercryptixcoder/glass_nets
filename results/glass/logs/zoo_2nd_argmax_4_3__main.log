import numpy as np
A=acts(X); o=run(X); dec=np.argmax(o,1)
g=np.array([3.9653,4.6995,-4.7163,-3.9652])
C1=np.array([-0.2780,1.6167,0.2178,-2.4174]); C2=np.array([-0.2274,2.1552,0.1764,-2.6103])
flip=np.array([1.,-1.,1.,-1.]); CT=np.stack([C1,C2,C2*flip,C1*flip])
P=np.array([1.0,9.9347,-9.7727]); T=np.array([1.0352,1.1725,0.7286])
def build(x):
    p1=np.maximum(x[:,0],0); n1=np.maximum(-x[:,0],0)
    u=np.stack([g[0]*p1,g[1]*p1,-g[2]*n1,-g[3]*n1],1)
    for t in [1,2]:
        ms=np.stack([u[:,0]+u[:,3],u[:,0]-u[:,3],u[:,1]+u[:,2],u[:,1]-u[:,2]],1)
        u=np.maximum(ms@CT.T + x[:,t:t+1]*g,0)
    return u
u=build(X); m1=u[:,0]+u[:,3]; m2=u[:,1]+u[:,2]
sc=np.stack([P[k]*(m2-T[k]*m1) for k in range(3)],1)
print('agree',(np.argmax(sc,1)==dec).mean())
print('R2',1-((sc-o)**2).sum()/((o-o.mean(0))**2).sum())
# literal match check vs weights, tolerance 1.5%
ws=np.concatenate([W['W_x'].ravel(),W['W_h'].ravel(),W['W_o'].ravel()])
lits=[3.9653,4.6995,4.7163,3.9652,-0.2780,1.6167,0.2178,2.4174,-0.2274,2.1552,0.1764,2.6103,1.0,9.9347,9.7727,1.0352,1.1725,0.7286]
m=[(l,ws[np.abs(ws-l).argmin()],abs(ws[np.abs(ws-l).argmin()]-l)/abs(ws[np.abs(ws-l).argmin()])) for l in lits]
for l,w,d in m: print('%8.4f nearest %8.4f  %.4f'%(l,w,d))

