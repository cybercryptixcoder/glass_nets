import numpy as np
A=acts(X); o=run(X); dec=np.argmax(o,1)
a,b=3.9653,4.6995
C1=np.array([-0.2780,1.6167,0.2178,-2.4174])
C2=np.array([-0.2274,2.1552,0.1764,-2.6103])
W0=np.array([-1.66465,-18.73600,11.45370]); W1=np.array([1.60840,15.97925,-15.71880])
def build(x):
    p1=np.maximum(x[:,0],0); n1=np.maximum(-x[:,0],0)
    v1=a*(p1-n1); v2=b*(p1-n1); m1=a*(p1+n1); m2=b*(p1+n1)
    hs={'h1':(p1,n1,v1,v2,m1,m2)}
    for k,t in enumerate([1,2]):
        pre1=C1@np.stack([m1,v1,m2,v2])+a*x[:,t]
        pre2=C2@np.stack([m1,v1,m2,v2])+b*x[:,t]
        v1,v2=pre1,pre2; m1,m2=abs(v1),abs(v2)
        hs['h%d'%(k+2)]=(np.maximum(v1,0),np.maximum(-v1,0),v1,v2,m1,m2)
    return hs
