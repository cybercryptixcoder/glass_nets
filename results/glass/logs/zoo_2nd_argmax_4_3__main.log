import numpy as np
A = acts(X)
def dec(H):
    pos = H[:,0]>0
    s1 = np.where(pos, H[:,0]/3.9653, -H[:,3]/3.9652)
    s2 = np.where(pos, H[:,1]/4.6995, -H[:,2]/4.7163)
    return s1,s2,pos
for s in ['h1','h2','h3']:
    a,b,p = dec(A[s])
    print(s,'branch frac',p.mean(),'corr s1 s2', np.corrcoef(a,b)[0,1], 'max|s1-s2|', np.abs(a-b).max())
    print(' s1 head',np.round(a[:6],3),' s2 head',np.round(b[:6],3))
print('x cols:')
print(np.round(X[:6],3))

