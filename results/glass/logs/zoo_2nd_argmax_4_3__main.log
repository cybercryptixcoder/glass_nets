import numpy as np
rng=np.random.default_rng(0)
P = rng.normal(size=(3000,3))*1.5
d = acts(P)
def grad_at(site, eps=1e-5):
    G=[]
    for k in range(3):
        e=np.zeros(3); e[k]=eps
        D = (acts(P+e)[site]-acts(P-e)[site])/(2*eps)
        G.append(D)
    return np.stack(G,axis=1)  # [N,3,4]
for site in ['h1','h2','h3']:
    G=grad_at(site)
    bases = rng.choice(3000,size=1500,replace=False)
    flat = G[bases].reshape(-1,4)  # rows: point*3
    # normalize each row for pattern clustering
    from sklearn.cluster import KMeans
    nrm = np.linalg.norm(flat,axis=1,keepdims=True)
    keep = nrm[:,0]>1e-3
    F = flat[keep]/nrm[keep]
    km=KMeans(8,n_init=5,random_state=0).fit(F)
    print(site, 'clusters', np.bincount(km.labels_), 'unique grad dirs (unit-scale):')
    for c in range(8):
        idx = np.where(km.labels_==c)[0]
        if len(idx)<10: continue
        print('  n=%d'%len(idx), np.round(flat[keep][idx].mean(0),3), 'norm', np.round(nrm[keep][idx,0].mean(),3))

