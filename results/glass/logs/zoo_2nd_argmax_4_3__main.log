import numpy as np
rng=np.random.default_rng(0)
P = rng.normal(size=(2000,3))*1.5
def grad_at(site, eps=1e-5):
    G=[]
    for k in range(3):
        e=np.zeros(3); e[k]=eps
        D = (acts(P+e)[site]-acts(P-e)[site])/(2*eps)
        G.append(D)
    return np.stack(G,axis=1)  # [N,3,4]
for site in ['h2','h3']:
    G=grad_at(site)
    M = G.reshape(-1,4)   # rows ordered k-major
    coord = np.tile(np.arange(3),2000)
    flat=np.round(M,2)
    uniq,counts=np.unique(np.concatenate([flat,coord[:,None]],axis=1),axis=0,return_counts=True)
    order=np.argsort(-counts)
    print('=====',site)
