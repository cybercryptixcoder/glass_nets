    return np.stack([H[:,0]-H[:,3], H[:,1]-H[:,2]],1)
V1=vs(A['h1']); V2=vs(A['h2']); V3=vs(A['h3'])
# fit linear v2 = A v1 + g x2
def fit(Vp, x, Vn):
    Z=np.concatenate([Vp, x[:,None]],1)
    B,res,rank,sv=np.linalg.lstsq(Z,Vn,rcond=None)
    return B, np.abs(Z@B-Vn).mean(), 1-((Z@B-Vn)**2).sum()/((Vn-Vn.mean(0))**2).sum()
