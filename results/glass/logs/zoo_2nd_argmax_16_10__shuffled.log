a=acts(X)
base=run(X).argmax(1)
def hook_run(A, site, mode, k):
    H=a[site]
    Hc=H-H.mean(0)
    U,S,Vt=np.linalg.svd(Hc,full_matrices=False)
    P=Vt[:k].T@Vt[:k]
    if mode=='keep': Hn=Hc@P + H.mean(0)  # keep named subspace (plus mean)
    elif mode=='keep0': Hn=Hc@P
    elif mode=='remove': Hn=Hc@(np.eye(16)-P)+H.mean(0)
    elif mode=='remove0': Hn=Hc@(np.eye(16)-P)
    # continue forward
    t=int(site[1:]); h=Hn
    for s in range(t,10):
        h=np.maximum(X[:,s:s+1]*W['W_x']+h@W['W_h'],0)
    return (h@W['W_o']).argmax(1)
for site in ['h5','h8','h10']:
    for k in [1,2,4]:
