def r2(feat, target):
    # linear regress target on feat
    F=np.column_stack([np.ones(len(feat))]+[f for f in feat])
    coef,_,_,_=np.linalg.lstsq(F,target,rcond=None)
    pred=F@coef
    return 1-((target-pred)**2).sum(0)/((target-target.mean(0))**2).sum(0)
