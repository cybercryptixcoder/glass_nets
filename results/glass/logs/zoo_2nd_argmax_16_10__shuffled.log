def judge_like(H, V, mode):
    # V: [k,16] orthonormal rows
    P=V.T@V
    v=H@V.T
    M=V.T  # [16,k]
    c=mu - v.mean(0)@M.T
    if mode=='keep': return c + (H-c)@P
    if mode=='remove': return H - (H-c)@P
    if mode=='sub': return c + v@M.T
def out_from(Hn,t=10):
    h=Hn
    for s in range(t,10):
        h=np.maximum(X[:,s:s+1]*W['W_x']+h@W['W_h'],0)
    return (h@W['W_o']).argmax(1)
for name,V in [('pc1c',Vtc[:1]),('pc2c',Vtc[:2]),('pc1u',Vtr[:1]),('pc2u',Vtr[:2]),('pc4u',Vtr[:4])]:
    for mode in ['keep','remove','sub']:
        d=out_from(judge_like(H,V,mode))
        print(name,mode,'match',round((d==base).mean(),4),np.bincount(d,minlength=10))

