Xp=np.maximum(X,0); Xn=np.maximum(-X,0)
def build(hist):
    # state features: s_t, 1, and pos/neg of last `hist` inputs up to t
    coefs=[]
    for t in range(1,10):
        feats=[S[t],np.ones(len(X))]
        for k in range(hist):
            j=t-1-k
            if j>=0: feats += [Xp[:,j],Xn[:,j]]
            else: feats += [np.zeros(len(X)),np.zeros(len(X))]
        F=np.column_stack(feats)
        co,_,_,_=np.linalg.lstsq(F,S[t+1],rcond=None); coefs.append(co)
    # simulate
    sim=np.zeros(len(X))
    for i in range(len(X)):
        s=S[1][i]
        for t in range(1,10):
            feats=[s,1.0]
            for k in range(hist):
                j=t-1-k
                if j>=0: feats += [Xp[i,j],Xn[i,j]]
                else: feats += [0.0,0.0]
            s=max(np.dot(coefs[t-1],feats),0.0)
        sim[i]=s
    return sim,coefs
