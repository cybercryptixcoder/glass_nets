print('s1 =',round(sp,4),'*pos +',round(sn,4),'*neg')
# fit recurrence s_{t+1}=relu(a s + b + c*pos + d*neg) using nonlinear? do simple lstsq then clip
import numpy as np
coefs=[]
for t in range(1,10):
    s=S[t]; pos=np.maximum(X[:,t],0); neg=np.maximum(-X[:,t],0)
    F=np.column_stack([s,np.ones(len(X)),pos,neg])
    co,_,_,_=np.linalg.lstsq(F,S[t+1],rcond=None)
    coefs.append(co)
    print(t,'->',t+1, np.round(co,3), 'R2', round(1-((S[t+1]-F@co)**2).sum()/((S[t+1]-S[t+1].mean())**2).sum(),3))
# simulate
sim=[]
for i in range(len(X)):
    s=sp*max(X[i,0],0)+sn*max(-X[i,0],0)
    for t in range(1,10):
        c=coefs[t-1]
        s=max(c[0]*s+c[1]+c[2]*max(X[i,t],0)+c[3]*max(-X[i,t],0),0)
    sim.append(s)
sim=np.array(sim)
print('corr sim vs S10', np.corrcoef(sim,S[10])[0,1])
out=sim[:,None]*K
print('behaviour match',(out.argmax(1)==base).mean(), np.bincount(out.argmax(1),minlength=10))
print('out R2', 1-((run(X)-out)**2).sum()/((run(X)-run(X).mean(0))**2).sum())

