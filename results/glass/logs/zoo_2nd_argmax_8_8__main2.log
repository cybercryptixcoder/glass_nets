    h = np.zeros((x.shape[0], 8))
    for t in range(8):
        h = np.maximum(x[:, t:t+1]*Wx + h @ Wh, 0.0)
        h = iv("h%d" % (t+1), h)
    return h @ Wo

ALIGN = {"h%d" % i: ["h%d" % i] for i in range(1, 9)}

