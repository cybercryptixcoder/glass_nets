def jac(z):
    # finite diff of out wrt x, homogeneous so use central diff
    J=np.zeros((8,8)); e=1e-4
    for j in range(8):
        d=np.zeros(8); d[j]=e
        J[:,j]=(run((z+d)[None])[0]-run((z-d)[None])[0])/(2*e)
    return J
Jm=np.mean([jac(z) for z in Zi[:300]],axis=0)
