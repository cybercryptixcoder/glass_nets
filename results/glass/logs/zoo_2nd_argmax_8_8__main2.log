import numpy as np
A=acts(X); H=[A[f'h{i}'] for i in range(1,9)]
for t in range(1,8):
    Xf=np.c_[H[t-1],np.ones(len(X))]
    r2=[]
    for k in range(8):
        coef,_,_,_=np.linalg.lstsq(Xf,H[t][:,k],rcond=None)
        p=Xf@coef; r2.append(1-np.var(H[t][:,k]-p)/np.var(H[t][:,k]))
    print(t+1, np.round(r2,2))
# how well does h_t direction match h_{t-1}
for t in range(1,8):
    a=H[t-1];b=H[t]
    cos=(a*b).sum(1)/np.linalg.norm(a,axis=1)/np.linalg.norm(b,axis=1)
    print('cos h%d,h%d'%(t,t+1), np.percentile(cos,[5,50,95]).round(3))

