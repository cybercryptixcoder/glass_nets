        cols=[X[:,c], np.maximum(-X[:,c],0), np.maximum(X[:,c],0)]
        if c>0:
            pre=X[:,:c]
            cols += [pre.max(1), np.maximum(pre.max(1)-X[:,c],0), np.maximum(X[:,c]-pre.max(1),0)]
        cols += [X.sum(1)]
        Fs.append(np.stack(cols,1))
    return Fs
