import numpy as np
Wh=W['W_h']; Wx=W['W_x'][0]; Wo=W['W_o']
def fwd_np(x, h0=None, t0=0):
    h = np.zeros((x.shape[0],8)) if h0 is None else h0.copy()
    for t in range(t0,8):
        h = np.maximum(x[:,t:t+1]*Wx + h@Wh, 0)
    return h@Wo
Xn = X[:3000]
A = acts(Xn)
base = fwd_np(Xn).argmax(1)
res={}
for s in range(8):
    H = acts(Xn)['h%d'%(s+1)]
    m = H.mean(0); Hc = H-m
    u,sv,vt = np.linalg.svd(Hc, full_matrices=False)
    row=[]
    for k in range(1,9):
        P = vt[:k].T
        R = m + Hc@P@P.T
        dec = fwd_np(Xn, h0=R, t0=s+1).argmax(1)
        row.append(round((dec==base).mean(),4))
    res[s+1]=row
    print(s+1, row)

