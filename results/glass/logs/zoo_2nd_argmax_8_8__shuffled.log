def fwd_p(Wh_, Wx_, Wo_, h0=None, t0=0, X_=None):
    h = np.zeros((len(X_),8)) if h0 is None else h0.copy()
    for t in range(t0,8):
        h = np.maximum(X_[:,t:t+1]*Wx_ + h@Wh_, 0)
    return h@Wo_
base = fwd_p(Wh,Wx,Wo,X_=Xn).argmax(1)
u,s,vt = np.linalg.svd(Wh, full_matrices=False)
for k in [1,2,3,4,5,6,8]:
    Wh_ = (u[:,:k]*s[:k])@vt[:k]
    dec = fwd_p(Wh_,Wx,Wo,X_=Xn).argmax(1)
    print("rank Wh",k, (dec==base).mean().round(4))

