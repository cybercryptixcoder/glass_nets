import numpy as np
Wh=W['W_h']; Wo=W['W_o']
Xn=X[:6000]; A=acts(Xn); s=A['h8']@(Wo[:,6]-Wo[:,7]); y=(s>0).astype(float)
Xt=X[6000:8000]; At=acts(Xt); st=At['h8']@(Wo[:,6]-Wo[:,7]); yt=(st>0).astype(float)
def feats(Z):
    m = np.maximum(-Z,0)
    extra = np.stack([m[:,0]*Z[:,j] for j in range(1,5)],axis=1)
    return np.hstack([Z, np.maximum(Z,0), m, extra])
F=feats(Xn); Ft=feats(Xt)
mu=F.mean(0); sd=F.std(0)+1e-9; Fs=(F-mu)/sd; Fts=(Ft-mu)/sd
w=np.zeros(Fs.shape[1])
for it in range(4000):
    p=1/(1+np.exp(-np.clip(Fs@w,-30,30)))
    w-= 0.6*(Fs.T@(p-y)/len(y) + 3e-4*w)
print("train",((Fs@w>0)==(y>0)).mean().round(4),"test",((Fts@w>0)==(yt>0)).mean().round(4))
print("w scaled", (w/sd).round(2), "intercept", (-(w*mu/sd).sum()).round(2))

