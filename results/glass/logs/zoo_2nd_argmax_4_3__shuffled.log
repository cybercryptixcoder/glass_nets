def grad_h3(x, eps=1e-4):
    g = np.zeros((len(x), 4, 3))
    for j in range(3):
        e = np.zeros(3); e[j]=eps
        g[:,:,j] = (acts(x+e)[ 'h3'] - acts(x-e)['h3'])/(2*eps)
    return g
xs = X[:400]
g = grad_h3(xs)
