def grid(x3v, lo=-4, hi=4, n=21):
    g = np.stack(np.meshgrid(np.linspace(lo,hi,n), np.linspace(lo,hi,n)), -1).reshape(-1,2)
    xs = np.c_[g, np.full(len(g), x3v)]
    dd = run(xs).argmax(1).reshape(n,n)
    print("x3=",x3v, " (rows x2 from lo->hi, cols x1 lo->hi)")
    for r in dd:
        print("".join(str(v) for v in r))
