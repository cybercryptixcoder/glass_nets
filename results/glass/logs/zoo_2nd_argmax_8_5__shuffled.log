import numpy as np
Wx=W['W_x'].copy(); Wh=W['W_h'].copy(); Wo=W['W_o'].copy()
def sim(xx,Wx,Wh,Wo):
    B=len(xx); h=np.zeros((B,8))
    for t in range(5):
        h=np.maximum(xx[:,[t]]*Wx+h@Wh,0)
    return h@Wo
dec=run(X).argmax(1)
# test exactness
o=sim(X,Wx,Wh,Wo); print('exact match',(o.argmax(1)==dec).mean())
# pruning: zero out weights below thresholds
for th in [0.1,0.2,0.3,0.4]:
    Wh2=np.where(np.abs(Wh)>=th,Wh,0); Wx2=np.where(np.abs(Wx)>=th,Wx,0); Wo2=np.where(np.abs(Wo)>=th,Wo,0)
    o=sim(X,Wx2,Wh2,Wo2)
    print(th,'n keot',(Wh2!=0).sum()+(Wx2!=0).sum()+(Wo2!=0).sum(),'match',(o.argmax(1)==dec).mean(),'R2',1-((o-run(X))**2).sum()/((run(X)-run(X).mean(0))**2).sum())

