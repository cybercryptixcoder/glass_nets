--- python ---

a=acts(X); dec=run(X).argmax(1); out_true=run(X)
H={t:a['h%d'%t] for t in range(1,6)}
def fit(k):
    mus={};Vs={};V={}
    for t in range(1,6):
        Ht=H[t]; mu=Ht.mean(0); U,s,vt=np.linalg.svd(Ht-mu,full_matrices=False)
        mus[t]=mu; Vs[t]=vt[:k].T
        V[t]=(Ht-mu)@vt[:k].T
    # transitions
    A={};B={};C={}
    for t in range(2,6):
        F=np.column_stack([X[:,[t-1]],V[t-1],np.ones(len(X))])
        coef=np.linalg.lstsq(F,V[t],rcond=None)[0]
        A[t]=coef[0]; B[t]=coef[1:1+k]; C[t]=coef[-1]
    F=np.column_stack([V[5],np.ones(len(X))])
    cr=np.linalg.lstsq(F,out_true,rcond=None)[0]
    # simulate
    p=np.maximum(X[:,0],0); n=np.maximum(-X[:,0],0)
    v=(p[:,None]*(np.array([0.0605,0.0064,0,0,0,0.0918,0,1.0])*7.0017)+n[:,None]*(np.array([0,0,1,0,0.7476,0,0.9768,0])*6.5737)-mus[1])@Vs[1]
    preds=[v]
    for t in range(2,6):
        v=v@B[t]+X[:,[t-1]]*A[t]+C[t]
        preds.append(v)
    o=np.column_stack([preds[4],np.ones(len(X))])@cr
    return o,preds,(Vs,mus,A,B,C,cr)
for k in [2,3,4]:
    o,preds,_=fit(k)
    print(k,'acc',(o.argmax(1)==dec).mean().round(4),'R2',(1-((o-out_true)**2).sum()/((out_true-out_true.mean(0))**2).sum()).round(3))

