gpos=[0.6426,0.4235,0.0451,7.0017]; gneg=[6.4213,6.5737,4.9132,0.0541]
slots=[(0,1),(2,3),(4,5),(7,6)]
def decode(h):
    out=[]
    for k,(jp,jn) in enumerate(slots):
        p=h[:,jp]; n=h[:,jn]
        v=np.where(p>0,p/gpos[k],-n/gneg[k])
        out.append(v)
    return np.stack(out,1)  # only valid when exactly one active
for t in [1,2,3,4,5]:
    h=a['h%d'%t]; V=decode(h)
    # validity: exactly one active in each slot
    valid=np.ones(len(X),bool)
    for (jp,jn) in slots: valid &= ((h[:,jp]>1e-9)^(h[:,jn]>1e-9))
    print('t',t,'valid frac',valid.mean())
    pre=X[:,:t]
    srt=np.sort(pre,1)[:,::-1]  # desc
    for k in range(4):
        cs=[np.corrcoef(V[valid,k], srt[valid,-1-i])[0,1] for i in range(t)]
        cs2=[np.corrcoef(V[valid,k], srt[valid,i])[0,1] for i in range(t)]
        print('  slot',k,'corr with asc order stats',np.round(cs,2),' desc',np.round(cs2,2),'std',round(V[valid,k].std(),2))

