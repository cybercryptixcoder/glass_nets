a=acts(X)
def feats(xx,t):
    F=[]; names=[]
    for i in range(t):
        F.append(xx[:,i]); names.append('x%d'%i)
        F.append(np.maximum(xx[:,i],0)); names.append('p%d'%i)
        F.append(np.maximum(-xx[:,i],0)); names.append('n%d'%i)
        for j in range(t):
            if i!=j:
                F.append(np.maximum(xx[:,i]-xx[:,j],0)); names.append('g%d%d'%(i,j))
    return np.stack(F,1),names
import numpy.linalg as la
for t in [2,3,4,5]:
    F,names=feats(X,t)
    h=a['h%d'%t]
    coef,res,rank,sv=la.lstsq(F,h,rcond=None)
    pred=F@coef
    r2=1-((h-pred)**2).sum(0)/ ((h-h.mean(0))**2).sum(0)
    print(t, F.shape[1], 'R2 per unit', np.round(r2,3))

