def jac(x0, eps=1e-6):
    x0=np.asarray(x0,float)
    res={}
    for s in ['h1','h2','h3','h4','h5']:
        g=np.zeros((8,5))
        for i in range(5):
            xp=x0.copy(); xp[i]+=eps
            g[:,i]=(acts(xp[None])[s][0]-acts(x0[None])[s][0])/eps
        res[s]=g
    return res
