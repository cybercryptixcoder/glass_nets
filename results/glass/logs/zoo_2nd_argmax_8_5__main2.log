o = run(X); d = o.argmax(1)
def nrec(x):
    m=-1e9; c=0
    for v in x:
        if v>m: c+=1; m=v
    return c
def nrecmin(x):
    m=1e9; c=0
    for v in x:
        if v<m: c+=1; m=v
    return c
nr = np.array([nrec(x) for x in X]); nm=np.array([nrecmin(x) for x in X])
print('nrecmax', np.bincount(nr)[1:], [(nr==k).sum() and (d[nr==k]==k-1).mean() for k in range(1,6)])
print('nrecmin', np.bincount(nm)[1:], [(d[nm==k]==k-1).mean() for k in range(1,6)])
# each class distribution given nrec
for k in range(1,6):
    print(k, np.bincount(d[nr==k],minlength=5), np.bincount(d[nm==k],minlength=5))

