a=acts(X)
def build(t):
    pre=X[:,:t]
    ordr=np.argsort(-pre,1)
    i1=ordr[:,0]; i2=ordr[:,1] if t>=2 else np.zeros(len(X),int)
    s=np.sort(pre,1); m1=s[:,-1]; m2=s[:,-2] if t>=2 else np.zeros(len(X))
    oh1=np.eye(5)[i1]; oh2=np.eye(5)[i2]
    F=np.concatenate([oh1,oh2,m1[:,None],m2[:,None],np.maximum(m1,0)[:,None],np.maximum(-m1,0)[:,None],np.maximum(m2,0)[:,None],np.maximum(-m2,0)[:,None]],1)
    return F
def r2fit(A,target):
    A2=np.concatenate([A,np.ones((len(A),1))],1)
    c,_,_,_=np.linalg.lstsq(A2,target,rcond=None); pred=A2@c
    return 1-((target-pred)**2).sum(0)/((target-target.mean(0))**2).sum(0)
for t in [2,3,4,5]:
    F=build(t); h=a['h%d'%t]
    print(t, np.round(r2fit(F,h),2))

