import numpy as np
np.set_printoptions(precision=4, suppress=True, linewidth=200)
H=acts(X)
def probe(site, target, cols=None):
    A = H[site]
    if cols is None:
        Am = np.concatenate([A, np.ones((A.shape[0],1))],1)
    else:
        Am = np.concatenate([A[:,cols], np.ones((A.shape[0],1))],1)
    coef, res, rank, sv = np.linalg.lstsq(Am, target, rcond=None)
    pred = Am@coef
    r2 = 1- ((target-pred)**2).sum()/ ((target-target.mean())**2).sum() if target.ndim==1 else 1-((target-pred)**2).sum(axis=0)/((target-target.mean(0))**2).sum(axis=0)
    return r2
