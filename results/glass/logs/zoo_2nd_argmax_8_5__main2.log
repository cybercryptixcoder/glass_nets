import itertools
o=run(X); d=o.argmax(1)
def sec(v):
    ordr=np.argsort(-v); return ordr[:,1]
def secmin(v):
    ordr=np.argsort(v); return ordr[:,1]
cands={}
for S in itertools.chain.from_iterable(itertools.combinations(range(5),r) for r in range(2,6)):
    S=list(S)
    cands['2ndmax'+str(S)]=S[0]+sec(X[:,S]) if False else None
    idx=np.array(S)
    cands['2ndmax'+str(S)]=idx[sec(X[:,idx])]
    cands['max'+str(S)]=idx[X[:,idx].argmax(1)]
