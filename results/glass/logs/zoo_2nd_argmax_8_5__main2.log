a=acts(X)
srt=np.sort(np.concatenate([np.zeros((len(X),1)),X],1),1)
def running(t):
    # order stats with zero included, per prefix
    res={}
    for i in range(t):
        pass
    return None
def dict_feats(t):
    F={}
    pre=X[:,:t]
    Z=np.concatenate([np.zeros((len(X),1)),pre],1)
    s=np.sort(Z,1)
    m1=s[:,-1]; m2=s[:,-2]; m3=s[:,-3] if t>=2 else np.zeros(len(X))
    ordr=np.argsort(-pre,1)
    for i in range(t):
        F['x%d'%i]=pre[:,i]
        F['p%d'%i]=np.maximum(pre[:,i],0)
        F['n%d'%i]=np.maximum(-pre[:,i],0)
        F['g1p%d'%i]=np.maximum(pre[:,i]-m1,0)
        F['g1n%d'%i]=np.maximum(m1-pre[:,i],0)
        F['g2p%d'%i]=np.maximum(pre[:,i]-m2,0)
        F['g2n%d'%i]=np.maximum(m2-pre[:,i],0)
        F['g3p%d'%i]=np.maximum(pre[:,i]-m3,0)
        F['g3n%d'%i]=np.maximum(m3-pre[:,i],0)
        for j in range(t):
            if i!=j:
                F['d%d%d'%(i,j)]=np.maximum(pre[:,i]-pre[:,j],0)
        F['oh1_%d'%i]=(ordr[:,0]==i).astype(float)
        F['oh2_%d'%i]=(ordr[:,1]==i).astype(float) if t>=2 else np.zeros(len(X))
    F['m1']=m1; F['m2']=m2; F['m3']=m3
    F['m1p']=np.maximum(m1,0);F['m1n']=np.maximum(-m1,0)
    F['m2p']=np.maximum(m2,0);F['m2n']=np.maximum(-m2,0)
    return F
def greedy(t, k=12):
    F=dict_feats(t); names=list(F); h=a['h%d'%t]
    H=h-h.mean(0)
    sel=[]; cur=np.zeros_like(H)
    for it in range(k):
        best=None
        for n in names:
            if n in sel: continue
            A=np.stack(sel and [F[s] for s in sel]+[F[n]] or [F[n]],1)
            A=np.concatenate([A,np.ones((len(A),1))],1)
            c,_,_,_=np.linalg.lstsq(A,h,rcond=None)
            pred=A@c
            r2=1-((h-pred)**2).sum()/((h-h.mean(0))**2).sum()
            if best is None or r2>best[0]: best=(r2,n)
        sel.append(best[1])
        print(t,it+1,best[1],round(best[0],4))
    return sel
for t in [5]:
    greedy(t,12)

