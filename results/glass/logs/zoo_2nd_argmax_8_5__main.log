F=[]
for c in range(5):
    others=np.delete(X,c,axis=1); so=np.sort(others,1)
    F += [X[:,c], so[:,-1], so[:,-2], so[:,0], others.sum(1)]
F=np.array(F).T; F=np.concatenate([F,np.ones((n,1))],1)
for c in range(5):
    f=np.concatenate([F, np.zeros((n,0))],1)
    coef,_,_,_=np.linalg.lstsq(f,o[:,c],rcond=None)
    pred=f@coef
    print('class',c,'R2',(1-((o[:,c]-pred)**2).sum()/((o[:,c]-o[:,c].mean())**2).sum()).round(3))
# simpler global: fit out on [X, m1,m2, sorted x]
F2=np.concatenate([X,np.sort(X,1),np.ones((n,1))],1)
coef,_,_,_=np.linalg.lstsq(F2,o,rcond=None)
pred=F2@coef
print('global R2',np.round(1-((o-pred)**2).sum(0)/((o-o.mean(0))**2).sum(0),3))

