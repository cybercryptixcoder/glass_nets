def r2(y,H):
    H1=np.concatenate([H,np.ones((len(H),1))],1)
    w,_,_,_=np.linalg.lstsq(H1,y,rcond=None)
    p=H1@w
    return 1-np.sum((y-p)**2)/np.sum((y-y.mean())**2), w
