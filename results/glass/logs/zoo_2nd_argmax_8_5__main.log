o=run(X); d=o.argmax(1)
n=len(X)
cs=np.cumsum(X,1); csa=np.cumsum(np.abs(X),1)
cand={}
cand['x']=X; cand['-x']=-X; cand['abs']=np.abs(X); cand['cs']=cs; cand['-cs']=-cs
cand['cs2']=np.cumsum(X**2,1)
cand['csa']=csa
cand['x-mean']=X-X.mean(1,keepdims=True)
cand['csum_mean']=cs-cs.mean(1,keepdims=True)
cand['x/sumabs']=X/(np.abs(X).sum(1,keepdims=True))
cand['x/sum']=X/(X.sum(1,keepdims=True))
cand['cprod']=np.cumprod(X,1)
cand['xm1']=X-np.roll(X,1,1)
cand['xp1']=X+np.roll(X,1,1)
cand['maxacc']=np.maximum.accumulate(X,1)
cand['x*acc']=X*np.maximum.accumulate(X,1)
cand['x/cs']=X/(cs+1e-9)
cand['cs/sum']=cs/(X.sum(1,keepdims=True))
cand['cummin']=np.minimum.accumulate(X,1)
cand['cs-absacc']=cs-np.maximum.accumulate(np.abs(X),1)
best=[]
for k,v in cand.items():
    acc=max((v.argmax(1)==d).mean(),(v.argmin(1)==d).mean())
    best.append((acc,k))
for a,k in sorted(best,reverse=True)[:8]: print(round(a,3),k)

