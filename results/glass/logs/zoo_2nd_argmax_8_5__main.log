import numpy as np
np.set_printoptions(precision=2, suppress=True, linewidth=220)
Xtr,Xte = X[:6000],X[6000:]
Otr,Ote = run(Xtr),run(Xte)
def F(x,c,extra=False):
    o=np.delete(x,c,1); so=np.sort(o,1)
    m=so[:,-1]; s2=so[:,-2]; xc=x[:,c]
    cols=[np.maximum(xc-s2,0), np.maximum(xc-m,0), np.maximum(s2-xc,0), np.ones_like(xc)]
    return np.stack(cols,1)
Wt=[]; R2=[]
for c in range(5):
    M=F(Xtr,c); w,_,_,_=np.linalg.lstsq(M,Otr[:,c],rcond=None); Wt.append(w)
    p=M@w; R2.append(1-np.sum((Otr[:,c]-p)**2)/np.sum((Otr[:,c]-Otr[:,c].mean())**2))
print("R2",np.round(R2,3)); print("coef [a=r(xc-s2), b=r(xc-m), d=r(s2-xc), const] per class:")
print(np.round(np.array(Wt),2))
P=np.stack([F(Xte,c)@Wt[c] for c in range(5)],1)
print("decision acc:", (P.argmax(1)==Ote.argmax(1)).mean(), " net acc vs 2ndlargest:", )
