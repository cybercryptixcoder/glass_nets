def gini(yy):
    c=np.bincount(yy,minlength=5); return 1-c.max()/len(yy)
def tree(Xd,yd,depth=0,maxd=4,idx=None):
    if idx is None: idx=np.arange(len(Xd))
    y=yd[idx]; base=gini(y)
    cnt=np.bincount(y,minlength=5)
    if depth>=maxd or base<0.02:
        print('  '*depth+f'leaf n={len(y)} dist={cnt} err={base:.2f}'); return
    best=None
    for f in range(Xd.shape[1]):
        for v in np.unique(np.quantile(Xd[idx,f],np.linspace(0,1,25))):
            m=Xd[idx,f]<=v
            if m.sum()<100 or (~m).sum()<100: continue
            score=(gini(y[m])*m.sum()+gini(y[~m])*(~m).sum())/len(y)
            if best is None or score<best[0]: best=(score,f,v,m)
    if best is None:
        print('  '*depth+f'leaf n={len(y)} dist={cnt} err={base:.2f}'); return
    score,f,v,m=best
    print('  '*depth+f'x{f+1} <= {v:.3f} err->{score:.2f} n={len(y)} dist={cnt}')
    tree(Xd,yd,depth+1,maxd,idx[m]); tree(Xd,yd,depth+1,maxd,idx[~m])
