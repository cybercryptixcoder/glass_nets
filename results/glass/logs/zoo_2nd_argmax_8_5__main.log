Wx=W['W_x']; Wh=W['W_h']; Wo=W['W_o']
def sim(Xd, Wh_use=None, Wo_use=None):
    Wl=Wh if Wh_use is None else Wh_use; Ol=Wo if Wo_use is None else Wo_use
    h=np.zeros((len(Xd),8))
    for t in range(5):
        h=np.maximum(Xd[:,t:t+1]*Wx + h@Wl,0)
    return h@Ol
