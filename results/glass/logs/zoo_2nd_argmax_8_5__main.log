d=run(X).argmax(1)
rk=np.argsort(np.argsort(X,1),1)
# permutation code
def code(A,b):
    return A@ (b**np.arange(A.shape[1]))
c=code(rk,np.array([1,5,25,125,625]))
u,inv,cnt=np.unique(c,return_inverse=True,return_counts=True)
pure=0
for i in range(len(u)):
    m=inv==i
    pure+= len(np.unique(d[m]))==1
print('rank patterns',len(u),'pure',pure)
# check sum-based
s=X.sum(1)
for f,name in [(s,'sum'),(np.abs(X).sum(1),'abssum'),((X>0).sum(1),'npos'),(X.max(1),'max'),(X.min(1),'min'),(np.abs(X).max(1),'absmax')]:
    # bin into deciles, purity
    q=np.quantile(f,np.linspace(0,1,11)); b=np.digitize(f,q[1:-1])
    p=np.mean([len(np.unique(d[b==i]))==1 for i in range(10)])
    print(name,'purity',p)

