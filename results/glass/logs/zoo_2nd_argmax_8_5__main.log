import numpy as np
A5 = acts(X)   # all sites
print({k:v.shape for k,v in A5.items()})
def m_s(pref):
    # pref [B,t]
    m = pref.max(1)
    if pref.shape[1]==1: return m, np.full_like(m,-10.)
    s = np.sort(pref,1)[:,-2]
    return m, s
for t in range(1,6):
    m,s = m_s(X[:,:t+1])
    H = A5['h%d'%(t+1)]
    # find near pairs in (m,s)
    key = np.stack([m,s],1)
    from scipy.spatial import cKDTree
    tr = cKDTree(key)
    d,idx = tr.query(key, k=2)
    close = d[:,1] < 1e-4
    dh = np.abs(H - H[idx[:,1]]).max(1)
    print(t, "pairs close:", close.sum(), "max|dh| among close:", dh[close].max() if close.sum() else None, "median", np.median(dh[close]) if close.sum() else None)

