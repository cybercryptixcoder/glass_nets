# gradient analysis: finite difference
def grad(x0,eps=1e-4):
    base=run(x0[None])[0]
    G=np.zeros((5,5))
    for i in range(5):
        xx=x0.copy(); xx[i]+=eps
        G[:,i]=(run(xx[None])[0]-base)/eps
    return G
np.set_printoptions(precision=2,suppress=True)
for k in range(4):
    print('input',X[k], 'out',run(X[k:k+1])[0].round(2))
    print(grad(X[k]).round(1))

