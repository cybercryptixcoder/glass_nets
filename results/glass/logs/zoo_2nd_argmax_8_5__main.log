def grad(x0,eps=1e-4):
    base=run(x0[None])[0]
    G=np.zeros((5,5))
    for i in range(5):
        xx=x0.copy(); xx[i]+=eps
        G[:,i]=(run(xx[None])[0]-base)/eps
    return G
