import numpy as np
from scipy.spatial import cKDTree
A=acts(X); B=X.shape[0]
def cond_var(feats, tgt, k=8):
    f = np.stack(feats,1)
    f = (f - f.mean(0))/f.std(0)
    tr=cKDTree(f)
    d,idx = tr.query(f,k=k)
    neigh = tgt[idx]              # [B,k,8]
    var_in = neigh.var(1).mean()  # residual variance
    return 1-var_in/ tgt.var(0).mean()
srt=np.sort(X,1)[:,::-1]
m1,m2,m3,m4,mn = srt.T
sm = X.sum(1)
for t in [3,5]:
    H=A['h%d'%t]
    print("h%d: R2 if function of ..."%t,
      " (m,s):%.3f"%cond_var([m1,m2],H),
      " (m,s,min):%.3f"%cond_var([m1,m2,mn],H),
      " (m,s,m3):%.3f"%cond_var([m1,m2,m3],H),
      " (m,s,sum):%.3f"%cond_var([m1,m2,sm],H),
      " (m,s,m3,mn):%.3f"%cond_var([m1,m2,m3,mn],H),
