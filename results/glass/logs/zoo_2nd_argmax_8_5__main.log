import numpy as np
Xtr = X[:6000]; Otr = run(Xtr)
def lib(x, c):
    f=[]
    for i in range(5):
        if i==c: continue
        f.append(np.maximum(x[:,c]-x[:,i],0)); f.append(np.maximum(x[:,i]-x[:,c],0))
    f.append(x[:,c])
    return np.stack(f,1)
for c in range(5):
    F = lib(Xtr,c); y = Otr[:,c]
    F1 = np.concatenate([F, np.ones((len(F),1))],1)
    w,res,rank,sv = np.linalg.lstsq(F1,y,rcond=None)
    pred=F1@w
    print(c,"R2 %.4f"% (1-np.sum((y-pred)**2)/np.sum((y-y.mean())**2)), np.round(w,2))

