def tree(Xd, yd, depth=0, maxd=4, idx=None, feat_names=None):
    if idx is None: idx=np.arange(len(Xd))
    y=yd[idx]
    cnt=np.bincount(y,minlength=5); base=1-cnt.max()/len(y)
    if depth>=maxd or base<0.01: 
        print('  '*depth+f'leaf n={len(y)} dist={cnt} err={base:.2f}')
        return
    best=None
    for f in range(Xd.shape[1]):
        vals=np.unique(np.quantile(Xd[idx,f],np.linspace(0,1,21)))
        for v in vals[:-1]:
            m=Xd[idx,f]<=v
            if m.sum()<50 or (~m).sum()<50: continue
            def g(sel):
                c=np.bincount(y[sel],minlength=5); return 1-c.max()/len(c)
            score=(g(m)*m.sum()+g(~m)*(~m).sum())/len(y)
            if best is None or score<best[0]: best=(score,f,v,m)
    score,f,v,m=best
    print('  '*depth+f'x{f} <= {v:.3f}  err->{score:.2f} n={len(y)} dist={cnt}')
    tree(Xd,yd,depth+1,maxd,idx[m])
    tree(Xd,yd,depth+1,maxd,idx[~m])
d=run(X).argmax(1)
tree(X,d)

