# true second largest position
true = np.argsort(np.argsort(Xs,1),1)  # rank
snd = np.argmax(true==3,1)   # rank 3 = second largest
print("accuracy(second largest):", (dec==snd).mean())
# equivariance: out_(p x) should equal permuted out(x)
O_by_perm = {}
for i in range(len(P)): O_by_perm[tuple(P[i])]=O[i]
err=[]
for i in range(len(P)):
    p=P[i]; xperm = Xs[i]
    # permuting positions by q means new sequence x'[j]=x[q[j]]?  build from base
    pass
# test: for each permutation p, the output should be perm-invariant: out[p][c] == out[identity][p^-1(c)]... 
# use: x' = base[q]; equivariance means out_c(x') = out_{q^{-1}(c)}(base)... 
baseo = O_by_perm[(0,1,2,3,4)]
import itertools
errs=[]
for q in itertools.permutations(range(5)):
    xp = base[list(q)]
    o = run(xp[None,:]).ravel()
    # actual: the position holding base[k] is index q^{-1}[k]... let's find pos of each base value
    pos = {k: q.index(k) for k in range(5)}
    pred = np.array([baseo[k] for k in range(5)])  # out for base[k] at position pos[k]
    o_expected = np.zeros(5)
    for k in range(5): o_expected[pos[k]] = baseo[k]
    errs.append(np.abs(o-o_expected).max())
print("equivariance max err on separated inputs:", np.round(np.max(errs),4), " mean", np.round(np.mean(errs),4))
print("out scale", np.round(np.abs(baseo).max(),2))

