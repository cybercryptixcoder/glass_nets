    for j in range(i+1,36):
        r=vals[i]/vals[j]
        for nice in [1,-1,2,-2,0.5,-0.5,1.5,-1.5,3,-3,1/3,-1/3,0.25,4]:
            if abs(r-nice)<0.01*abs(nice): found.append((names[i],names[j],r,nice))
print("ratio hits",len(found)); print(found[:20])
# permutation symmetry of Wh
for p in itertools.permutations(range(4)):
    Pp=np.eye(4)[list(p)]
    d=np.abs(Pp@Wh@Pp.T-Wh).max()
    if d<0.5: print("perm",p,d)
# is Wh ~ symmetric part only?
print("skew norm", np.abs(Wh-Wh.T).max(), "sym norm", np.abs(Wh+Wh.T).max())
# check if Wo relates to Wh
for f,name in [(lambda A: A.T,"T"),(lambda A:A, "id")]:
    B=f(Wh)
    # best scalar Wo ~ B
    k=(B*Wo).sum()/(B*B).sum(); print(name,"Wh->Wo scalar fit resid", np.abs(Wo-k*B).max(), k)
    k=(B*Wo.T).sum()/(B*B).sum(); print(name,"Wh->WoT resid", np.abs(Wo.T-k*B).max())
print("eigvals Wh", np.linalg.eigvals(Wh))
print("eigvecs\n", np.linalg.eig(Wh)[1])

