import numpy as np
A=acts(X); y=A['out'].argmax(1)
M0=np.array([-0.213737,1.273340,-0.069905,2.318979]);M1=np.array([5.417269,1.320339,-0.533874,14.224694])
M2=np.array([-4.427177,-1.289346,0.530658,-14.462238]);M3=np.array([-0.013221,0.084671,0.482565,-0.752541])
MH=np.stack([M0,M1,M2,M3]); IN=np.array([1,-1,-1,1])
D1=np.array([-0.204678,-0.728751,1,0.161464]);D2=np.array([-0.852806,-0.943350,0.867646,0.472285]);D3=np.array([-0.221551,-0.199152,0.114800,0.134029])
pos=np.maximum(X[:,0],0); neg=np.maximum(-X[:,0],0)
h=np.stack([pos,neg,neg,pos],1)
# check h matches real h1 (gauged)
d=np.array([1,-1,-1,1])/W['W_x'].ravel()
print("h1 err", np.abs(h-d*A['h1']).max()/np.abs(A['h1']).max())
for t,k in zip(range(1,4),['h2','h3','h4']):
    h=np.maximum(X[:,t:t+1]*IN+h@MH,0); print(k,"err",np.abs(h-d*A[k]).max()/np.abs(A[k]).max())
out=np.stack([np.zeros(len(h)),h@D1,h@D2,h@D3],1)
print("decisions",(out.argmax(1)==y).mean())

