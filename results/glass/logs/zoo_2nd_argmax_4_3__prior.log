def r2(A, B):
    # fit B ~ A(1)
    A1 = np.hstack([np.ones((len(A),1)), A])
    coef, *_ = np.linalg.lstsq(A1, B, rcond=None)
    pred = A1@coef
    ss_res = ((B-pred)**2).sum(0); ss_tot = ((B-B.mean(0))**2).sum(0)
    return 1-ss_res/ss_tot
print("h2 ~ a1,b1,a2,b2:", np.round(r2(np.c_[a1,b1,a2,b2], h2),4))
print("h2 ~ a1,b1:", np.round(r2(np.c_[a1,b1], h2),4))
print("h2 raw values corr with a1,b1,a2,b2:")
print(np.round(np.corrcoef(np.c_[h2, a1,b1,a2,b2].T)[:4,4:],3))

