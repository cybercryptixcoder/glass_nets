def labels(x):
    return np.argsort(-x, axis=1)[:,1]

def forward(p, x):
    wx, Wh, Wo = p['wx'], p['Wh'], p['Wo']
    h1 = np.maximum(x[:,0:1]*wx, 0)
    h2 = np.maximum(x[:,1:2]*wx + h1@Wh, 0)
    h3 = np.maximum(x[:,2:3]*wx + h2@Wh, 0)
    return h3@Wo, (h1,h2,h3)

def train(seed, steps=6000, lr=0.02, bs=256):
    rng = np.random.default_rng(seed)
    p = {'wx': rng.normal(scale=1.0, size=4),
         'Wh': rng.normal(scale=0.7, size=(4,4)),
         'Wo': rng.normal(scale=1.0, size=(4,3))}
    m = {k: np.zeros_like(v) for k,v in p.items()}
    v = {k: np.zeros_like(v) for k,v in p.items()}
    for t in range(steps):
        x = gen(bs, rng); y = labels(x)
        # forward
        wx,Wh,Wo = p['wx'],p['Wh'],p['Wo']
        a1 = x[:,0:1]*wx; h1 = np.maximum(a1,0)
        a2 = x[:,1:2]*wx + h1@Wh; h2 = np.maximum(a2,0)
        a3 = x[:,2:3]*wx + h2@Wh; h3 = np.maximum(a3,0)
        lo = h3@Wo
        lo = lo - lo.max(1,keepdims=True)
        e = np.exp(lo); pr = e/e.sum(1,keepdims=True)
        L = -np.log(pr[np.arange(bs),y]+1e-12).mean()
        dlo = pr.copy(); dlo[np.arange(bs),y] -= 1; dlo/=bs
        g = {}
        g['Wo'] = h3.T@dlo
        dh3 = dlo@Wo.T
        da3 = dh3*(a3>0)
        g['wx'] = (da3*x[:,2:3]).sum(0)
        g['Wh'] = h2.T@da3
        dh2 = da3@Wh.T
        da2 = dh2*(a2>0)
        g['wx'] += (da2*x[:,1:2]).sum(0)
        g['Wh'] += h1.T@da2
        dh1 = da2@Wh.T
        da1 = dh1*(a1>0)
        g['wx'] += (da1*x[:,0:1]).sum(0)
        for k in p:
            m[k] = 0.9*m[k]+0.1*g[k]; v[k] = 0.999*v[k]+0.001*g[k]**2
            mh = m[k]/(1-0.9**(t+1)); vh = v[k]/(1-0.999**(t+1))
            p[k] = p[k] - lr*mh/(np.sqrt(vh)+1e-8)
    return p, L

for seed in range(6):
    p, L = train(seed)
    xt = gen(4000, np.random.default_rng(100+seed))
    out,_ = forward(p, xt)
    acc = np.mean(out.argmax(1)==labels(xt))
    print(seed, round(L,3), round(acc,4), np.round(p['wx'],2), np.linalg.norm(p['Wo'],axis=0).round(2))

