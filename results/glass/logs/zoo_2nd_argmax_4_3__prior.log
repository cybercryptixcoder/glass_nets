import numpy as np

def gen(n, rng):
    return rng.normal(size=(n,3))

def labels(x):
    # position (0-based) of second largest
    return np.argsort(np.argsort(x, axis=1), axis=1)[:,1]  # rank1 = second largest
# careful: argsort twice gives ranks; second largest has rank 1
def labels2(x):
    r = np.argsort(-x, axis=1)  # descending order indices
    return r[:,1]
xs = gen(1000, np.random.default_rng(0))
print(np.mean(labels(xs)==labels2(xs)))

