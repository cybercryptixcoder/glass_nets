import numpy as np, scipy.optimize as so
o=run(X); y=o.argmax(1); Xs=X; os_=o
def sim(p,k,x):
    A=p[:k]; B=p[k:k+k*k].reshape(k,k); C=p[k+k*k:k+k*k+4*k].reshape(k,4)
    z=np.zeros((len(x),k))
    for t in range(4):
        z=np.maximum(x[:,[t]]*A + z@B,0.0)
    return z@C, z
def loss(p,k):
    out,_=sim(p,k,Xs)
    return ((out-os_)**2).sum()/1e3
rng=np.random.default_rng(0)
for k in [2,3,4]:
    best=None
    for trial in range(4):
        p0=rng.normal(0,1,k+k*k+4*k)
        r=so.minimize(loss,p0,args=(k,),method='Powell',options={'maxiter':4000,'xtol':1e-4,'ftol':1e-6})
        if best is None or r.fun<best.fun: best=r
    out,z=sim(best.x,k,Xs)
    print("k",k,"loss",round(best.fun,3),"dec acc",round(float((out.argmax(1)==y).mean()),4), "R2", round(1-((out-os_)**2).sum()/((os_-os_.mean(0))**2).sum(),4))
    print("A",np.round(best.x[:k],3)); print("B",np.round(best.x[k:k+k*k].reshape(k,k),3))

