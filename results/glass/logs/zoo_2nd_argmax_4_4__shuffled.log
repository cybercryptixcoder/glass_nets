def acc(F,y):
    T=np.eye(4)[y]
    F1=np.hstack([F,np.ones((len(F),1))])
    coef=np.linalg.lstsq(F1,T,rcond=None)[0]
    return (np.argmax(F1@coef,1)==y).mean()
